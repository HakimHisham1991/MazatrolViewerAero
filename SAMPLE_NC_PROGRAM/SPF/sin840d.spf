$TC_DP4[_OVI[8],_T_7]=$TC_DP4[_OVI[8],_T_7]+$TC_DP13[_OVI[8],_T_7]*_L2 +_OVR[20]*_L2 $TC_DP13[_OVI[8],_T_7]=0
