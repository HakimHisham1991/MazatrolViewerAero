N154 IF ( ( _MVAR==105) AND ((_HI==4)OR(_HI==16)) AND (ABS(_OVR[16+(_HI MOD 4)])>_TOLPAR) )
_HT=_HT<<_PROTSYM[1]
ENDIF
GOTOF _WX
_T961:
N155 IF ( (((_HI>=4)AND(_HI<=6))OR((_HI>=20)AND(_HI<=22))) AND (ABS(_OVR[16+(_HI MOD 4)])>_TOLPAR) )
_HT=_HT<<_PROTSYM[1]
ENDIF
GOTOF _WX
_T982:
N156 IF ( (_MVAR>0 ) AND ((_HI>=8)AND(_HI<=11)) AND (ABS(_OVR[16+(_HI MOD 4)])>_TOLPAR) )
_HT=_HT<<_PROTSYM[1]
ENDIF
GOTOF _WX
_T974:
N157 IF ( ( _MVAR<>100) AND ((_HI==4)OR(_HI==16)) AND (ABS(_OVR[16+(_HI MOD 4)])>_TOLPAR) )
_HT=_HT<<_PROTSYM[1]
ENDIF
GOTOF _WX
_T994:
N158 IF( (((_HI>=4)AND(_HI<=6)) OR ((_HI>=16)AND(_HI<=18))) AND (ABS(_OVR[16+(_HI MOD 4)])>_TOLPAR) )
_HT=_HT<<_PROTSYM[1]
ENDIF
GOTOF _WX
N159 _PTIME:CYCLE113(2,_DTT)
N160 _HT=_DTT
N165 GOTOF _WX
N170 _PAXIS: IF ISNUMBER(SUBSTR(_HT2,5,1))==0 GOTOF _ALTAX
N171 CASE NUMBER(SUBSTR(_HT2,5,1)) OF 1 GOTOF _AX1 2 GOTOF _AX2 3 GOTOF _AX3 DEFAULT GOTOF _NOAX
N175 _AX1:_HT=AXSTRING($P_AXN1)
N180 GOTOF _WX
N185 _AX2:_HT=AXSTRING($P_AXN2)
N190 GOTOF _WX
N195 _AX3:_HT=AXSTRING($P_AXN3)
N200 GOTOF _WX
N171 _ALTAX:CASE (_MA MOD 10) OF 1 GOTOF _AXX1 2 GOTOF _AXX2 3 GOTOF _AXX3 DEFAULT GOTOF _NOAX
N175 _AXX1:_HT=AXSTRING($P_AXN1)
N180 GOTOF _WX
N185 _AXX2:_HT=AXSTRING($P_AXN2)
N190 GOTOF _WX
N195 _AXX3:_HT=AXSTRING($P_AXN3)
N200 GOTOF _WX
N205 _NOAX:_HT=" "
N210 GOTOF _WX
N215 _PRP:_HT=SUBSTR(_HT,1,STRLEN(_HT)-1)
N220 IF ISNUMBER(_HT)==0 GOTOF _PF1
N225 _HI=NUMBER(_HT)
N230 CYCLE118 (R[_HI],_DIGIT,_TMP_ST,0,0)
;N235 _HT=" "<<_TMP_ST _HT=SUBSTR(_HT,1,STRLEN(_HT)-1)
N240 GOTOF _WX
_PKT:
N245 GOTOF _WX
N250 _PTXT: _HT=SUBSTR(_HT,5,STRLEN(_HT)-5) _HT=SUBSTR(_HT,0,STRLEN(_HT)-1)
N255 IF ISNUMBER(_HT)==0 GOTOF _PF1
N260 _HI=NUMBER(_HT) _HT=<<_TXT[_HI]
N265 _WX:
N270 IF STRLEN(_TXA)+STRLEN(_HT)>_PFORM1 GOTOF _WR3
N275 IF _CR GOTOF _WR5 IF (_PROTFORM[5]==0)AND(_II==1) GOTOF _WR2
N280 IF STRLEN(_HT)+1>_SP_B[_C_Z-1] GOTOF _WR4
N285 If SUBSTR(_HT,0,1)=="-" GOTOF _WR1
N290 _HT=" "<<_HT
N295 _WR1:
IF _M1
WHILE (STRLEN(_HT)+1)<>_SP_B[_C_Z-1]
_HT=_HT<<" "
ENDWHILE
ELSE
_T_IND=_SP_B[_C_Z-1]-STRLEN(_HT)
_HT=_HT<<_LEER[_T_IND]
ENDIF
N310 _WR2:IF (STRLEN(_TXA)+STRLEN(_HT)+1)>_PFORM1 GOTOF _WR3
_TXA=_TXA<<_HT<<_PROTSYM[0]
N315 GOTOB _DEC1
N320 _WR3:
N325 CYCLE108(62310,0)
N330 _PROTVAL[_II+5]=_TXA _TXA=" " _TXA=_HT _M2=1
N335 GOTOB _NZEIL
N340 _WR4:
IF STRLEN(_HT)>_SP_B[_C_Z-1]
N345 CYCLE108(62309,0)
ENDIF
n60 _TXA=_TXA<<_HT<<_PROTSYM[0]
N350 GOTOB _DEC1
N355 _WR5: _TXA=_TXA<<" "<<_HT
N360 GOTOB _DEC1
N365 _PF1:MSG()
N366 CYCLE108(61361,0)
N367 RET
N368 _PF2:MSG()
N369 CYCLE108(61363,0)
N370 RET
N372 _PF3:MSG()
N369 CYCLE108(61370,0)
N374 RET
N376 _PF4:MSG()
N377 CYCLE108(61371,0)
N378 RET
_POVI: _HT=SUBSTR(_HT,5,STRLEN(_HT)-5) _HT=SUBSTR(_HT,0,STRLEN(_HT)-1)
IF ISNUMBER(_HT)==0 GOTOB _PF1
_HI=NUMBER(_HT)
_KK=_OVI[_HI] _HT=" "<<_KK _HT=SUBSTR(_HT,1,STRLEN(_HT)-1)
GOTOB _WX
N370 _FINE:MSG()
N375 RET

%_N_CYCLE106_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE106(INT _STAT) SAVE DISPLOF
;V06.02.17 May 28, 2003
