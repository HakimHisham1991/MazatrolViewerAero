ENDIF
GOTOF _FIN
_MTG9: IF (_T_6>2) GOTOF _AL3
$TC_DP6[_T_7]=$TC_DP6[_T_7]+$TC_DP15[_T_7]+_OVR[20] $TC_DP15[_T_7]=0
GOTOF _FIN
_MT10:
_T_3=_KNUM DIV 100000 _T_4=_KNUM MOD 100000 DIV 10000 _T_6=_KNUM MOD 10000 DIV 1000 _T_7=_KNUM MOD 10
IF _SW_NCK>=5
IF ($MN_MM_MAX_CUTTING_EDGE_NO>9) AND ($MN_MM_MAX_CUTTING_EDGE_NO<1000)
_T_7=_KNUM MOD 1000 _OVI[0]=_T_7
ELSE
IF ($MN_MM_MAX_CUTTING_EDGE_NO>=1000)
_T_3=_KNUM DIV 10000000 _T_4=_KNUM MOD 10000000 DIV 1000000 _T_6=_KNUM MOD 1000000 DIV 100000 _T_7=_KNUM MOD 100000 _OVI[0]=_T_7
ENDIF
ENDIF
ENDIF
IF _T_7==0 GOTOF _AL8 IF (_OVI[8]==0) GOTOF _AL5
IF (_I_PLAN==0) OR (_I_TYP==1) OR ((_I_TYP==0)AND(($TC_DP1[_OVI[8],_T_7]<400) OR ($TC_DP1[_OVI[8],_T_7]>=600)))
_L1=1 _L2=1 _L3=1
