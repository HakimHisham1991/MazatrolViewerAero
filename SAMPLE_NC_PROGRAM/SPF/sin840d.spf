ENDIF
_FRIN411: GOTOF _FIN
_DECFR5:
_FRSEL=2000
$AC_MEAS_FRAME_SELECT=_FRSEL
IF (_ADD==0)
$AC_MEAS_FINE_TRANS=0
STOPRE
;_OVI[12]=MEASURE()
IF (_OVI[12]<>0) GOTOF _AL11
_OVI[11]=-1 $P_SETFR=$AC_MEAS_FRAME
ELSE
_RJUMP=51 _FITRANS=0
