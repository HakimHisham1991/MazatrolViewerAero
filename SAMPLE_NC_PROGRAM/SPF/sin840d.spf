$TC_DP14[_OVI[8],_T_7]=$TC_DP14[_OVI[8],_T_7]+_OVR[20]
GOTOF _FIN
_MT14:IF(_T_3<>4) GOTOF _AL2
$TC_DP15[_OVI[8],_T_7]=$TC_DP15[_OVI[8],_T_7]+_OVR[20]
GOTOF _FIN
_MTG11:IF (_T_3>3) GOTOF _MTG14 IF (_T_3<>1) GOTOF _MTG12
$TC_DP3[_OVI[8],_T_7]=$TC_DP3[_OVI[8],_T_7]+$TC_DP12[_OVI[8],_T_7]*_L1 +_OVR[20]*_L1 $TC_DP12[_OVI[8],_T_7]=0
