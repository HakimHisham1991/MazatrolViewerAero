$TC_DP5[_OVI[8],_T_7]=$TC_DP5[_OVI[8],_T_7]+$TC_DP14[_OVI[8],_T_7]*_L3 +_OVR[20]*_L3 $TC_DP14[_OVI[8],_T_7]=0
GOTOF _FIN
