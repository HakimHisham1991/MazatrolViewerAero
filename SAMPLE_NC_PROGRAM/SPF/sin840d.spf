ENDIF
GOTOF _WX
_T977:_KK=_MVAR DIV 100
IF _KK==0
N151 IF ((((_HI>=4)AND(_HI<=7))OR((_HI>=16)AND(_HI<=19))) AND (ABS(_OVR[16+(_HI MOD 4)])>_TOLPAR) )
