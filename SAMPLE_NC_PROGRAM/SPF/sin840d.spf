%_N_CYCLE111_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE111(VAR AXIS _MAV, VAR AXIS _XX,VAR AXIS _YY,VAR AXIS _ZZ,VAR REAL _M_SPE[], VAR REAL _M_ME[], VAR INT _M_N[],VAR INT _ALARM,VAR BOOL _M_ZUST[],VAR BOOL _VB[],VAR BOOL _INTERN[],VAR REAL _DAT[3,6],VAR REAL _KF[3,3])
;V06.02.08  Mar 21, 2002
;C06.02.07 Feb 15, 2002
;UP 1-Punkt-Messung
N100 DEF INT _SPOS_MOD=0,_Z=0,_SP_DIR,_AXIND,_H=1
N101 DEF REAL _DREH,_FWZ,_SP_STAT,_SP_DREH,_HR,_M,_INC=1000,_DELTA=1,_R1,_M_POS
IF _MAV==_XX GOTOF _M02 IF _MAV==_YY GOTOF _M01
_AXIND=_AXIND+1
_M01:_AXIND=_AXIND+1
_M02:
IF (_INTERN[0+_AXIND*8])AND (_M_N[10]>=5)
IF ($P_GG[29]==1)AND($MC_TOOL_PARAMETER_DEF_MASK B_AND 'B1000000')
_H=2
ENDIF
ENDIF
IF (($MN_SCALING_SYSTEM_IS_METRIC==1)AND($P_GG[13]<>3))OR (($MN_SCALING_SYSTEM_IS_METRIC==0)AND($P_GG[13]==4))GOTOF _M03
_INC=1000*$MN_SCALING_VALUE_INCH _DELTA=1/$MN_SCALING_VALUE_INCH
_M03:IF _M_ZUST[14] OR _M_ZUST[15] GOTOF _MT4 IF _VB[3]==0 GOTOF _MT4 IF _VB[2]==0 GOTOF _MT3
IF _VB[31]==0 GOTOF _MST
_M_SPE[8]=$P_ACTFRAME[_ZZ,RT] _SPOS_MOD=0
IF ((_INTERN[18])AND(_MAV==_ZZ)) GOTOF _MT1
IF _M_ZUST[0] GOTOF _MT1
_HR=180 _SPOS_MOD=1
IF _M_ZUST[1] GOTOF _MT1
_HR=90 _SPOS_MOD=0
IF _M_ZUST[2] GOTOF _MT1
_HR=270 _SPOS_MOD=2
GOTOF _MT1
_MST:_M_SPE[8]=360-$P_ACTFRAME[_ZZ,RT] _SPOS_MOD=0
IF ((_INTERN[18])AND(_MAV==_ZZ)) GOTOF _MT1
IF _M_ZUST[0] GOTOF _MT1
_HR=180 _SPOS_MOD=1
IF _M_ZUST[1] GOTOF _MT1
_HR=270 _SPOS_MOD=0
IF _M_ZUST[2] GOTOF _MT1
_HR=90 _SPOS_MOD=2
_MT1:_M_SPE[8]=_M_SPE[8]+_HR
IF _M_ZUST[4]==0 GOTOF _MT2
_M_SPE[8]=_M_SPE[8]+180
_MT2:_M_SPE[8]=_M_SPE[8]-TRUNC(_M_SPE[8]/ 360)*360
IF _VB[45] GOTOF _MT3 IF NOT _INTERN[20+8] GOTOF _MT3
_M_SPE[8]=_M_SPE[8]+_M_SPE[38]
_MT3:_M_SPE[8]=_M_SPE[8]-TRUNC(_M_SPE[8]/360)*360
IF _M_SPE[8]<0
_M_SPE[8]=_M_SPE[8]+360
ENDIF
IF _M_SPE[8]> 359.999
_M_SPE[8]=0
ENDIF
CASE _SPOS_MOD OF 2 GOTOF _MOD_ACN 1 GOTOF _MOD_ACP
N155 SUPA SPOS=DC(_M_SPE[8])
GOTOF _MT4
N156 _MOD_ACN:SUPA SPOS=ACN(_M_SPE[8])
GOTOF _MT4
N157 _MOD_ACP:SUPA SPOS=ACP(_M_SPE[8])
_MT4:IF (_VB[16]==0) OR _VB[28] OR _INTERN[3] OR _INTERN[11] OR _INTERN[19] GOTOF _MT4A
_MA1:IF (_M_ZUST[15]) AND (_M_ZUST[14]==0) GOTOF _MA1A
_M=(_M_SPE[9]-_M_SPE[5+_AXIND])
_M_POS=_M_SPE[17]+_M*_DAT[_AXIND,1]
IF (_M_POS>_M_SPE[17])AND(_M_POS>_DAT[0,4])
_M=(_DAT[0,4]-_M_SPE[17]-5/_INC)/_DAT[_AXIND,1] _M_ZUST[12]=1
ELSE
IF (_M_POS<_M_SPE[17]) AND (_M_POS<_DAT[0,5])
_M=(_DAT[0,5]-_M_SPE[17]+5/_INC)/_DAT[_AXIND,1] _M_ZUST[12]=1
ENDIF
ENDIF
_M_POS=_M_SPE[18]+_M*_DAT[_AXIND,2]
IF (_M_POS>_M_SPE[18])AND(_M_POS>_DAT[1,4])
_M=(_DAT[1,4]-_M_SPE[18]-5/_INC)/_DAT[_AXIND,2] _M_ZUST[12]=1
ELSE
IF (_M_POS<_M_SPE[18]) AND (_M_POS<_DAT[1,5])
_M=(_DAT[1,5]-_M_SPE[18]+5/_INC)/_DAT[_AXIND,2] _M_ZUST[12]=1
ENDIF
ENDIF
_M_POS=_M_SPE[19]+_M*_DAT[_AXIND,3]
IF (_M_POS>_M_SPE[19])AND(_M_POS>_DAT[2,4])
_M=(_DAT[2,4]-_M_SPE[19]-5/_INC)/_DAT[_AXIND,3] _M_ZUST[12]=1
ELSE
IF (_M_POS<_M_SPE[19]) AND (_M_POS<_DAT[2,5])
_M=(_DAT[2,5]-_M_SPE[19]+5/_INC)/_DAT[_AXIND,3] _M_ZUST[12]=1
ENDIF
ENDIF
IF _M_ZUST[12]
;_R1=_M_SPE[9]-(_M+_M_SPE[5+_AXIND]) _M_SPE[9]=_M_SPE[9]-_R1
ENDIF
_MA1A:
IF _M_ZUST[4] OR _M_ZUST[15]
_M=(_M_SPE[10]-_M_SPE[5+_AXIND]) _M_POS=_M_SPE[17]+_M*_DAT[_AXIND,1]
IF (_M_POS>_M_SPE[17])AND(_M_POS>_DAT[0,4])
_M=(_DAT[0,4]-_M_SPE[17]-5/_INC)/_DAT[_AXIND,1] _M_ZUST[13]=1
ELSE
IF (_M_POS<_M_SPE[17]) AND (_M_POS<_DAT[0,5])
_M=(_DAT[0,5]-_M_SPE[17]+5/_INC)/_DAT[_AXIND,1] _M_ZUST[13]=1
ENDIF
ENDIF
_M_POS=_M_SPE[18]+_M*_DAT[_AXIND,2]
IF (_M_POS>_M_SPE[18])AND(_M_POS>_DAT[1,4])
_M=(_DAT[1,4]-_M_SPE[18]-5/_INC)/_DAT[_AXIND,2] _M_ZUST[13]=1
ELSE
IF (_M_POS<_M_SPE[18]) AND (_M_POS<_DAT[1,5])
_M=(_DAT[1,5]-_M_SPE[18]+5/_INC)/_DAT[_AXIND,2] _M_ZUST[13]=1
ENDIF
ENDIF
_M_POS=_M_SPE[19]+_M*_DAT[_AXIND,3]
IF (_M_POS>_M_SPE[19])AND(_M_POS>_DAT[2,4])
_M=(_DAT[2,4]-_M_SPE[19]-5/_INC)/_DAT[_AXIND,3] _M_ZUST[13]=1
ELSE
IF (_M_POS<_M_SPE[19]) AND (_M_POS<_DAT[2,5])
_M=(_DAT[2,5]-_M_SPE[19]+5/_INC)/_DAT[_AXIND,3] _M_ZUST[13]=1
ENDIF
ENDIF
_M_SPE[10]=_M+_M_SPE[5+_AXIND]
ENDIF
IF _M_ZUST[14] OR _M_ZUST[15]
RET
ENDIF
IF (_M_ZUST[4]==0) AND _M_ZUST[12]
_M_SPE[10]=_M_SPE[10]-_R1
IF ((_R1>0) AND (_M_SPE[10]<_M_SPE[5+_AXIND]))OR((_R1<0) AND (_M_SPE[10]>_M_SPE[5+_AXIND]))
_M_SPE[10]=_M_SPE[5+_AXIND]
ENDIF
ENDIF
N100 _MT4A:G0 G94 G90
IF _VB[1] GOTOF _MT5
N105 G1 F=_M_SPE[2]
IF (_INTERN[18])AND(_MAV==_ZZ) GOTOF _MT5
F=_M_SPE[1]
_MT5:IF _INTERN[40+2]==0 GOTOF _MT8
IF _VB[15] GOTOF _MT10 IF (_M_SPE[5+_AXIND]==_M_SPE[10]) GOTOF _MT10
N110 MEAS=_M_N[0] AX[_MAV]=_M_SPE[10]*_M_SPE[20]
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MT10
_ALARM=61302
RET
N120 _MT8:AX[_MAV]=_M_SPE[10]*_M_SPE[20]
_MT10:IF (_M_ZUST[4]==0)AND(_M_ZUST[8]==0) GOTOF _MT16 IF _VB[16]==0 GOTOF _MT16
IF (_VB[3]==0) OR ((_INTERN[18])AND(_MAV==_ZZ)) GOTOF _MT11 IF _M_ZUST[4]==0 GOTOF _MT11
_M_SPE[8]=_M_SPE[8]+180 _M_SPE[8]=_M_SPE[8]-TRUNC(_M_SPE[8]/360)*360
N106 SUPA SPOS=AC(_M_SPE[8])
N130 _MT11:G91 F=_M_SPE[2]
IF (_INTERN[40+2]==0)AND(_M_ZUST[13]==0) GOTOF _MT14
N135 MEAS=_M_N[0] AX[_ZZ]=_ID
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MT16
_ALARM=61302
IF _M_ZUST[13]
_ALARM=61402
ENDIF
RET
N145 _MT14:AX[_ZZ]=_ID
_MT16:_M_N[5]=5 _M_N[6]=0
IF _INTERN[40+15]
_M_N[5]=1
ENDIF
IF (_OVI[2]==971)AND($AC_MSNUM)
_SP_STAT= $AA_S[$AC_MSNUM] _SP_DREH=$P_S[$AC_MSNUM] _SP_DIR=$P_SDIR[$AC_MSNUM]
IF _SP_DIR==5
_SP_STAT=0
ENDIF
IF (_VB[29]==0)AND(_VB[30]==0)
N299 M5
ENDIF
ENDIF
_MT17:
IF _VB[30]
IF _INTERN[20+12]
_M_SPE[0]=_MFS[1] _Z=0
IF _SP_STAT<>0
N300 S=_MFS[0]
ELSE
N301 S=_MFS[0] M=_M_SPE[40+5]
ENDIF
ELSE
IF $MN_SCALING_SYSTEM_IS_METRIC
_DREH=_M_SPE[40+0]*1000/2/$PI/$P_TOOLR
ELSE
_DREH=_M_SPE[40+0]*12/2/$PI/$P_TOOLR
ENDIF
IF _DREH>_M_SPE[40+1]
_DREH=_M_SPE[40+1]
ENDIF
_FWZ=_DREH*_M_SPE[40+3]
IF _FWZ<_M_SPE[40+2]
_FWZ=_M_SPE[40+2]
ENDIF
_Z=6 _M_SPE[0]=_FWZ
IF _M_SPE[40+_Z]
_M_SPE[0]=_FWZ*_M_SPE[40+_Z]
ENDIF
IF _M_SPE[0]>_M_SPE[40+4]
_M_SPE[0]=_M_SPE[40+4]
ENDIF
IF _SP_STAT<>0
N311 S=_DREH
ELSE
N312 S=_DREH M=_M_SPE[40+5]
ENDIF
ENDIF
ENDIF
_MT18:_M_ME[2]=0
N160 G1 G90 G64 F=_M_SPE[0]
IF (_VB[30]==0) AND (_INTERN[40+17]) AND (_Z==0) AND (ABS(_M_SPE[3])>_DELTA)
F=_M_SPE[48+3]*_M_SPE[29]
ENDIF
N165 MEAS=_M_N[0] AX[_MAV]=_M_SPE[9]*_M_SPE[20]
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MT21
IF _VB[30]==0 GOTOF _MT21
N175 G0 G60 AX[_MAV]=($AA_MW[_MAV]+($AA_MW[_MAV]-$AA_IW[_MAV]/_H)*4)*_M_SPE[20]
STOPRE
N177 G1 F=_M_SPE[1]
IF _INTERN[20+12]==0 GOTOF _MZ0
_Z=_Z+2
IF _MFS[_Z]==0 GOTOF _MT21
_M_SPE[0]=_MFS[_Z+1]
N320 S=_MFS[_Z]
GOTOB _MT18
_MZ0:IF _M_SPE[40+_Z]==0 GOTOF _MT21
_Z=_Z+1
IF _M_SPE[40+_Z]
_M_SPE[0]=_FWZ*_M_SPE[40+_Z]
ELSE
_M_SPE[0]=_FWZ
ENDIF
IF _M_SPE[0]>_M_SPE[40+4]
_M_SPE[0]=_M_SPE[40+4]
ENDIF
GOTOB _MT18
_MT21:
IF _VB[1]
N178 G0
ELSE
IF _INTERN[40+16] AND _INTERN[40+2]
IF (_INTERN[18])AND(_MAV==_ZZ)
N179 F=$MA_MAX_AX_VELO[_ZZ]*_M_N[14]/100
ELSE
N166 F=$MA_MAX_AX_VELO[_XX]*_M_N[14]/100
IF $MA_MAX_AX_VELO[_YY]<$MA_MAX_AX_VELO[_XX]
N167 F=$MA_MAX_AX_VELO[_YY]*_M_N[14]/100
ENDIF
ENDIF
ELSE
IF (_INTERN[18])AND(_MAV==_ZZ)
N180 F=_M_SPE[2]
ELSE
N181 F=_M_SPE[1]
ENDIF
ENDIF
ENDIF
IF _VB[30] OR (_INTERN[40+17]==0) OR ($AC_MEA[ABS(_M_N[0])]==0) OR _Z OR (ABS(_M_SPE[3])<=_DELTA) GOTOF _MT22
_Z=1 _HR=$AA_MW[_MAV]-$AA_IW[_MAV]/_H _HR=_HR/ABS(_HR)*2*_DELTA
IF (_M_ZUST[4])OR((_M_ZUST[4]==0)AND(_M_ZUST[8]))
IF (_HR>0)AND($AA_MW[_MAV]+_HR>_M_SPE[10])OR(_HR<0)AND($AA_MW[_MAV]+_HR<_M_SPE[10])
_HR=_M_SPE[10]-$AA_MW[_MAV]
ENDIF
ENDIF
_HR=$AA_MW[_MAV]+_HR
N182 G60 AX[_MAV]=_HR*_M_SPE[20]
GOTOB _MT18
N185 _MT22:
IF (_VB[30]==0) AND _INTERN[40+17] AND _Z AND (_M_N[6]+1<_M_N[20])
N333 AX[_MAV]=_HR*_M_SPE[20]
ELSE
N334 AX[_MAV]=_M_SPE[10]*_M_SPE[20]
ENDIF
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MT25
_M_ME[1]=$AA_MW[_MAV]
_M_N[6]=_M_N[6]+1 _M_ME[8]=_M_ME[8]+_M_ME[1] _M_ME[9]=_M_ME[9]+_M_ME[2]
IF (_M_N[6]<_M_N[20])AND(_VB[30]==0) GOTOB _MT18 IF _M_N[6]<_M_N[20] GOTOB _MT17
_M_ME[8]=_M_ME[8]/_M_N[6] _M_ME[9]=_M_ME[9]/_M_N[6]
GOTOF _ENDE
_MT25:IF _M_N[5]==1 GOTOF _MT26
_M_N[5]=_M_N[5]-1
GOTOB _MT18
_MT26:_ALARM=61301
IF _M_ZUST[12]
_ALARM=61401
ENDIF
_ENDE:
IF (_OVI[2]==971)AND($AC_MSNUM)
IF _SP_STAT<>0
N190 S=_SP_DREH M=_SP_DIR
ELSE
IF $AA_S[$AC_MSNUM]<>0
N195 M5
ENDIF
ENDIF
ENDIF
RET

%_N_CYCLE112_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE112(VAR AXIS _XX,VAR AXIS _YY,VAR AXIS _ZZ,VAR REAL _M_SPE[],VAR REAL _M_ME[], VAR REAL _WINKEL, VAR INT _M_N[],VAR INT _ALARM,VAR BOOL _M_ZUST[],VAR BOOL _VB[],VAR BOOL _INTERN[])
;V06.02.08  Mar 21, 2002
;C06.02.07 Feb 15, 2001
;UP Messen polar
DEF INT _HI
DEF REAL _HR,_HR1,_HR2,_HR3,_HH,_HH1
_HH=_WINKEL-TRUNC(_WINKEL/ 360)*360
IF _INTERN[40+2]==0 GOTOF _MM1 IF _VB[27] GOTOF _MM1
_HI=1
IF _VB[2]==0 GOTOF _MM1
_HI=2
_MM1:IF _VB[3]==0 GOTOF _MM14
_M_SPE[8]=_M_SPE[8]-TRUNC(_M_SPE[8]/ 360)*360
IF _M_SPE[8]<0
_M_SPE[8]=_M_SPE[8]+360
ENDIF
IF _M_SPE[8]> 359.999
_M_SPE[8]=0
ENDIF
IF _VB[2]==0 GOTOF _MM13 IF _M_ZUST[4]==0 GOTOF _MM11
_M_SPE[8]=_M_SPE[8]+180 _M_SPE[8]=_M_SPE[8]-TRUNC(_M_SPE[8]/ 360)*360
_MM11:IF _INTERN[20+8]==0 GOTOF _MM13
_M_SPE[8]=_M_SPE[8]+_M_SPE[38] _M_SPE[8]=_M_SPE[8]-TRUNC(_M_SPE[8]/ 360)*360
N145 _MM13:IF (_M_ZUST[0]==0)AND ((_VB[2]==0)OR((_HI==2)AND(_MVAR MOD 10 <>3))) GOTOF _MM14
SUPA SPOS=DC(_M_SPE[8])
_MM14:IF (_M_ZUST[0]) AND (_VB[27]==0) GOTOF _MM6
IF _M_ZUST[6] GOTOF _MM4
G3 G90 G94 F=_RF
IF (_INCA>0)AND (_VB[27]==0) OR (_INCA<0)AND (_VB[27]) GOTOF _MM3
G2
_MM3:_VB[27]=0
CASE (_HI) OF 1 GOTOF _MM31 2 GOTOF _MM32
N100 RP=_M_SPE[10]*_M_SPE[20] AP=_HH
GOTOF _MM6
N105 _MM31: MEAS=_M_N[0] RP=_M_SPE[10]*_M_SPE[20] AP=_HH 
N110 STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MM6
_ALARM=61302
RET
_MM32:_HR=90 _HR1=_WINKEL-_INCA _HR2=ABS(_INCA/10) _HR3=_M_SPE[8]
IF _INCA>0 GOTOF _MM33
_HR=-90
_MM33:
IF _VB[31]==0
_M_SPE[8]=360-$P_ACTFRAME[_ZZ,RT]-(_HR1+_HR)
ELSE
_M_SPE[8]=$P_ACTFRAME[_ZZ,RT]+(_HR1+_HR)
ENDIF
_M_SPE[8]=_M_SPE[8]-TRUNC(_M_SPE[8]/ 360)*360
IF _M_SPE[8]<0
_M_SPE[8]=_M_SPE[8]+360
ENDIF
IF _INTERN[20+8]
_M_SPE[8]=_M_SPE[8]+_M_SPE[38] _M_SPE[8]=_M_SPE[8]-TRUNC(_M_SPE[8]/ 360)*360
ENDIF
IF _M_N[13] GOTOF _MM35
N150 SUPA SPOSA=DC(_M_SPE[8])
_HH1=_HR1+_INCA/_HR2 _HH1=_HH1-TRUNC(_HH1/ 360)*360
N155 MEAS=_M_N[0] RP=_M_SPE[10]*_M_SPE[20] AP=_HH1
STOPRE
IF $AC_MEA[ABS(_M_N[0])]
_ALARM=61302
RET
ENDIF
_HR1=_HR1+_INCA/_HR2
IF _HR1<_WINKEL GOTOB _MM33
_MM34:_M_SPE[8]=_HR3
N160 SUPA SPOS=DC(_M_SPE[8])
GOTOF _MM6
N160 _MM35:SUPA SPOS=DC(_M_SPE[8])
IF _VB[31]==0
_HR1=360-$P_ACTFRAME[_ZZ,RT]-(_WINKEL+_HR)
ELSE
_HR1=$P_ACTFRAME[_ZZ,RT]+(_WINKEL+_HR)
ENDIF
_HR1=_HR1-TRUNC(_HR1/360)*360
IF _HR1<0
_HR1=_HR1+360
ENDIF
IF _INTERN[20+8]
_HR1=_HR1+_M_SPE[38] _HR1=_HR1-TRUNC(_HR1/360)*360
ENDIF
_HR1=_HR1-_M_SPE[8]
IF ABS(_HR1)<>ABS(_INCA)
IF _HR1>0
_HR1=_HR1-360
ELSE
_HR1=_HR1+360
ENDIF
ENDIF
IF _M_N[10]>5
;;;N165 MEAS=_M_N[0] RP=_M_SPE[10]*_M_SPE[20] AP=_HH AX[_M_N[13]-1)]=IC(_HR1)
N165 MEAS=_M_N[0] RP=_M_SPE[10]*_M_SPE[20] AP=_HH AX[_M_N[13]-1]=IC(_HR1)
ELSE
N165 MEAS=_M_N[0] RP=_M_SPE[10]*_M_SPE[20] AP=_HH AX[AXNAME($MC_AXCONF_CHANAX_NAME_TAB[_M_N[13]-1])]=IC(_HR1)
ENDIF
GOTOB _MM34
_MM4:_VB[27]=0
G0 G91
IF _VB[1] GOTOF _MM41
G1 F=_M_SPE[1]
_MM41:IF _M_ZUST[5]==0 GOTOF _MM45
F=_M_SPE[2]+1
CASE (_HI) OF 1 GOTOF _MM42 2 GOTOF _MM42
N115 AX[_ZZ]=_ID*_M_SPE[20]
GOTOF _MM45
N120 _MM42:MEAS=_M_N[0] AX[_ZZ]=_ID
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MM45
_ALARM=61302
RET
_MM45:G90 F=_M_SPE[1]+1
CASE (_HI) OF 1 GOTOF _MM47 2 GOTOF _MM47
N125 RP=_M_SPE[10]*_M_SPE[20] AP=_HH
GOTOF _MM5
N130 _MM47: MEAS=_M_N[0] RP=_M_SPE[10]*_M_SPE[20] AP=_HH
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MM5
_ALARM=61302
RET
_MM5:IF _M_ZUST[5]==0 GOTOF _MM52
F=_M_SPE[2]+1
CASE (_HI) OF 1 GOTOF _MM51 2 GOTOF _MM51
N135 G91 AX[_ZZ]=-_ID*_M_SPE[20]
GOTOF _MM6
N140 _MM51:G91 MEAS=_M_N[0] AX[_ZZ]=-_ID
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MM52
_ALARM=61302
RET
_MM52: IF _VB[2]==0 GOTOF _MM6
N145 SUPA SPOS=DC(_M_SPE[8])
_MM6:_M_N[5]=5 _M_N[6]=0
_MM71:_M_ME[2]=0
N150 G1 G90 F=_M_SPE[0]
N155 MEAS=_M_N[0] RP=_M_SPE[9]*_M_SPE[20] AP=_HH
IF _INTERN[40+7]==0 GOTOF _MM73
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MM73
N156 MEAS=-_M_N[0] RP=_M_SPE[10]*_M_SPE[20] AP=_HH
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MM7A
N157 _MM73:G0
IF _VB[1] GOTOF _MM74
N160 G1 F=_M_SPE[1]
N165 _MM74:RP=_M_SPE[10]*_M_SPE[20] AP=_HH
STOPRE
IF $AC_MEA[ABS(_M_N[0])]==0 GOTOF _MM79
_M_ME[1]=$AA_MW[_XX] _M_ME[2]=$AA_MW[_YY] _M_ME[8]=_M_ME[8]+_M_ME[1] _M_ME[9]=_M_ME[9]+_M_ME[2]
_M_N[5]=5 _M_N[6]=_M_N[6]+1
IF _M_N[6]-_M_N[20] < 0 GOTOB _MM71
_M_ME[8]=_M_ME[8]/_M_N[6] _M_ME[9]=_M_ME[9]/_M_N[6]
RET
_MM79:IF _M_N[5]==1 GOTOF _MM7A
_M_N[5]=_M_N[5]-1
GOTOB _MM71
_MM7A:_ALARM=61301
RET

%_N_CYCLE113_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE113(INT _STAT,VAR STRING[10] _DT) SAVE DISPLOF
;V06.02.17 May 28, 2003
;C06.02.03 Nov 07, 2001
;Protokollieren_Systemdatenbeschaffung
N20 DEF STRING[5] _YS,_MM,_DS
IF _STAT==2 GOTOF _ZEIT
_YS="0"<<$A_YEAR _MM="0"<<$A_MONTH _DS="0"<<$A_DAY
IF STRLEN(_YS)==2 GOTOF _M1
_YS=SUBSTR(_YS,1,2)
_M1:IF STRLEN(_MM)==2 GOTOF _M2
_MM=SUBSTR(_MM,1,2)
_M2:IF STRLEN(_DS)==2 GOTOF _M3
_DS=SUBSTR(_DS,1,2)
_M3:_DT=_DS<<"/"<<_MM<<"/"<<_YS
RET
_ZEIT:_YS="0"<<$A_HOUR _MM="0"<<$A_MINUTE _DS="0"<<$A_SECOND
IF STRLEN(_YS)==2 GOTOF _M4
_YS=SUBSTR(_YS,1,2)
_M4:IF STRLEN(_MM)==2 GOTOF _M5
_MM=SUBSTR(_MM,1,2)
_M5:IF STRLEN(_DS)==2 GOTOF _M6
_DS=SUBSTR(_DS,1,2)
_M6:_DT=_YS<<":"<<_MM<<":"<<_DS
RET


%_N_CYCLE114_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE114(INT _SEL,VAR INT _ALARM,AXIS _MAV,BOOL _ADD,REAL _I_TMV,INT _I_K,BOOL _I_CH_4,BOOL _I_CH_6)
;V06.02.08  Mar 21, 2002
;C06.02.04 Nov 27, 2001
;NV Speicher laden, Mittelwertbildung WK Korrektur
DEF FRAME WKS_WOS,_REL_FRAME
DEF REAL _COS,_SIN,_WKS[3],_WKS_S[3],_WOS[3],_WOS_S[3],_BKS[3],_IW_WI,_SW_WI,_DIF[3],_D,_XRT,_YRT,_ZRT,_W_1,_W_2,_W_3,_KF[3,3]
DEF AXIS _XX,_YY,_ZZ,_PLAN
DEF INT _MT_E,_H,_SW_NCK=3,_A,_O=1,_AP=2,_AX_EX[3]
DEF INT _T_1,_T_2,_T_3,_T_4,_T_5,_T_6,_T_7,_TEMP,_H1,_I_PLAN,_FM=1,_IM=1,_H_XX=1,_H_YY=1,_H_ZZ=1,_I_L,_I_LA,_I_LO,_I_LAP
DEF INT _I_TYP,_I_MA
DEF REAL _HM=1,_L1=1,_L2=1,_L3=1,_MIRR=1
DEF BOOL _G,_V
DEF INT _M_BFNR
IF (ISNUMBER(_SI[1]))
_SW_NCK=NUMBER(_SI[1])
IF (_SW_NCK<6)
GOTOF _AL11
ENDIF
IF ($AN_NCK_VERSION<480000)
GOTOF _AL11
ENDIF
ELSE
GOTOF _AL11
ENDIF
IF $P_SEARCHL OR $P_SIM OR $P_DRYRUN
RET
ENDIF
_M_BFNR=$MC_MM_NUM_BASE_FRAMES-1
IF _SEL==2 GOTOF _PA2
IF $P_GG[6]==1 GOTOF _P1
_A=2 _O=0 _AP=1
IF $P_GG[6]==2 GOTOF _P1
_A=1 _O=2 _AP=0
_P1: IF ISAXIS(_A+1) GOTOF _P3 IF NOT ISAXIS(_O+1) GOTOF _P2
_XX=$P_AXN2 _A=_O
GOTOF _P4
_P2:_XX=$P_AXN3 _A=_AP
GOTOF _P4
_P3:_XX=$P_AXN1 _AX_EX[0]=1
_P4:IF ISAXIS(_O+1) GOTOF _P5
_O=_A _YY=_XX
GOTOF _P6
_P5:_YY=$P_AXN2 _AX_EX[1]=1
_P6:IF ISAXIS(_AP+1) GOTOF _P7
_AP=_A _ZZ=_XX
GOTOF _P8
_P7:_ZZ=$P_AXN3 _AX_EX[2]=1
_P8:_PLAN=_XX _I_L=_ISP[1] _I_LA=_I_L MOD 10 _I_LO=_I_L DIV 10 MOD 10 _I_LAP=_I_L DIV 100 MOD 10
IF ($MC_DIAMETER_AX_DEF=="") GOTOF _MM1 IF (_AX_EX[0]==1)AND(_XX==AXNAME($MC_DIAMETER_AX_DEF)) GOTOF _MM0
_H1=1 _PLAN=_YY
IF (_AX_EX[1]==1)AND(_YY==AXNAME($MC_DIAMETER_AX_DEF)) GOTOF _MM0
_H1=2 _PLAN=_ZZ
IF (_ZZ<>AXNAME($MC_DIAMETER_AX_DEF))OR(_AX_EX[2]==0) GOTOF _MM1
_MM0: _I_PLAN=1
IF _SW_NCK>=5
IF $MC_TOOL_PARAMETER_DEF_MASK B_AND 'B1000'
_FM=2
IF _PLAN==_XX
_H_XX=2
ELSE
IF _PLAN==_YY
_H_YY=2
ELSE
_H_ZZ=2
ENDIF
ENDIF
ENDIF
IF ($P_GG[29]==1)AND($MC_TOOL_PARAMETER_DEF_MASK B_AND 'B1000000')
_IM=2
ENDIF
ENDIF
_MM1:CASE (_SEL) OF 1 GOTOF _PA1 3 GOTOF _PA3 DEFAULT GOTOF _AL7
_PA1:IF (_KNUM==1000) AND (_SW_NCK<4) GOTOF _AL11
IF((_KNUM<0)OR((_KNUM<>1000)AND(_KNUM>$MC_MM_NUM_USER_FRAMES))) GOTOF _AL6
IF (_OVI[2]<>974)AND(_OVI[2]<>994) GOTOF _PA1A
IF (_MAV==$P_AXN1)
_TEMP=17
ELSE
IF (_MAV==$P_AXN2)
_TEMP=18
ELSE
_TEMP=19
ENDIF
ENDIF
IF ($P_ACTFRAME[_MAV,MI])
IF (($P_IFRAME[_MAV,MI])OR($P_PFRAME[_MAV,MI]))
IF _KNUM<>1000
IF ($P_UIFR[_KNUM,_MAV,MI])
_OVR[_TEMP]=-_OVR[_TEMP]
ENDIF
ENDIF
ELSE
IF _KNUM==1000
IF (_SW_NCK<4)OR((_SW_NCK>=4)AND( $P_CHBFR[_M_BFNR,_MAV,MI]))
_OVR[_TEMP]=-_OVR[_TEMP]
ENDIF
ENDIF
ELSE
ENDIF
ENDIF
IF _KNUM<>1000
IF _SW_NCK>=4
IF $MN_MM_FRAME_FINE_TRANS
IF (_ADD==0)
$P_UIFR[_KNUM,_MAV,TR]=_OVR[_TEMP]*_FM $P_UIFR[_KNUM,_MAV,FI]=0
ELSE
$P_UIFR[_KNUM,_MAV,FI]=$P_UIFR[_KNUM,_MAV,FI]+_OVR[_TEMP]*_FM
ENDIF
ELSE
IF (_ADD==0)
$P_UIFR[_KNUM,_MAV,TR]=_OVR[_TEMP]*_FM
ELSE
$P_UIFR[_KNUM,_MAV,TR]=$P_UIFR[_KNUM,_MAV,TR]+_OVR[_TEMP]*_FM
ENDIF
ENDIF
ELSE
IF (_ADD==0)
$P_UIFR[_KNUM,_MAV,TR]=_OVR[_TEMP]*_FM
ELSE
$P_UIFR[_KNUM,_MAV,TR]=$P_UIFR[_KNUM,_MAV,TR]+_OVR[_TEMP]*_FM
ENDIF
ENDIF
ELSE
IF _SW_NCK>=4
IF (_SW_NCK>4)AND(_SI[2]=="SM5.1")
_SW_NCK=4
ENDIF
IF _SW_NCK==4
IF $MN_MM_FRAME_FINE_TRANS
IF (_ADD==0)
$P_UBFR[_MAV,TR] = _OVR[_TEMP]*_FM $P_UBFR[_MAV,FI]=0
ELSE
$P_UBFR[_MAV,FI]=$P_UBFR[_MAV,FI]+_OVR[_TEMP]*_FM
ENDIF
ELSE
IF (_ADD==0)
$P_UBFR[_MAV,TR]=_OVR[_TEMP]*_FM
ELSE
$P_UBFR[_MAV,TR]=$P_UBFR[_MAV,TR]+_OVR[_TEMP]*_FM
ENDIF
ENDIF
ELSE
IF $MN_MM_FRAME_FINE_TRANS
IF (_ADD==0)
$P_CHBFR[_M_BFNR,_MAV,TR] = _OVR[_TEMP]*_FM $P_CHBFR[_M_BFNR,_MAV,FI]=0
ELSE
$P_CHBFR[_M_BFNR,_MAV,FI]=$P_CHBFR[_M_BFNR,_MAV,FI]+_OVR[_TEMP]*_FM
ENDIF
ELSE
IF (_ADD==0)
$P_CHBFR[_M_BFNR,_MAV,TR]=_OVR[_TEMP]*_FM
ELSE
$P_CHBFR[_M_BFNR,_MAV,TR]=$P_CHBFR[_M_BFNR,_MAV,TR]+_OVR[_TEMP]*_FM
,* $P_CHBFR[_M_BFNR,_MAV,TR]=$P_CHBFR[_M_BFNR,_MAV,TR]+$P_IFRAME[_MAV,TR]+_OVR[_TEMP]*_FM
ENDIF
ENDIF
ENDIF
ELSE
IF _ADD==0
$P_UBFR[_MAV,TR] = _OVR[_TEMP]*_FM
ELSE
$P_UBFR[_MAV,TR]=$P_UBFR[_MAV,TR]+_OVR[_TEMP]*_FM
ENDIF
ENDIF
ENDIF
GOTOF _FIN
_PA1A:_WKS[0]=SET($AA_IW[_XX],$AA_IW[_YY],$AA_IW[_ZZ]) _WKS_S[0]=SET($AA_IW[_XX],$AA_IW[_YY],$AA_IW[_ZZ])
WKS_WOS=$P_IFRAME:$P_PFRAME
IF _SW_NCK>=4
IF (_SW_NCK>4)AND(_SI[2]=="SM5.1")
_SW_NCK=4
ENDIF
IF $MN_MM_FRAME_FINE_TRANS
WKS_WOS[_XX,TR]=WKS_WOS[_XX,TR]+WKS_WOS[_XX,FI] WKS_WOS[_YY,TR]=WKS_WOS[_YY,TR]+WKS_WOS[_YY,FI] WKS_WOS[_ZZ,TR]=WKS_WOS[_ZZ,TR]+WKS_WOS[_ZZ,FI] WKS_WOS[_XX,FI]=0 WKS_WOS[_YY,FI]=0 WKS_WOS[_ZZ,FI]=0
ENDIF
ENDIF
_WKS[0+_H1]=_WKS[0+_H1]/_IM _WKS_S[0+_H1]=_WKS_S[0+_H1]/_IM WKS_WOS[_PLAN,TR]=WKS_WOS[_PLAN,TR]/_FM
IF _OVI[2]==978
IF ($P_ACTFRAME[_MAV,MI]==1)
_WKS[_MA-1]=_OVR[4+_MA] _WKS_S[_MA-1]=_OVR[_MA]
IF (($P_IFRAME[_MAV,MI])OR($P_PFRAME[_MAV,MI]))
IF _KNUM<>1000
IF ($P_UIFR[_KNUM,_MAV,MI])
_WKS[_MA-1]=2*_OVR[_MA]-_OVR[4+_MA] _WKS_S[_MA-1]=_OVR[_MA]
ENDIF
ELSE
_WKS[_MA-1]=2*_OVR[_MA]-_OVR[4+_MA] _WKS_S[_MA-1]=_OVR[_MA]
ENDIF
ELSE
IF _KNUM==1000
IF (_SW_NCK<4)OR((_SW_NCK>=4)AND( $P_CHBFR[_M_BFNR,_MAV,MI]))
_WKS[_MA-1]=2*_OVR[_MA]-_OVR[4+_MA] _WKS_S[_MA-1]=_OVR[_MA]
ENDIF
ENDIF
ENDIF
ELSE
_WKS[_MA-1]=_OVR[4+_MA] _WKS_S[_MA-1]=_OVR[_MA]
ENDIF
ELSE
IF (_OVI[2]==977) AND ((_MVAR MOD 10==5) OR (_MVAR MOD 10==6))
_H=1
ENDIF
_WKS[0]=SET(_OVR[5+_H],_OVR[6+_H]) _WKS_S[0]=SET(_OVR[1+_H],_OVR[2+_H])
IF ((($P_ACTFRAME[_XX,MI]==1)OR($P_ACTFRAME[_YY,MI]==1))AND((_OVI[2]==977)OR(_OVI[2]==979)))
IF ($P_ACTFRAME[_XX,MI]==1)
_WKS[0]=2*_OVR[1+_H]-_OVR[5+_H]
ENDIF
IF ($P_ACTFRAME[_YY,MI]==1)
_WKS[1]=2*_OVR[2+_H]-_OVR[6+_H]
ENDIF
ENDIF
IF (_OVI[2]==961)
_IW_WI=_OVR[4]
ENDIF
ENDIF
_XRT=WKS_WOS[_XX,RT]*_AX_EX[0] _YRT=WKS_WOS[_YY,RT]*_AX_EX[1] _ZRT=WKS_WOS[_ZZ,RT]*_AX_EX[2]
_W_1=_XRT _W_2=_YRT _W_3=_ZRT
IF _A<>0
IF _A==2
_W_3=_XRT _W_1=_YRT _W_2=_ZRT
ELSE
_W_3=_YRT _W_2=_XRT _W_1=_ZRT
ENDIF
ENDIF
_KF[0,0]=COS(_W_2)*COS(_W_3) _KF[0,1]=-COS(_W_1)*SIN(_W_3)+SIN(_W_1)*SIN(_W_2)*COS(_W_3) _KF[0,2]=SIN(_W_1)*SIN(_W_3)+COS(_W_1)*SIN(_W_2)*COS(_W_3) _KF[1,0]=COS(_W_2)*SIN(_W_3)
_KF[1,1]=COS(_W_1)*COS(_W_3)+SIN(_W_1)*SIN(_W_2)*SIN(_W_3) _KF[1,2]=-SIN(_W_1)*COS(_W_3)+COS(_W_1)*SIN(_W_2)*SIN(_W_3) _KF[2,0]=-SIN(_W_2) _KF[2,1]=SIN(_W_1)*COS(_W_2) _KF[2,2]=COS(_W_1)*COS(_W_2)
_WOS[0]=WKS_WOS[_XX,TR]+_KF[_A,_A]* _WKS[0]+_KF[_A,_O]* _WKS[1]+_KF[_A,_AP]* _WKS[2]
