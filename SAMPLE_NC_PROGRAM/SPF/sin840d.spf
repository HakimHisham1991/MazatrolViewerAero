_HT=_HT<<_PROTSYM[1]
ENDIF
GOTOF _WX
_T979:
N153 IF((_MVAR<100) AND (((_HI>=4)AND(_HI<=6))OR((_HI>=16)AND(_HI<=18))) AND (ABS(_OVR[16+(_HI MOD 4)])>_TOLPAR) )
_HT=_HT<<_PROTSYM[1]
ENDIF
