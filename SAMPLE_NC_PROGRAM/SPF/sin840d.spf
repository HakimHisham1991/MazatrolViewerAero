_I2=_I2+1
GOTOB _NXRU
_SRV:_H1=_WINT-_WZR
IF _MIDA
_BRI=_MIDA
ELSE
_BRI=_WZR*1.6
ENDIF
_AZB=TRUNC(_H1/_BRI) _I3=-1
IF _BRI*_AZB<>_H1
_AZB=_AZB+1
ENDIF
_BRI=_H1/_AZB _I2=1 _RURA=0 _H3=(_AZB-1)*_BRI
IF _ZB[3] GOTOF _MY84
_I3=1
_MY84:
IF _ZB[1] GOTOF _ZUBAHN IF _ZB[2] GOTOF _ZBG1 IF _ZB[0] GOTOF _ZBG1
