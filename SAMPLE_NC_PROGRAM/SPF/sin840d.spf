%_N_CYCLE_976_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE_976 SAVE DISPLOF
;V06.02.08  Mar 21, 2002
;C06.02.08 Mar 22, 2002
;Kalibrieren an Flaeche und in Bohrung
N1000 DEF BOOL _INTERN[60],_M_ZUST[16],_VB[56]
N1010 DEF REAL _M_SPE[52],_M_ME[11],_P_POS,_TRIGLAG,_LAGE,_TEMP
