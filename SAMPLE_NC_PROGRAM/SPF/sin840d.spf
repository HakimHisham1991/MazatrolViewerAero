_R[0]=0.0866*_WID _R[1]=0.15*_WID
REPEAT _ABA _ABE
AX[_XX]=(0.175-0.0866)*_WID AX[_YY]=_WID
REPEAT _ZUA _ZUE
G91 AX[_XX]=_R[0] AX[_YY]=-_R[1]
AX[_XX]=_R[0] AX[_YY]=_R[1]
_OE14:
_ZUA:
IF (_ARTIS[11]==2)
IF (_ARTIS[9]==_ARTIS[1])
M=_ARTIS[7];;;QU(_ARTIS[7])
ENDIF
ENDIF
N400 G1 G90 AX[_ZZ]=_DPI F=_FFD ;G[15]=_G15T 
N401 G09
N402  F=_FFP1 ;G[15]=_G15G
_ZUE:
_ABA:
N500 G09
IF (_ARTIS[11]==2)
IF (_ARTIS[9]==_ARTIS[2])
M=_ARTIS[7];;;QU(_ARTIS[8])
ENDIF
ENDIF
SBLON
N502 G90 G0 AX[_ZZ]=_ABHZ
SBLOF
_ABE:
_GET_A1:
IF(NOT _GET_A)
_GET_A=1
_D=$A_DAY _M=$A_MONTH _Y=$A_YEAR _HH=$A_HOUR _MM=$A_MINUTE
_D_STR=<<_D
IF(_D<=9)
_D2_STR="0"<<_D
ELSE
_D2_STR=_D_STR
ENDIF
_M_STR=<<_M
IF(_M<=9)
_M2_STR="0"<<_M
ELSE
_M2_STR=_M_STR
ENDIF
_Y_STR=<<_Y
IF(_Y<=9)
_Y2_STR="0"<<_Y
ELSE
_Y2_STR=_Y_STR
ENDIF
_Y4_STR="20"<<_Y2_STR
IF(_HH<=9)
_HH_STR="0"<<_HH
ELSE
_HH_STR=<<_HH
ENDIF
IF(_MM<=9)
_MM_STR="0"<<_MM
ELSE
_MM_STR=<<_MM
ENDIF
_T24_STR=_HH_STR<<":"<<_MM_STR
IF(_HH>=12)
_AM_PM="PM"
ELSE
_AM_PM="AM"
ENDIF
_HH=_HH MOD 12
IF(_HH==0)
_HH=12
ENDIF
IF(_HH<=9)
_HH12_STR="0"<<_HH
ELSE
_HH12_STR=<<_HH
ENDIF
_T12_STR=_HH12_STR<<":"<<_MM_STR<<" "<<_AM_PM
ENDIF
_GET_A2:
_RUECK:
SBLON
N610 G90 G0 AX[_ZZ]=_RTP
_END:
IF _VI[2]==2
SBLOF
N620 ST_CUST(_UMODE+1)
SBLON
ENDIF
MSG()
IF (_IS_CYCFR==1)
$P_CYCFRAME=_RE_CYCFR
ENDIF
TRANS
ROT
RET
_M_ST_POS:
$AC_MEAS_VALID=0
$AC_MEAS_TYPE=24
$AC_MEAS_P1_COORD=0
$AC_MEAS_P2_COORD=1
$AA_MEAS_POINT1[_XX]=0
$AA_MEAS_POINT1[_YY]=0
$AA_MEAS_POINT1[_ZZ]=_ABHZ
_ERR=MEASURE()
_SC_POS[3]=SQRT(ABS(POT($AA_MEAS_POINT2[_XX])+POT($AA_MEAS_POINT2[_YY])))
;;;$P_CYCFRAME=INVFRAME(_RE_CYCFR):$P_CYCFRAME:CTRANS(_ZZ,_ABHZ)
$P_CYCFRAME=_RE_CYCFR:$P_CYCFRAME:CTRANS(_ZZ,_ABHZ)
_SC_POS[0]=$P_CYCFRAME[_XX,TR]
_SC_POS[1]=$P_CYCFRAME[_YY,TR]
_SC_POS[2]=$P_CYCFRAME[_ZZ,TR]
$P_CYCFRAME=_RE_CYCFR
RET
_FEHL1:STOPRE
SETAL(61101)
RET
_FEHL2:STOPRE
SETAL(61179,_ZEZA)
RET
_FEHL3:STOPRE
SETAL(61012)
RET
