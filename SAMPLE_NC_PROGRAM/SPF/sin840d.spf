N200 M0
N210 MSG("")
_POF:RET

%_N_CYCLE105_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE105(INT _SEL) SAVE DISPLOF
;V06.02.17 May 28, 2003
;C06.02.17 Mar 21, 2003
;Protokollieren_Datensatz_zusammenstellen
N10 DEF STRING[200] _TMP_1,_TXI,_TXA,_HT,_HT2
N15 DEF STRING[10] _DTT
N20 DEF STRING[12] _TMP_ST
N22 DEF STRING[21] _LEER[21]
N25 DEF INT _CR,_II=0,_JJ,_HI,_IPOS1,_IPOS2,_IL,_LEN,_T_IND,_ZZ,_TMP_PFORM,_SB,_SB_ALT,_C_Z,_ANZ_SP
N26 DEF BOOL _M1,_M2
N27 DEF INT _KK,_PFORM1
N28 DEF REAL _TOLPAR
_PFORM1=_PROTFORM[1]
IF _PFORM1<200 GOTOF _TT1
IF _PFORM1==200
_PFORM1=199
ELSE
_PFORM1=199
N24 Cycle108(62310,0)
STOPRE
ENDIF
_TT1: _II=0 _ANZ_SP=1
_TT4:IF (_PROTVAL[_II]<>"")AND(_II<=5) GOTOF _TT2
_II=_II+1
IF _II<=5 GOTOB _TT4
GOTOF _PF3
_TT2:_TXI=_PROTVAL[_II]
_TT3: _JJ=-1;;;MATCH(_TXI,",")
IF _JJ==(-1) GOTOF _TT5
_TXI=SUBSTR(_TXI,_JJ+1) _ANZ_SP=_ANZ_SP+1
GOTOB _TT3
_TT5: IF _ANZ_SP*_PROTFORM[5]<=_PFORM1 GOTOF _START
N32 Cycle108(62311,0)
_PFORM1=_ANZ_SP*_PROTFORM[5]
IF _PFORM1>200 GOTOF _PF4
_START:_II=0 _JJ=0 _TXI=""
N27 CYCLE107(14)
STARTFIFO
N28 IF _PROTFORM[5]>20
_M1=1
ENDIF
N11 _LEER[0]="" _LEER[1]=" " _LEER[2]="  " _LEER[3]="   " _LEER[4]="    " _LEER[5]="     " _LEER[6]="      " _LEER[7]="       " _LEER[8]="        " _LEER[9]="         " _LEER[10]="          " _LEER[11]="           " _LEER[12]="            "
N12 _LEER[13]="             " _LEER[14]="              " _LEER[15]="               " _LEER[16]="                " _LEER[17]="                 " _LEER[18]="                  " _LEER[19]="                   " _LEER[20]="                    "
N22 _PROTVAL[8]=" " _PROTVAL[9]=" " _PROTVAL[10]=" " _PROTVAL[11]=" " _PROTVAL[12]=" " _SB_ALT=0 _SB=0 _C_Z=0
N46 IF _SEL==1
_II=0 _PROTVAL[6]=" " _PROTVAL[7]=" " _TMP_PFORM=1
FOR _C_Z=0 TO 19
_SP_B[_C_Z]=0
ENDFOR
_C_Z=0
ELSE
_II=2 _TMP_PFORM=_PROTFORM[4]+1
N47 ENDIF
N50 _NZEIL:IF _II>_TMP_PFORM GOTOF _FINE
N55 _TXI=_PROTVAL[_II] _IL=STRLEN(_TXI) _II=_II+1 _JJ=0 _IPOS1=0 _CR=0 _C_Z=0
N56 If _M2
_M2=0
ELSE
_TXA=""
N59 EndIF
N60 IF _IL==0 GOTOF _FINE IF _II>6 GOTOF _PF2
N65 _DEC1:_JJ=-1;;;MATCH(_TXI,",")
N66 _C_Z=_C_Z+1
N70 IF (_JJ<>-1) GOTOF _MY1
n123 _TMP_1=SUBSTR(_TXI,_JJ+1,_IL-_JJ-1)
N75 IF (STRLEN(_TMP_1)==0) GOTOF _MY3
N80 _HT=_TMP_1 _TXI="" _CR=1
N85 GOTOF _MY2
N90 _MY3:_PROTVAL[_II+5]=_TXA
N95 GOTOB _NZEIL
N100 _MY1:
_HT=SUBSTR(_TXI,0,_JJ) _TXI=SUBSTR(_TXI,_JJ+1,_IL-_JJ-1)
_MY2:
N95 IF _PROTFORM[5]==0
N96 IF (_PROTFORM[5]==0)AND(_II==1)
IF _PROTVAL[0]==""
_PROTFORM[5]=12
CYCLE108(62308,0)
ENDIF
_SB=STRLEN(_HT)+1 _SP_B[_C_Z-1]=STRLEN(_HT)
ENDIF
ELSE
_SP_B[_C_Z-1]=_PROTFORM[5]
N98 ENDIF
N105 _HT2=toupper(_HT)
N110 IF (STRLEN(_HT)==1)AND(_HT==",") GOTOB _DEC1 IF SUBSTR(_HT2,0,5)=="_OVR[" GOTOF _POVR IF SUBSTR(_HT2,0,5)=="_TIME" GOTOF _PTIME IF SUBSTR(_HT2,0,5)=="_AXIS" GOTOF _PAXIS
N115 IF (SUBSTR(_HT2,0,1)=="R")AND(ISNUMBER(SUBSTR(_HT2,1,STRLEN(_HT2)-1))) GOTOF _PRP IF(SUBSTR(_HT2,0,5)=="_TXT[") GOTOF _PTXT
IF SUBSTR(_HT2,0,5)=="_OVI[" GOTOF _POVI
N120 GOTOF _PKT
N125 _POVR: _HT=SUBSTR(_HT,5,STRLEN(_HT)-5) _HT=SUBSTR(_HT,0,STRLEN(_HT)-1)
N130 IF ISNUMBER(_HT)==0 GOTOF _PF1
N135 _HI=NUMBER(_HT)
N140 CYCLE118 (_OVR[_HI],_DIGIT,_TMP_ST,0,0)
;N145 _HT=" "<<_TMP_ST _HT=SUBSTR(_HT,1,STRLEN(_HT)-1)
N146 CASE _OVI[9] OF 61303 GOTOF _AL61303 62303 GOTOF _AL61303 61304 GOTOF _AL61304 62304 GOTOF _AL61304 61305 GOTOF _AL61305 62305 GOTOF _AL61305 61306 GOTOF _AL61306 62306 GOTOF _AL61306 DEFAULT GOTOF _WX
_AL61303:_TOLPAR=_TSA
