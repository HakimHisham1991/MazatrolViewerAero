;Protokollieren_Ablaufsteuerung
N05 DEF BOOL _PK
N10 DEF INT _EC,_II,_HI,_LEN
N15 DEF STRING[200] _TX[4],_TXX
N20 DEF STRING[4] _HT
N25 DEF STRING[10] _DTT
