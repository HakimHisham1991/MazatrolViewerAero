N440 GOTOF _ECBH
N445 _E3:CYCLE108(61354)
N450 GOTOF _ECBH
N455 _E4:CYCLE108(61355)
N460 GOTOF _ECBH
N465 _E11:CYCLE108(61356)
N470 GOTOF _ECBH
N475 _E12:CYCLE108(61357)
N480 GOTOF _ECBH
N485 _E20:CYCLE108(61358)
N490 _ECBH:CYCLE108(61359)
N491 MSG()
N495 RET
N500 _E10:IF _PMI[3]>9 GOTOF _MY43
N505 IF _PMI[3]==1 GOTOF _EE10
N510 _PROTNAME[1]=SUBSTR(_PROTNAME[1],0,STRLEN(_PROTNAME[1])-2)
N515 _EE10:_PROTNAME[1]=_PROTNAME[1]<<"_"<<_PMI[3]
N520 _PMI[3]=_PMI[3]+1 _TXX="" _II=0
N40 WRITE(_EC,_PROTNAME[1],"x")
N12 IF (_EC<>0)AND(_EC<>10) GOTOB _ER
N525 DELETE(_EC,_PROTNAME[1])
