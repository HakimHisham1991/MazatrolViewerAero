ENDIF
IF _VB[1] ==0
N1010 G1 F=_M_SPE[1]
ENDIF
CASE (_MVAR DIV 10 MOD 10) OF 0 GOTOF _M0A DEFAULT GOTOF _FL1
_M0A:CASE (_MVAR MOD 10) OF 0 GOTOF _M02 1 GOTOF _M01 8 GOTOF _M0B DEFAULT GOTOF _FL1
