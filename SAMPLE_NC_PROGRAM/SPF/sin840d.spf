ENDIF
IF _AX_EX[2]
_DELTKOR[2]=_TMPFR[_ZZ,FI]-$AC_MEAS_FRAME[_ZZ,FI]
ENDIF
ELSE
IF _AX_EX[0]
_DELTKOR[0]=_TMPFR[_XX,TR]-$AC_MEAS_FRAME[_XX,TR]
ENDIF
IF _AX_EX[1]
_DELTKOR[1]=_TMPFR[_YY,TR]-$AC_MEAS_FRAME[_YY,TR]
ENDIF
IF _AX_EX[2]
_DELTKOR[2]=_TMPFR[_ZZ,TR]-$AC_MEAS_FRAME[_ZZ,TR]
ENDIF
ENDIF
_OVI[11]=-1
CASE(_RJUMP) OF 1 GOTOB _FRIN1 2 GOTOB _FRIN2 4 GOTOB _FRIN4 11 GOTOB _FRIN11 21 GOTOB _FRIN21 41 GOTOB _FRIN41 51 GOTOB _FRIN51 DEFAULT GOTOF _AL6
_FIN:
IF (_ADD==0)
G=52+_GH
IF _AX_EX[0]
_OVR[25]=$AA_IW[_XX]
ENDIF
IF _AX_EX[1]
_OVR[26]=$AA_IW[_YY]
ENDIF
IF _AX_EX[2]
_OVR[27]=$AA_IW[_ZZ]
ENDIF
IF _STYPE==2
_OVR[25]=$AA_MEAS_SETPOINT[_XX] _OVR[26]=$AA_MEAS_SETPOINT[_YY]
ELSE
_OVR[24+_MA]=$AA_MEAS_SETPOINT[_MAV]
ENDIF
G=52+_GHA
ENDIF
N700 _OVI[11]=1
$AC_MEAS_SEMA=0
RET
N820 _AL6: _ALARM=61321
N825 _OVI[11]=0
N826 $AC_MEAS_SEMA=0
N829 RET
N830 _AL10: _ALARM=61342
N835 _OVI[11]=0
N836 $AC_MEAS_SEMA=0
N839 RET
N840 _AL11: _ALARM=61403
N845 _OVI[11]=0
N846 $AC_MEAS_SEMA=0
N849 RET

%_N_CYCLE116_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE116 (VAR REAL _CAL[],VAR INT _ALARM)
;V06.02.08  Mar 21, 2002
;C06.02.03 Nov 07, 2001
;Kreismittelpunkt_Kreisradius
N20 DEF REAL _F_E3[3,2],_F_E4[4,2],_F_A[3]
N30 DEF BOOL _ERR
N45 IF((_CAL[0]<>3) AND (_CAL[0]<>4)) GOTOF _AL2
N40 _F_E3[0,0]=_CAL[1] _F_E3[0,1]=_CAL[2] _F_E3[1,0]=_CAL[3] _F_E3[1,1]=_CAL[4] _F_E3[2,0]=_CAL[5] _F_E3[2,1]=_CAL[6] _ERR=0
N50 IF _CAL[0]==3 GOTOF _MA1
N60 _F_E4[0,0]=_CAL[1] _F_E4[0,1]=_CAL[2] _F_E4[1,0]=_CAL[3] _F_E4[1,1]=_CAL[4] _F_E4[2,0]=_CAL[5] _F_E4[2,1]=_CAL[6] _F_E4[3,0]=_CAL[7] _F_E4[3,1]=_CAL[8]
N62 _ERR=CALCDAT(_F_E4,_CAL[0],_F_A)
N64 GOTOF _MA3
N70 _MA1: _ERR=1;CALCDAT(_F_E3,_CAL[0],_F_A)
CALCDAT(_F_E3,_CAL[0],_F_A)
N80 _MA3: IF (_ERR==0) GOTOF _AL1
N90 _CAL[9]=_F_A[0] _CAL[10]=_F_A[1] _CAL[11]=_F_A[2]
N100 RET
N110 _AL1: _ALARM=61316
N115 _CAL[12]=1
N120 RET
N130 _AL2: _ALARM=61317
N130 _CAL[12]=1
N150 RET

