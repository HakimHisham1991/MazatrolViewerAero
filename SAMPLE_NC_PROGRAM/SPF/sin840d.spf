%_N_CYCLE71_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE71(REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _PA,REAL _PO,REAL _LENG,REAL _WID,REAL _STA,REAL _MID,REAL _MIDA,REAL _FDP,REAL _FALD,REAL _FFP1,INT _VARI,REAL _FDP1) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 20, 2002
;Planfraesen
DEF AXIS _XX,_YY,_ZZ
DEF INT _BA1,_BA10,_HY,_HZ,_IY,_IZ,_PMX,_PMXX,_PMY
DEF REAL _APX,_APY,_AX1,_AX2,_AY,_DPA,_DPR,_DPZ,_FAK1,_HEY,_HEZ,_LX,_LX1,_LX2,_LY,_PMZ,_SDZ,_SKX,_SKY,_SKZ,_WZR,_WZX,_WZY,_XS,_YS
_SDIS=ABS(_SDIS) _MID=ABS(_MID) _FALD=ABS(_FALD) _MIDA=ABS(_MIDA) _FDP=ABS(_FDP) _VARI=ABS(_VARI) _FDP1=ABS(_FDP1)
_ZZ=$P_AXN3
IF $P_SIM==0 GOTOF _VS1
IF ($P_TOOL==0) AND (_MIDA==0) GOTOF _FEHL10
IF ($P_TOOLNO==0) AND (_MIDA==0) GOTOF _FEHL10
_VS1:
IF($P_TOOLNO==0) AND ($P_SIM==0) GOTOF _FEHL0
IF($P_TOOL==0) AND ($P_SIM==0) GOTOF _FEHL1
IF($P_TOOLR<=0) AND ($P_SIM==0) GOTOF _FEHL4
_BA1=_VARI MOD 10 _BA10=TRUNC(_VARI/10)
IF(_BA1<1) OR (_BA1>2) GOTOF _FEHL2
IF(_BA10<1) OR (_BA10>4) GOTOF _FEHL2
IF(_LENG==0) OR (_WID==0) GOTOF _FEHL5
IF(_FFP1<=0) GOTOF _FEHL8
IF($P_SIM==1) AND ($P_TOOL==0)
_BA1=2
MELDUNG(12)
ENDIF
_SKZ=$P_ACTFRAME[_ZZ,SC]
_SDIS=_SDIS/_SKZ _MID=_MID/_SKZ _FALD=_FALD/_SKZ
_DPR=ABS(_RFP-_DP)
_PMZ=_RTP-_RFP
IF(_RFP==_DP) GOTOF _RET
IF(_RTP==_RFP) GOTOF _M1
IF(_PMZ/ABS(_PMZ) <> (_RFP-_DP)/_DPR) GOTOF _FEHL3
_M1: _PMZ=(_RFP-_DP)/_DPR
IF(_RFP==_RTP)
_RTP=_RFP+_SDIS*_PMZ
ENDIF
IF(_LENG>0)
_PMX=1
ELSE
_PMX=-1
ENDIF
IF(_WID>0)
_PMY=1
ELSE
_PMY=-1
ENDIF
IF(_BA10==1) OR (_BA10==3)
_XX=$P_AXN1 _YY=$P_AXN2
_APX=_PA _APY=_PO _LX=_LENG _LY=_WID
_PMXX=_PMX
ELSE
_XX=$P_AXN2 _YY=$P_AXN1
_APX=_PO _APY=_PA _LX=_WID _LY=_LENG
_PMXX=_PMY _PMY=_PMX _PMX=_PMXX
ENDIF
_SKX=$P_ACTFRAME[_XX,SC] _SKY=$P_ACTFRAME[_YY,SC]
IF(_SKX<>_SKY)AND(_STA<>0) GOTOF _FEHL9
_FDP=_FDP/_SKX _FDP1=_FDP1/_SKY _MIDA=_MIDA/_SKY
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
_WZR=$P_TOOLR*_FAK1
_WZX=_WZR/_SKX _WZY=_WZR/_SKY
IF(_ZSD[1]==0)
_SDZ=_SDIS
ELSE
_SDZ=0
ENDIF
IF(_FALD>=_DPR)
_FALD=_DPR _DPA=_DPR
ELSE
_DPA=_DPR-_FALD
ENDIF
IF(_MID) GOTOF _M3
_MID=_SDZ+_DPA
_M3: _HZ=(_SDZ+_DPA)/_MID+0.4999
IF _HZ==0
_HZ=1
ENDIF
_HEZ=(_SDZ+_DPA)/_HZ
IF(_HZ==1)
_HEZ=_DPA
ENDIF
IF(_BA1==2)
_HEZ=_FALD _HZ=1
ENDIF
IF(_MIDA>2*_WZY) AND ($P_SIM==0) GOTOF _FEHL7
IF(_MIDA==0)
_MIDA=0.8*2*_WZY
ENDIF
IF(ABS(_LY+_FDP1)>_MIDA)
_HY=(ABS(_LY)-_MIDA+_FDP1)/_MIDA+0.4999
_HEY=(ABS(_LY)-_MIDA+_FDP1)/_HY
ELSE
_HY=0 _HEY=0
ENDIF
_XS=-(_FDP+_WZX)*_PMX _YS=(_MIDA-_WZY)*_PMY
_AX1=-(_FDP+_WZX)*_PMX
N10 ATRANS AX[_XX]=_APX AX[_YY]=_APY
N20 AROT RPL=_STA
N25 SBLON
IF($P_EP[_ZZ]*_FAK1<_RTP)
N30 G0 G40 G90 G60 AX[_ZZ]=_RTP
ENDIF
N40 G0 G40 G90 G60 AX[_XX]=_XS AX[_YY]=_YS
N50 AX[_ZZ]=_RFP+_SDIS*_PMZ
N55 SBLOF
FOR _IZ=1 TO _HZ
_AY=_YS _PMXX=_PMX
IF(_BA1==2)
_AX2=-_FDP*_PMX-_WZX*_PMX
_LX1=ABS(_LX)+2*(_FDP+_WZX)
_LX2=ABS(_LX)+2*(_FDP+_WZX)
ELSE
IF(_BA10==1) OR (_BA10==2)
_AX2=-(_FDP+_WZX)*_PMX
_LX1=ABS(_LX)+_FDP+_WZX
ELSE
IF(_MIDA>_WZY)
_LX1=ABS(_LX)+_FDP+_WZX
_LX2=ABS(_LX)
ELSE
_LX1=ABS(_LX)+_FDP-_MIDA*_SKY/_SKX+2*_WZX
_LX2=ABS(_LX)+2*(_WZX-_MIDA*_SKY/_SKX)
ENDIF
IF(_HY==0)
_LX1=ABS(_LX)+_FDP+_WZX _LX2=ABS(_LX)+_FDP+_WZX
ENDIF
ENDIF
ENDIF
_DPZ=_DP+(_DPR+_SDZ-_IZ*_HEZ)*_PMZ
IF(_HZ==1)
_DPZ=_DP+_FALD*_PMZ
ENDIF
IF(_BA1==2)
_DPZ=_DP
ENDIF
N58 SBLON
N60 G0 G90 AX[_XX]=_AX1 AX[_YY]=_AY
IF(_BA10==3) OR (_BA10==4) GOTOF _MB2
_MB1:
FOR _IY=1 TO _HY+1
N70 G90 AX[_ZZ]=_DPZ
N75 SBLOF
N80 G1 G91 AX[_XX]=_LX1*_PMX F=_FFP1
IF(_IY<=_HY)
IF((_VARI==12)OR(_VARI==22))AND(_FALD==0)
N90 G0 G90 AX[_ZZ]=_RFP+_SDIS*_PMZ
ELSE
N100 G0 G91 AX[_ZZ]=(_HEZ+_SDIS)*_PMZ
ENDIF
_AY=_YS+_HEY*_IY*_PMY
N110 G0 G90 AX[_XX]=_AX2 AX[_YY]=_AY
ENDIF
ENDFOR
GOTOF _MABH
_MB2:
N120 G90 AX[_ZZ]=_DPZ
N125 SBLOF
FOR _IY=1 TO _HY+1
N130 G1 G91 AX[_XX]=_LX1*_PMXX F=_FFP1
IF(_IY<=_HY)
_AY=_YS+_HEY*_IY*_PMY
IF(_BA1==2)
G00
ENDIF
N140 G90 AX[_YY]=_AY
_LX1=_LX2
_PMXX=-_PMXX
ENDIF
ENDFOR
_MABH:
IF(_IZ<_HZ)
N150 G0 G91 AX[_ZZ]=_SDIS*_PMZ
N155 SBLON
N160 G90 AX[_XX]=_AX1 AX[_YY]=_YS
N165 SBLOF
ENDIF
ENDFOR
_MRTP:
N165 SBLON
N170 G0 G90 AX[_ZZ]=_RTP
N175 SBLOF
GOTOF _RET
_FEHL0: STOPRE
SETAL(61009)
RET
_FEHL1: STOPRE
SETAL(61000)
RET
_FEHL2: STOPRE
SETAL(61002)
RET
_FEHL3: STOPRE
SETAL(61101)
RET
_FEHL4: STOPRE
SETAL(61117)
RET
_FEHL5: STOPRE
SETAL(61118)
RET
_FEHL7: STOPRE
SETAL(61111)
RET
_FEHL8: STOPRE
SETAL(61003)
RET
_FEHL9: STOPRE
SETAL(61012)
RET
_FEHL10: STOPRE
SETAL(61124)
RET
_RET: MSG("")
SBLON
RET

%_N_CYCLE72_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE72(STRING[140] _KNAME,REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _VARI,INT _RL,INT _AS1,REAL _LP1,REAL _FF3,INT _AS2,REAL _LP2) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.08 Dec 17, 2002
;Konturfraesen
N11 DEF AXIS _XX,_YY,_ZZ
N12 DEF INT _BA1,_BA10,_BA100,_HZ,_IZ
N13 DEF REAL _HEZ,_DIS1,_DIS2,_DPA,_DPR,_DPZ,_FAK1,_PMZ,_RDF,_RZP,_SDZ,_WEZ,_OFFN
N14 DEF BOOL _ZV[2], _SOWZ
N15 DEF STRING[32] _SLA,_SLE
N16 DEF STRING[80] _PNAME
N17 DEF INT II,IH1,IH2
_OFFN=$P_OFFN
IH2=STRLEN(_KNAME) IH1=0
FOR II=0 TO IH2
IF SUBSTR(_KNAME,II,1)==":"
IF IH1<>0
GOTOF _M5201
ENDIF
IH1=II
ENDIF
ENDFOR
_M5201:
IF IH1==0 GOTOF _M5202
IF (IH1<>0); AND (II==STRLEN(_KNAME))
_SLA=SUBSTR(_KNAME,0,IH1) _SLE=SUBSTR(_KNAME,IH1+1,IH2-IH1-1)
ELSE
_PNAME=SUBSTR(_KNAME,0,IH1)
_SLA=SUBSTR(_KNAME,IH1+1,II-IH1-1)
_SLE=SUBSTR(_KNAME,II+1,STRLEN(_KNAME)-II-1)
ENDIF
_M5202:
_SDIS=ABS(_SDIS) _MID=ABS(_MID) _FALD=ABS(_FALD) _RL=ABS(_RL) _AS1=ABS(_AS1) _AS2=ABS(_AS2) _LP1=ABS(_LP1) _LP2=ABS(_LP2) _VARI=ABS(_VARI)
_XX=$P_AXN1 _YY=$P_AXN2 _ZZ=$P_AXN3
IF($P_ACTFRAME[_ZZ,SC]<>1) GOTOF _FEHL10
IF($P_GG[13]==2)OR($P_GG[13]==4)
_RDF=0.001
ELSE
_RDF=0.0001
ENDIF
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
IF($P_TOOLNO==0) AND ($P_SIM==0) GOTOF _FEHL0
IF($P_TOOL==0) AND ($P_SIM==0) GOTOF _FEHL1
IF($P_TOOLR<0) GOTOF _FEHL9
IF($P_SIM==1) AND ($P_TOOL==0)
_SOWZ=TRUE
ELSE
_SOWZ=FALSE
ENDIF
_BA1=_VARI MOD 10 _BA10=TRUNC(_VARI/10) MOD 10 _BA100=TRUNC(_VARI/100)
IF(_BA1<1)OR(_BA1>2)OR(_BA100>3) GOTOF _FEHL2
IF(_RL<40) OR (_RL>42) GOTOF _FEHL4
IF($P_SIM==0) GOTOF _VS1
IF($P_TOOL==0)
T0
_BA1=2
MELDUNG(11)
ENDIF
_VS1:
IF(_AS1 MOD 10 <1)OR(_AS1 MOD 10 >3)OR(_AS2 MOD 10 >3) GOTOF _FEHL5
IF(_RL==40)AND(_AS1 MOD 10 >1) GOTOF _FEHL5
IF(TRUNC(_AS1/10)>1)OR(TRUNC(_AS2/10)>1)GOTOF _FEHL5
IF(_LP1==0) GOTOF _FEHL6
IF(_AS2==0)
_AS2=_AS1 _LP2=_LP1
ELSE
IF(_LP2==0) GOTOF _FEHL6
ENDIF
IF(_RL==40)AND(_AS2 MOD 10 >1) GOTOF _FEHL5
IF(_FFP1<=0) GOTOF _FEHL7
IF(_FFD<=0)
_FFD=_FFP1
ENDIF
_DPR=ABS(_RFP-_DP) _PMZ=_RTP-_RFP
IF(_RFP==_DP) GOTOF _RET
IF(_RTP==_RFP) GOTOF _M1
IF(_PMZ/ABS(_PMZ) <> (_RFP-_DP)/_DPR) GOTOF _FEHL3
_M1: _PMZ=(_RFP-_DP)/_DPR
IF(_RFP==_RTP)
_RTP=_RFP+_SDIS*_PMZ
ENDIF
IF(_RFP+_SDIS*_PMZ-_RTP >0) GOTOF _FEHL12
IF($P_EP[_ZZ]*_FAK1<_RTP)
N4 SBLON
N5 G0 G90 AX[_ZZ]=_RTP
N6 SBLOF
ENDIF
IF(_ZSD[1]==0)
_SDZ=_SDIS
ELSE
_SDZ=0
ENDIF
IF(_BA1==2)
_FALD=0 _FAL=0
ENDIF
IF(_FALD>=_DPR) GOTOF _FEHL8
_DPA=_DPR-_FALD
IF(_MID>=_DPA)OR(_MID==0)
_MID=_DPA+_SDZ
ENDIF
_HZ=(_DPA+_SDZ)/_MID+0.4999
_HEZ=(_DPA+_SDZ)/_HZ
_ZV[1]=0
IF((_ZSD[3])AND($P_GG[15]==3))OR((_ZSD[3]==0)AND($P_GG[15]==2))
_ZV[1]=1
ENDIF
FOR _IZ=1 TO _HZ
IF _SOWZ==TRUE
_IZ=_HZ
ENDIF
IF(_BA10==0)
N10 G0 G90 G64
ELSE
IF(_FF3==0)
_FF3=_FFP1
ENDIF
N15 G1 G90 G64 F=_FF3
ENDIF
_DPZ=_DP+(_DPR+_SDZ-_IZ*_HEZ)*_PMZ
_DIS1=(_HEZ+_SDIS)*_PMZ
IF(_BA100==3) AND (_IZ>1)
_DIS1=_HEZ*_PMZ
ENDIF
IF(_BA1==1) AND (_RL<>40)
CFTCP
ENDIF
IF(_RL==40)
N18 G140 G40
GOTOF _MAN
ELSE
IF(_BA1==1)
N19 OFFN=_OFFN+_FAL
ENDIF
IF(_RL==41)
N20 G140 G41 NORM
ELSE
N30 G140 G42 NORM
ENDIF
ENDIF
_MAN:
N32 SBLON
IF(_ZV[1]==0) GOTOF _MMU
IF(_AS1==1)
N35 G341 G147 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==11)
N40 G340 G147 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==2)
N45 G341 G247 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==12)
N50 G340 G247 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==3)
N55 G341 G347 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
IF(_AS1==13)
N60 G340 G347 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=PM(_FFD)
ENDIF
GOTOF _MKON
_MMU:
IF(_AS1==1)
N65 G341 G147 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=_FFD;;;PR(_FFD)
ENDIF
IF(_AS1==11)
N70 G340 G147 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=_FFD;;;PR(_FFD)
ENDIF
IF(_AS1==2)
N75 G341 G247 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=_FFD;;;PR(_FFD)
ENDIF
IF(_AS1==12)
N80 G340 G247 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=_FFD;;;PR(_FFD)
ENDIF
IF(_AS1==3)
N85 G341 G347 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=_FFD;;;PR(_FFD)
ENDIF
IF(_AS1==13)
N90 G340 G347 AX[_ZZ]=_DPZ DISR=_LP1 DISCL=_DIS1 F=_FFP1 FAD=_FFD;;;PR(_FFD)
ENDIF
_MKON:
N34 SBLOF
IF ((_PNAME=="") AND (_SLA=="") AND (_SLE==""))
N70 CALL _KNAME
ELSE
IF (_PNAME=="")
;N71 CALL $P_PROG[$P_STACK-1] BLOCK _SLA TO _SLE
N71 REPEAT _SLA  _SLE
ELSE
N72 CALL _PNAME BLOCK _SLA TO _SLE
ENDIF
ENDIF
IF(_BA100==0)
_WEZ=_RTP
IF(_AS2<10)
_DIS2=_RDF*_PMZ
ELSE
_DIS2=(_HEZ+_SDIS)*_PMZ
ENDIF
ENDIF
IF(_BA100==1)
_WEZ=_RFP+_SDIS*_PMZ+_RDF*_PMZ
IF(_AS2<10)
_DIS2=_RDF*_PMZ
ELSE
_DIS2=(_HEZ+_SDIS)*_PMZ
ENDIF
ENDIF
IF(_BA100==2)
_WEZ=_DPZ+_SDIS*_PMZ+_RDF*_PMZ _DIS2=_SDIS*_PMZ
ENDIF
IF(_BA100==3)
_WEZ=_DPZ+_RDF*_PMZ _DIS2=0
ENDIF
N94 SBLON
IF(_BA10==0)AND(_BA100<>3)
N95 G00
IF(_AS2==1)
N100 G341 G148 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==11)
N105 G340 G148 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==2)
N110 G341 G248 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==12)
N115 G340 G248 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==3)
N120 G341 G348 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
IF(_AS2==13)
N125 G340 G348 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 FAD=$P_F
ENDIF
ELSE
N140 G01
IF(_BA100==3)
N145 _FF3=_FFP1
ENDIF
IF(_AS2==1)
N150 G341 G148 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==11)
N155 G340 G148 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==2)
N160 G341 G248 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==12)
N165 G340 G248 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==3)
N170 G341 G348 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
IF(_AS2==13)
N175 G340 G348 G90 G40 AX[_ZZ]=_WEZ DISR=_LP2 DISCL=_DIS2 F=_FF3 FAD=$P_F
ENDIF
ENDIF
N176 SBLOF
ENDFOR
N198 SBLON
N200 G0 AX[_ZZ]=_RTP
N210 AX[_XX]=$P_EP[_XX]*_FAK1 AX[_YY]=$P_EP[_YY]*_FAK1
N212 SBLOF
GOTOF _RET
_FEHL0: STOPRE
SETAL(61009)
RET
_FEHL1: STOPRE
SETAL(61000)
RET
_FEHL2: STOPRE
SETAL(61002)
RET
_FEHL3: STOPRE
SETAL(61101)
RET
_FEHL4: STOPRE
SETAL(61114)
RET
_FEHL5: STOPRE
SETAL(61115)
RET
_FEHL6: STOPRE
SETAL(61116)
RET
_FEHL7: STOPRE
SETAL(61003)
RET
_FEHL8: STOPRE
SETAL(61010)
RET
_FEHL9: STOPRE
SETAL(61112)
RET
_FEHL10: STOPRE
SETAL(61011)
RET
_FEHL12: STOPRE
SETAL(61014)
RET
_RET: OFFN=_OFFN
SBLON
RET
;Begin add CGTech (Need to fix CALL "<Subroutine>" BLOCK <Label> TO <Label>)
_E_SP_REC_ANF:
IF(_CONT2[7]==2)
N100 G1 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
IF(_CONT2[6]>0)
N105 AX[$P_AXN2]=-_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N110 G2 AX[$P_AXN1]=_CONT2[5] AX[$P_AXN2]=-_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N115 G1 AX[$P_AXN1]=-_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N120 G2 AX[$P_AXN1]=-_CONT2[2] AX[$P_AXN2]=-_CONT2[6] CR=_CONT2[4]
ENDIF
IF(_CONT2[6]>0)
N130 G1 AX[$P_AXN2]=_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N135 G2 AX[$P_AXN1]=-_CONT2[5] AX[$P_AXN2]=_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N140 G1 AX[$P_AXN1]=_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N145 G2 AX[$P_AXN1]=_CONT2[2] AX[$P_AXN2]=_CONT2[6] CR=_CONT2[4]
ENDIF
N150 G1 AX[$P_AXN2]=_CONT2[1]
ELSE
N200 G1 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
IF(_CONT2[6]>0)
N205 AX[$P_AXN2]=_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N210 G3 AX[$P_AXN1]=_CONT2[5] AX[$P_AXN2]=_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N215 G1 AX[$P_AXN1]=-_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N220 G3 AX[$P_AXN1]=-_CONT2[2] AX[$P_AXN2]=_CONT2[6] CR=_CONT2[4]
ENDIF
IF(_CONT2[6]>0)
N230 G1 AX[$P_AXN2]=-_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N235 G3 AX[$P_AXN1]=-_CONT2[5] AX[$P_AXN2]=-_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N240 G1 AX[$P_AXN1]=_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N245 G3 AX[$P_AXN1]=_CONT2[2] AX[$P_AXN2]=-_CONT2[6] CR=_CONT2[4]
ENDIF
N250 G1 AX[$P_AXN2]=_CONT2[1]
ENDIF
_E_SP_REC_END:
_E_SP_CIR_ANF:
IF(_CONT2[4]==2)
N20 G01 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
N22 G02 IP[$P_AXN1]=AC(_CONT2[2]) IP[$P_AXN2]=AC(_CONT2[3])
ELSE
N30 G01 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
N32 G03 IP[$P_AXN1]=AC(_CONT2[2]) IP[$P_AXN2]=AC(_CONT2[3])
ENDIF
_E_SP_CIR_END:
;End add CGTech
RET

%_N_CYCLE76_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE76(REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _DPR,REAL _LENG,REAL _WID,REAL _CRAD,REAL _PA,REAL _PO,REAL _STA,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _CDIR,INT _VARI,REAL _AP1,REAL _AP2) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.02.07 Nov 27, 2001
;Rechteckzapfen
DEF STRING[70] _KNAME
DEF AXIS _XX,_YY,_ZZ
DEF INT _AS1,_AS2,_BA1,_DIR,_FRK,_M3_5,_PMZ,_INI=1,_ZSD3
DEF REAL _FAK1,_FAK2,_LP1,_LP2,_RP,_SC,_SD,_SD1,_SD2,_TX,_TY,_XREF,_YREF
DEF REAL _ZREF
DEF REAL _MIRR=0
_XX=$P_AXN1 _YY=$P_AXN2 _ZZ=$P_AXN3
IF(_DPR>0)
_DP=_RFP-_DPR
ENDIF
_MIRR=$P_ACTFRAME[_XX,MI]+$P_ACTFRAME[_YY,MI]
IF(_MIRR==1)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF(_RFP<_DP)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_ACTFRAME[_ZZ,MI])
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_TOOLR<0) GOTOF _FEHL5
_BA1=0
IF(_VARI B_AND 1)
_BA1=1
ENDIF
IF(_VARI B_AND 2)
_BA1=_BA1+2
ENDIF
IF(_BA1<1)OR(_BA1>2) GOTOF _FEHL1
IF(_BA1==1)AND(_MID<0) GOTOF _FEHL6
_VARI=_BA1+300
_M3_5=$P_SDIR[$P_MSNUM]
IF(_CDIR==0)
IF(_M3_5==4)
_DIR=3 _FRK=42
ELSE
_DIR=2 _FRK=41
ENDIF
ENDIF
IF(_CDIR==1)
IF(_M3_5==4)
_DIR=2 _FRK=41
ELSE
_DIR=3 _FRK=42
ENDIF
ENDIF
IF(_CDIR==2)
_DIR=2 _FRK=41
ENDIF
IF(_CDIR==3)
_DIR=3 _FRK=42
ENDIF
IF _ZSD[2]==1
_TX=_LENG/2 _TY=_WID/2
ELSE
_TX=0 _TY=0
ENDIF
_LENG=ABS(_LENG) _WID=ABS(_WID)
_AS1=3 _AS2=3
IF(_BA1==1)
_LP1=((_AP1-_LENG)/2-_FAL+_SDIS)/2
ELSE
_LP1=(_FAL+_SDIS)/2
ENDIF
_LP2=_LP1
_KNAME="_E_SP_REC_ANF:_E_SP_REC_END"
IF _BA1==1
_CONT2[0]=_LENG/2+_FAL _CONT2[1]=0
_CONT2[2]=_LENG/2+_FAL _CONT2[3]=_WID/2+_FAL
_CONT2[4]=_CRAD+_FAL
_FAL=0
ELSE
_CONT2[0]=_LENG/2 _CONT2[1]=0
_CONT2[2]=_LENG/2 _CONT2[3]=_WID/2
_CONT2[4]=_CRAD
ENDIF
_CONT2[5]=_LENG/2-_CRAD _CONT2[6]=_WID/2-_CRAD
_CONT2[7]=_DIR
ATRANS AX[_XX]=_PA AX[_YY]=_PO
AROT RPL=_STA
ATRANS AX[_XX]=_TX AX[_YY]=_TY
N30 CYCLE72(_KNAME,_RTP,_RFP,_SDIS,_DP,_MID,_FAL,_FALD,_FFP1,_FFD,_VARI,_FRK,_AS1,_LP1,_FFD,_AS2,_LP2)
ATRANS AX[_XX]=-_TX AX[_YY]=-_TY
AROT RPL=-_STA
ATRANS AX[_XX]=-_PA AX[_YY]=-_PO
_RET:
RET
_FEHL1: STOPRE
SETAL(61002)
RET
_FEHL5: STOPRE
SETAL(61112)
RET
_FEHL6: STOPRE
SETAL(61610)
RET
_E_SP_REC_ANF:
IF(_CONT2[7]==2)
N100 G1 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
IF(_CONT2[6]>0)
N105 AX[$P_AXN2]=-_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N110 G2 AX[$P_AXN1]=_CONT2[5] AX[$P_AXN2]=-_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N115 G1 AX[$P_AXN1]=-_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N120 G2 AX[$P_AXN1]=-_CONT2[2] AX[$P_AXN2]=-_CONT2[6] CR=_CONT2[4]
ENDIF
IF(_CONT2[6]>0)
N130 G1 AX[$P_AXN2]=_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N135 G2 AX[$P_AXN1]=-_CONT2[5] AX[$P_AXN2]=_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N140 G1 AX[$P_AXN1]=_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N145 G2 AX[$P_AXN1]=_CONT2[2] AX[$P_AXN2]=_CONT2[6] CR=_CONT2[4]
ENDIF
N150 G1 AX[$P_AXN2]=_CONT2[1]
ELSE
N200 G1 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
IF(_CONT2[6]>0)
N205 AX[$P_AXN2]=_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N210 G3 AX[$P_AXN1]=_CONT2[5] AX[$P_AXN2]=_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N215 G1 AX[$P_AXN1]=-_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N220 G3 AX[$P_AXN1]=-_CONT2[2] AX[$P_AXN2]=_CONT2[6] CR=_CONT2[4]
ENDIF
IF(_CONT2[6]>0)
N230 G1 AX[$P_AXN2]=-_CONT2[6]
ENDIF
IF(_CONT2[4]>0)
N235 G3 AX[$P_AXN1]=-_CONT2[5] AX[$P_AXN2]=-_CONT2[3] CR=_CONT2[4]
ENDIF
IF(_CONT2[5]>0)
N240 G1 AX[$P_AXN1]=_CONT2[5]
ENDIF
IF(_CONT2[4]>0)
N245 G3 AX[$P_AXN1]=_CONT2[2] AX[$P_AXN2]=-_CONT2[6] CR=_CONT2[4]
ENDIF
N250 G1 AX[$P_AXN2]=_CONT2[1]
ENDIF
_E_SP_REC_END:
RET

%_N_CYCLE77_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE77(REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _DPR,REAL _PRAD,REAL _PA,REAL _PO,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _CDIR,INT _VARI,REAL _AP1) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.02.07 Nov 27, 2001
;Kreiszapfen
DEF STRING[70] _KNAME
DEF AXIS _XX,_YY,_ZZ
DEF INT _M3_5,_FRK,_AS1,_AS2,_BA1,_DIR,_PMZ,_INI=1,_ZSD3
DEF REAL _LP1,_LP2,_A0=0
DEF REAL _X0,_Y0
DEF REAL _MIRR=0
_XX=$P_AXN1 _YY=$P_AXN2 _ZZ=$P_AXN3
_X0=_PA
_Y0=_PO
IF(_DPR>0)
_DP=_RFP-_DPR
ENDIF
_MIRR=$P_ACTFRAME[_XX,MI]+$P_ACTFRAME[_YY,MI]
IF(_MIRR==1)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF(_RFP<_DP)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_ACTFRAME[_ZZ,MI])
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF(_PRAD<=0)OR(_AP1<0) GOTOF _FEHL3
IF((_AP1<>0) AND (_AP1<_PRAD)) GOTOF _FEHL4
IF($P_TOOLR<0) GOTOF _FEHL5
_BA1=0
IF(_VARI B_AND 1)
_BA1=1
ENDIF
IF(_VARI B_AND 2)
_BA1=_BA1+2
ENDIF
IF(_BA1<1)OR(_BA1>2) GOTOF _FEHL1
IF(_BA1==1)AND(_MID<0) GOTOF _FEHL6
_VARI=_BA1+300
_M3_5=$P_SDIR[$P_MSNUM]
IF(_CDIR==0)
IF(_M3_5==4)
_DIR=3 _FRK=42
ELSE
_DIR=2 _FRK=41
ENDIF
ENDIF
IF(_CDIR==1)
IF(_M3_5==4)
_DIR=2 _FRK=41
ELSE
_DIR=3 _FRK=42
ENDIF
ENDIF
IF(_CDIR==2)
_DIR=2 _FRK=41
ENDIF
IF(_CDIR==3)
_DIR=3 _FRK=42
ENDIF
_AS1=3 _AS2=3
IF(_BA1==1)
_LP1=((_AP1-_PRAD)/2-_FAL+_SDIS)/2
ELSE
_LP1=(_FAL+_SDIS)/2
ENDIF
_LP2=_LP1
IF _BA1==1
_PA=_PA+COS(_A0)*(_PRAD/2+_FAL) _PO=_PO+SIN(_A0)*(_PRAD/2+_FAL)
_FAL=0
ELSE
_PA=_PA+COS(_A0)*_PRAD/2 _PO=_PO+SIN(_A0)*_PRAD/2
ENDIF
_KNAME="_E_SP_CIR_ANF:_E_SP_CIR_END"
_CONT2[0]=_PA _CONT2[1]=_PO _CONT2[2]=_X0 _CONT2[3]=_Y0
_CONT2[4]=_DIR
N30 CYCLE72(_KNAME,_RTP,_RFP,_SDIS,_DP,_MID,_FAL,_FALD,_FFP1,_FFD,_VARI,_FRK,_AS1,_LP1,_FFD,_AS2,_LP2)
_RET:
RET
_FEHL1: STOPRE
SETAL(61002)
RET
_FEHL3: STOPRE
SETAL(61213)
RET
_FEHL4: STOPRE
SETAL(61215)
RET
_FEHL5: STOPRE
SETAL(61112)
RET
_FEHL6: STOPRE
SETAL(61610)
RET
_E_SP_CIR_ANF:
IF(_CONT2[4]==2)
N20 G01 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
N22 G02 IP[$P_AXN1]=AC(_CONT2[2]) IP[$P_AXN2]=AC(_CONT2[3])
ELSE
N30 G01 G90 AX[$P_AXN1]=_CONT2[0] AX[$P_AXN2]=_CONT2[1]
N32 G03 IP[$P_AXN1]=AC(_CONT2[2]) IP[$P_AXN2]=AC(_CONT2[3])
ENDIF
_E_SP_CIR_END:
RET


%_N_CYCLE81_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE81(REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 17, 2002
;Bohren, Zentrieren
DEF AXIS _Z
DEF REAL HH2
DEF INT HH7
IF HH7 GOTOF _MM1B
_Z=$P_AXN3 DPR=ABS(DPR) SDIS=ABS(SDIS)
IF DPR ==0 GOTOF _MM1
IF RTP == RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MELDUNG(1)
N1 _MM0: DP=HH2
_MM1:HH2=RTP-RFP
IF RFP==DP GOTOF _MM2
IF HH2 ==0 GOTOF _MM1A IF HH2/ABS(HH2) <> (RFP-DP)/ABS(RFP-DP) GOTOF FEHL1
_MM1A:HH7=1
_MM1B:
SBLON
AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP) G0 G64 G90
SBLOF
N2 G1 G60 AX[_Z]=DP
SBLON
N3 G0 G64 AX[_Z]=RTP
SBLOF
_MM2:MSG("")
RET
N20 FEHL1:STOPRE
SETAL(61101)
RET

%_N_CYCLE82_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE82 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DTB) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.02.04 Jul 23, 2001
;Bohren, Plansenken
DEF AXIS _Z
DEF REAL HH2
DEF INT HH7
IF HH7 GOTOF _MM1B
_Z=$P_AXN3 DPR=ABS(DPR) SDIS=ABS(SDIS)
IF DPR==0 GOTOF _MM1
IF RTP== RFP GOTOF FEHL1
HH2=RFP-(RTP-RFP)/ABS(RTP-RFP)*DPR
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MELDUNG(1)
N1 _MM0: DP=HH2
_MM1:HH2=RTP-RFP
IF RFP==DP GOTOF _MM2
IF HH2==0 GOTOF _MM1A IF HH2/ABS(HH2) <> (RFP-DP)/ABS(RFP-DP) GOTOF FEHL1
_MM1A:HH7=1
_MM1B:
SBLON
N11 G0 G64 G90 AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP)
SBLOF
N2 G1 AX[_Z]=DP
IF(DTB>=0)
N3 G4 F=DTB
ELSE
N3 G4 S=-DTB
ENDIF
SBLON
N4 G0 AX[_Z]=RTP
SBLOF
_MM2:MSG("")
RET
FEHL1:STOPRE
SETAL(61101)
RET

%_N_CYCLE83_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE83(REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL FDEP,REAL FDPR,REAL DAM,REAL DTB,REAL DTS,REAL FRF,INT VARI,INT _AXN,REAL _MDEP,REAL _VRT,REAL _DTD,REAL _DIS1) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 19, 2002
;Tieflochbohren
DEF AXIS _Z
DEF REAL FAK,HH1,HH2,HH3,HH4,HH5,HH8,_HH9,VHA,_HMF,HZ,_FAK1
DEF INT HH6,HH7
DEF INT _ABS,_ORD,_APP
_ABS=1 _ORD=2 _APP=3
IF $P_GG[6]==2
_ABS=3 _ORD=1 _APP=2
ENDIF
IF $P_GG[6]==3
_ABS=2 _ORD=3 _APP=1
ENDIF
HH2=FDEP HH3=FRF HH4=$P_F HH6=0 FAK=1 HZ=1
IF($P_GG[13]==1)OR($P_GG[13]==3)
FAK=$MN_SCALING_VALUE_INCH
ENDIF
CASE _AXN OF 1 GOTOF _AX1 2 GOTOF _AX2 DEFAULT GOTOF _AX3
_AX1:
IF ISAXIS(_ABS)
_Z=$P_AXN1
GOTOF _AX
ELSE
GOTOF _FEHL3
ENDIF
_AX2:
IF ISAXIS(_ORD)
_Z=$P_AXN2
GOTOF _AX
ELSE
GOTOF _FEHL3
ENDIF
_AX3:
IF ISAXIS(_APP)
_Z=$P_AXN3
ELSE
GOTOF _FEHL3
ENDIF
_AX:
FRF=ABS(FRF) FDPR=ABS(FDPR) DPR=ABS(DPR) SDIS=ABS(SDIS)
_HMF=$P_ACTFRAME[_Z,SC]
IF(DPR==0)GOTOF _MA1
IF(RTP==RFP)GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF(DP==0)GOTOF _MA0
IF(DP==HH2)GOTOF _MA1
N10 MELDUNG(1)
_MA0:DP=HH2
_MA1:IF(RFP==DP)GOTOF _MAE
HH1=(RFP-DP)/ABS(RFP-DP)
IF(FRF<=1)AND(FRF>0.001)GOTOF _MA3
IF(FRF<0.001)GOTOF _MA2
FRF=1
GOTOF _MA3
_MA2:FRF=0.001
_MA3:
IF(FDPR==0)GOTOF _MA4A
HH2=RFP-HH1*FDPR
IF(FDEP==0)GOTOF _MA4
IF(FDEP==HH2)GOTOF _MA4A
N15 MELDUNG(8)
_MA4:FDEP=HH2
_MA4A:FDPR=ABS(RFP-FDEP)
IF(FDPR==0)GOTOF _MM4B
HH2=(RFP-FDEP)/FDPR
IF(HH2<>HH1)GOTOF FEHL2
_MM4B:HH2=FDEP
IF((HH2-DP)*HH1<0)
HH2=DP
FDEP=DP
FDPR=ABS(RFP-DP)
ENDIF
_HH9=FDPR
IF(_DTD==0)
_DTD=DTB
ENDIF
IF(VARI==0)
IF(_VRT<=0)
_VRT=HZ/FAK
ENDIF
ENDIF
FDEP=RFP*_HMF-FDPR*HH1 HH2=FDEP
HH7=1
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
_MA5:
IF(RFP+SDIS*HH1/_HMF<>$P_EP[_Z]*_FAK1)
SBLON
N1 G0 G64 G90 AX[_Z]=RFP+SDIS*HH1/_HMF
SBLOF
ENDIF
HH8=FDPR
N2 _MA5A:G90 G1 F=HH3*HH4 AX[_Z]=HH2/_HMF
HH3=1
IF(NOT $P_ISTEST) AND (NOT $P_DRYRUN)
IF(HH2<>DP*_HMF)
IF(DTB>=0)
N5 G4 F=DTB
ELSE
N5 G4 S=-DTB
ENDIF
ELSE
IF(_DTD>=0)
N5 G4 F=_DTD
ELSE
N5 G4 S=-_DTD
ENDIF
ENDIF
ENDIF
IF(HH2==DP*_HMF)GOTOF _MA8
IF(DAM==0)
DAM=-1
_MDEP=FDPR
ENDIF
IF(DAM>0)GOTOF _MMD
HH8=-HH8*DAM
IF(HH8>=_MDEP)GOTOF _MMD1
HH8=_MDEP
_MMD1:
HH5=HH2-HH1*HH8
IF((HH5-DP*_HMF)*HH1>=0)GOTOF _MMD2
HH5=DP*_HMF
GOTOF _MA6
_MMD2:
IF((HH5-DP*_HMF)*HH1>=_MDEP)GOTOF _MA6
HH5=HH2-(HH2-DP*_HMF)/2
GOTOF _MA6
_MMD:
_HH9=_HH9-DAM
IF(_HH9<DAM)
_HH9=DAM
ENDIF
IF(ABS(HH2-DP*_HMF)-_HH9>=DAM)
IF(ABS(HH2-DP*_HMF)>2*DAM)
HH5=HH2-_HH9*HH1
ELSE
IF(ABS(HH2-DP*_HMF)>DAM)
HH5=HH2-ABS(HH2-DP*_HMF)/2*HH1
ELSE
HH5=DP*_HMF
ENDIF
ENDIF
ELSE
IF(ABS(HH2-DP*_HMF)>_HH9)
IF(ABS(HH2-DP*_HMF)>2*DAM)
HH5=DP*_HMF+DAM*HH1
ELSE
HH5=HH2-ABS(HH2-DP*_HMF)/2*HH1
ENDIF
ELSE
HH5=DP*_HMF
ENDIF
ENDIF
_MA6:IF(VARI<>1)GOTOF _MA_SPB
SBLON
N4 G90 G0 AX[_Z]=RFP+SDIS*HH1/_HMF
SBLOF
IF(NOT $P_ISTEST) AND (NOT $P_DRYRUN)
IF(DTS>=0)
N5 G4 F=DTS
ELSE
N5 G4 S=-DTS
ENDIF
ENDIF
IF(ABS(RFP*_HMF-HH2)*FAK<=30)
VHA=0.6
ELSE
VHA=ABS(RFP*_HMF-HH2)*FAK/50
IF(VHA>7)
VHA=7
ENDIF
ENDIF
VHA=VHA/FAK
IF (_DIS1>0)
VHA=_DIS1
ENDIF
N6 G90 AX[_Z]=HH2/_HMF+VHA*HH1/_HMF
GOTOF _MA7
_MA_SPB:
IF(VARI==0)
IF (_VRT>0)
N7 G0 G91 AX[_Z]=HH1*_VRT/_HMF
ELSE
N7 G0 G91 AX[_Z]=HH1*HZ/FAK/_HMF
ENDIF
ENDIF
N70 G1
_MA7:HH2=HH5
GOTOB _MA5A
_MA8:
SBLON
N8 G0 G90 AX[_Z]=RTP
N80 F=HH4
SBLOF
_MAE:MSG("")
RET
FEHL1: SETAL(61101)
RET
FEHL2: SETAL(61107)
RET
_FEHL3: SETAL(61803)
RET

%_N_CYCLE84_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE84(REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DTB,INT SDAC,REAL MPIT,REAL PIT,REAL POSS,REAL SST,REAL SST1,INT _AXN,INT _PTAB,INT _TECHNO,INT _VARI,REAL _DAM,REAL _VRT) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 19, 2002
;Gewindebohren ohne Ausgleichsfutter mit G331/G332
DEF AXIS _Z
DEF REAL PP,HH1,HH2,HH3,HH4,HH5,_HH9,HH11,VHA,HZ,FAK,_FAK1,_HMF
DEF INT HH7,_TECNO[5],_OLD12,_OLD21,_OLD24,SPINU,_ISO
DEF INT _ABS,_ORD,_APP
DEF INT _DRY_STAT=1
IF HH7>0 GOTOF _MA3
_TECNO[0]=_TECHNO MOD 10 _TECNO[1]=TRUNC(_TECHNO/10) MOD 10 _TECNO[2]=TRUNC(_TECHNO/100) MOD 10 _TECNO[3]=TRUNC(_TECHNO/1000) MOD 10
_TECNO[4]=TRUNC(_TECHNO/10000) MOD 10
IF(_TECNO[0]<0)OR(_TECNO[0]>3)OR(_TECNO[1]<0)OR(_TECNO[1]>2)OR(_TECNO[2]<0)OR(_TECNO[2]>3)OR(_TECNO[3]<0)OR(_TECNO[3]>1)GOTOF _FEHL4
IF(_TECNO[4]<0)OR(_TECNO[4]>1)GOTOF _FEHL4
_ABS=1 _ORD=2 _APP=3
IF $P_GG[6]==2
_ABS=3 _ORD=1 _APP=2
ENDIF
IF $P_GG[6]==3
_ABS=2 _ORD=3 _APP=1
ENDIF
CASE _AXN OF 1 GOTOF _AX1 2 GOTOF _AX2 DEFAULT GOTOF _AX3
_AX1:
IF ISAXIS(_ABS)
_Z=$P_AXN1
GOTOF _AX
ELSE
GOTOF _FEHL5
ENDIF
_AX2:
IF ISAXIS(_ORD)
_Z=$P_AXN2
GOTOF _AX
ELSE
GOTOF _FEHL5
ENDIF
_AX3:
IF ISAXIS(_APP)
_Z=$P_AXN3
ELSE
GOTOF _FEHL5
ENDIF
_AX:
IF ( ($AN_NCK_VERSION<430100) AND ($P_DRYRUN) )
_DRY_STAT=0
ENDIF
SPINU=$P_MSNUM
IF (($AN_NCK_VERSION < 450000) OR ($P_SIM)) GOTOF _M6201
IF _TECNO[4]==0
IF $MA_PARAMSET_CHANGE_ENABLE[_Z]==2
IF ($MA_DRIVE_AX_RATIO_DENOM[($AA_SCPAR[_Z]-1),_Z] <> $MA_DRIVE_AX_RATIO_DENOM[1,_Z]) GOTOF _FEHL7
IF ($MA_DRIVE_AX_RATIO_NUMERA[($AA_SCPAR[_Z]-1),_Z] <> $MA_DRIVE_AX_RATIO_NUMERA[1,_Z]) GOTOF _FEHL7
ELSE
IF ($MA_DRIVE_AX_RATIO_DENOM[$AC_SGEAR[SPINU],_Z] <> $MA_DRIVE_AX_RATIO_DENOM[1,_Z]) GOTOF _FEHL7
IF ($MA_DRIVE_AX_RATIO_NUMERA[$AC_SGEAR[SPINU],_Z] <> $MA_DRIVE_AX_RATIO_NUMERA[1,_Z]) GOTOF _FEHL7
ENDIF
ENDIF
_M6201:
_HMF=$P_ACTFRAME[_Z,SC]
_ISO=_VARI DIV 1000
IF _ISO>1 GOTOF _FEHL3
_VARI=_VARI MOD 10
IF(_VARI<0)OR(_VARI>2) GOTOF _FEHL3
IF(_VRT<=0)
_VRT=1
IF($P_GG[13]==1)OR($P_GG[13]==3)
_VRT=1/$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
DPR=ABS(DPR) _DAM=ABS(_DAM) SDIS=ABS(SDIS) HH3=$P_S[0] HH4=$P_F
IF DPR==0 GOTOF _MD1 IF RTP==RFP GOTOF _FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MB1 IF DP==HH2 GOTOF _MD1
N1 MELDUNG(1)
_MB1:DP=HH2
_MD1:HH7=1 HH2=RTP-RFP
IF(_DAM==0)
_DAM=ABS(DP)
ENDIF
IF RFP==DP GOTOF _MX3 IF HH2==0 GOTOF _MA2 IF HH2/ABS(HH2)<>(RFP-DP)/ABS(RFP-DP) GOTOF _FEHL1
HH1=SDIS*(RFP-DP)/ABS(RFP-DP)
HH11=(RFP-DP)/ABS(RFP-DP)
_MA2:
CASE _PTAB OF 0 GOTOF _P0TAB 1 GOTOF _P1TAB 2 GOTOF _P2TAB 3 GOTOF _P3TAB DEFAULT GOTOF _FEHL2
_P0TAB:IF (PIT==0) AND (MPIT==0) GOTOF _FEHL2
PP=PIT
IF MPIT<>0
IF (ABS(MPIT)<3)OR(ABS(MPIT)>48) GOTOF _FEHL2
N2 STEIGUNG(PP,ABS(MPIT))
PP=PP*MPIT/ABS(MPIT)
IF (PP<>PIT)AND(PIT<>0) GOTOF _FEHL2
ENDIF
GOTOF _ENDTAB
_P1TAB:IF (PIT==0) GOTOF _FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=PIT/$MN_SCALING_VALUE_INCH
ELSE
PP=PIT
ENDIF
GOTOF _ENDTAB
_P2TAB:IF (PIT==0) GOTOF _FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=1/PIT
ELSE
PP=$MN_SCALING_VALUE_INCH/PIT
ENDIF
GOTOF _ENDTAB
_P3TAB:IF (PIT==0) GOTOF _FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=PIT
ELSE
PP=$MN_SCALING_VALUE_INCH*PIT
ENDIF
_ENDTAB:
IF (SDAC<6)AND(SDAC>2) GOTOF _MD2
SDAC=5
_MD2:IF SST1>0 GOTOF _MA3A
SST1=SST
_MA3A:
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
_MA3:
HH2=RFP+HH1
IF(HH2<>$P_EP[_Z]*_FAK1)
SBLON
N20 G0 G9 G90 AX[_Z]=RFP+HH1/_HMF
SBLOF
ENDIF
IF $P_SMODE[$P_MSNUM]<>2
N29 S=SST
ENDIF
IF POSS<0
N30 SPOS=DC($SC_THREAD_START_ANGLE)
ELSE
N30 SPOS=DC(POSS)
ENDIF
_OLD12=$P_GG[12]
CASE _TECNO[0] OF 1 GOTOF _GG601 2 GOTOF _GG602 3 GOTOF _GG603 DEFAULT GOTOF _GNIX
_GG601: G60 G601
GOTOF _GNIX
_GG602: G60 G602
GOTOF _GNIX
_GG603: G60 G603
_GNIX:
_OLD24=$P_GG[24]
CASE _TECNO[1] OF 1 GOTOF _FFW1 2 GOTOF _FFW2 DEFAULT GOTOF _FFNIX
_FFW1: FFWON
GOTOF _FFNIX
_FFW2: FFWOF
_FFNIX:
_OLD21=$P_GG[21]
CASE _TECNO[2] OF 1 GOTOF _ACC1 2 GOTOF _ACC2 3 GOTOF _ACC3 DEFAULT GOTOF _ACCNIX
_ACC1: SOFT
GOTOF _ACCNIX
_ACC2: BRISK
GOTOF _ACCNIX
_ACC3: DRIVE
_ACCNIX:
IF(_VARI==0)
IF(NOT $P_ISTEST) AND ((_DRY_STAT==1) OR (_ISO==1))
N32 G90 G331 AX[_Z]=DP IP[_Z]=PP/_HMF S=SST
N33 G4 F=DTB
N34 G332 AX[_Z]=RFP+HH1/_HMF IP[_Z]=PP/_HMF S=SST1
ELSE
N42 G90 G0 AX[_Z]=DP/_HMF S=SST
N43 G4 F=DTB
N44 G0 AX[_Z]=RFP+HH1/_HMF S=SST1
ENDIF
ELSE
HZ=1
FAK=1
_HH9=_DAM
HH2=RFP*_HMF-_DAM*HH11
IF((HH2-DP*_HMF)*HH11)<0 GOTOF _FEHL8
IF($P_GG[13]==1)OR($P_GG[13]==3)
FAK=$MN_SCALING_VALUE_INCH
ENDIF
IF(_VRT<=0)
_VRT=HZ/FAK
ENDIF
_MA5A: G90 G331 AX[_Z]=HH2/_HMF IP[_Z]=PP/_HMF S=SST
IF _ISO==0
IF(NOT $P_ISTEST)
G4 F=DTB
ENDIF
ENDIF
IF(HH2==DP*_HMF)GOTOF _MA8
IF(ABS(HH2-DP*_HMF)-_HH9>=_DAM)
IF(ABS(HH2-DP*_HMF)>2*_DAM)
HH5=HH2-_HH9*HH11
ELSE
IF(ABS(HH2-DP*_HMF)>_DAM)
HH5=HH2-ABS(HH2-DP*_HMF)/2*HH11
ELSE
HH5=DP*_HMF
ENDIF
ENDIF
ELSE
IF(ABS(HH2-DP*_HMF)>_HH9)
IF(ABS(HH2-DP*_HMF)>2*_DAM)
HH5=DP*_HMF+_DAM*HH11
ELSE
HH5=HH2-ABS(HH2-DP*_HMF)/2*HH11
ENDIF
ELSE
HH5=DP*_HMF
ENDIF
ENDIF
_MA6:
IF(_VARI==2)
SBLON
N280 G90 G332 AX[_Z]=RFP+SDIS*HH11/_HMF IP[_Z]=PP/_HMF S=SST1
SBLOF
IF _ISO==0
IF(NOT $P_ISTEST)
G4 F=DTB
ENDIF
ENDIF
VHA=_VRT/FAK
N330 G90 G331 AX[_Z]=HH2/_HMF+VHA*HH11/_HMF IP[_Z]=PP/_HMF S=SST1
ELSE
N365 G91 G332 AX[_Z]=HH11*_VRT/_HMF IP[_Z]=PP/_HMF S=SST1
ENDIF
HH2=HH5
GOTOB _MA5A
_MA8:
IF _ISO==1
G4 F=DTB
ENDIF
ENDIF
IF _VARI<>0 ;normales Gewindebohren
N580 G90 G332 AX[_Z]=RFP+SDIS*HH11/_HMF IP[_Z]=PP/_HMF S=SST1
ENDIF
CASE _OLD12 OF 1 GOTOF _GOG601 2 GOTOF _GOG602 3 GOTOF _GOG603 DEFAULT GOTOF _GONIX
_GOG601: G601
GOTOF _GONIX
_GOG602: G602
GOTOF _GONIX
_GOG603: G603
_GONIX:
CASE _OLD24 OF 1 GOTOF _FFWO1 2 GOTOF _FFWO2 DEFAULT GOTOF _FFONIX
_FFWO1: FFWOF
GOTOF _FFONIX
_FFWO2: FFWON
_FFONIX:
CASE _OLD21 OF 1 GOTOF _ACCO1 2 GOTOF _ACCO2 3 GOTOF _ACCO3 DEFAULT GOTOF _ACCONIX
_ACCO1: BRISK
GOTOF _ACCONIX
_ACCO2: SOFT
GOTOF _ACCONIX
_ACCO3: DRIVE
_ACCONIX:
IF _TECNO[3]==0
SBLON
N36 G0 G64 AX[_Z]=RTP S=HH3 M=SDAC
SBLOF
ELSE
SBLON
N36 G0 G64 AX[_Z]=RTP
SBLOF
ENDIF
N37 MM2:MSG("")
IF HH4==0 GOTOF _MX3
N38 F=HH4
N39 _MX3:MSG("")
RET
_FEHL1:STOPRE
SETAL(61101)
RET
_FEHL2:STOPRE
SETAL(61001)
RET
_FEHL3:STOPRE
SETAL(61002)
RET
_FEHL4:STOPRE
SETAL(61125)
RET
_FEHL5:STOPRE
SETAL(61803)
RET
_FEHL7:STOPRE
SETAL(61127)
RET
_FEHL8:STOPRE
SETAL(61809)
RET

%_N_CYCLE840_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE840(REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DTB,INT SDR,INT SDAC,INT ENC,REAL MPIT,REAL PIT,INT _AXN,INT _PTAB,INT _TECHNO)SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 17, 2002
;Gewindebohren mit Ausgleichsfutter mit/ohne Geber, G33 und G63
N11 DEF AXIS _Z
N12 DEF REAL PP,HH1,HH2,HH3,HH4,_FNEU,_HMF,_BEP,_BEPVOR,_NIST,_NSOLL
N13 DEF INT SPINU,MRI,RRI,_TECNO[4],_II,_JJ,_CO1,_CO2,_OLD12,_OLD24
DEF INT _ABS,_ORD,_APP
IF (ENC==0) OR (ENC==1) OR (ENC==11) OR (ENC==20)
GOTOF _ENC_OK
ELSE
GOTOF _FEHL4
ENDIF
_ENC_OK:
_TECNO[0]=_TECHNO MOD 10 _TECNO[1]=TRUNC(_TECHNO/10) MOD 10 _TECNO[2]=TRUNC(_TECHNO/100) MOD 10
_TECNO[3]=TRUNC(_TECHNO/1000) MOD 10
IF(_TECNO[0]<0)OR(_TECNO[0]>3)OR(_TECNO[1]<0)OR(_TECNO[1]>2)OR(_TECNO[2]<0)OR(_TECNO[2]>1)OR(_TECNO[3]<0)OR(_TECNO[3]>1)GOTOF _FEHL5
_ABS=1 _ORD=2 _APP=3
IF $P_GG[6]==2
_ABS=3 _ORD=1 _APP=2
ENDIF
IF $P_GG[6]==3
_ABS=2 _ORD=3 _APP=1
ENDIF
CASE _AXN OF 1 GOTOF _AX1 2 GOTOF _AX2 DEFAULT GOTOF _AX3
_AX1:
IF ISAXIS(_ABS)
_Z=$P_AXN1
GOTOF _AX
ELSE
GOTOF _FEHL9
ENDIF
_AX2:
IF ISAXIS(_ORD)
_Z=$P_AXN2
GOTOF _AX
ELSE
GOTOF _FEHL9
ENDIF
_AX3:
IF ISAXIS(_APP)
_Z=$P_AXN3
ELSE
GOTOF _FEHL9
ENDIF
_AX:
_HMF=$P_ACTFRAME[_Z,SC]
DPR=ABS(DPR) SDIS=ABS(SDIS) HH3=$P_S[0] HH4=$P_F SPINU=$P_MSNUM
IF DPR==0 GOTOF _MD1 IF RTP==RFP GOTOF FEHL1
N16 HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MB1 IF DP==HH2 GOTOF _MD1
N1 MELDUNG(1)
_MB1:DP=HH2
_MD1:HH2=RTP-RFP
N17 IF RFP==DP GOTOF _MT4 IF HH2==0 GOTOF _MA2 IF HH2/ABS(HH2)<>(RFP-DP)/ABS(RFP-DP) GOTOF FEHL1
N18 HH1=SDIS*(RFP-DP)/ABS(RFP-DP)
_MA2:MRI=$P_SDIR[SPINU]
IF MRI==3
RRI=4
ELSE
RRI=3
ENDIF
FOR _II=0 TO ($ON_NUM_AXES_IN_SYSTEM-1)
_JJ=$MC_AXCONF_MACHAX_USED[_II]
IF _JJ<>0
IF $MA_SPIND_ASSIGN_TO_MACHAX[AXNAME("AX"<<_JJ)]==SPINU GOTOF _MASAXEND
ENDIF
ENDFOR
GOTOF _GG63
_MASAXEND:IF $MA_NUM_ENCS[AXNAME("AX"<<_JJ)]==0 GOTOF _GG63
IF ((ENC==1) OR (ENC==11)) GOTOF _GG63
CASE _PTAB OF 0 GOTOF _P0TAB 1 GOTOF _P1TAB 2 GOTOF _P2TAB 3 GOTOF _P3TAB DEFAULT GOTOF FEHL2
_P0TAB:IF (PIT<=0) AND (MPIT==0) GOTOF FEHL2
PP=PIT
IF MPIT<>0
IF (MPIT<3)OR(MPIT>48) GOTOF FEHL2
N3 STEIGUNG(PP,MPIT)
IF (PP<>PIT)AND(PIT<>0) GOTOF FEHL2
ENDIF
GOTOF _ENDTAB
_P1TAB:IF (PIT<=0) GOTOF FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=PIT/$MN_SCALING_VALUE_INCH
ELSE
PP=PIT
ENDIF
GOTOF _ENDTAB
_P2TAB:IF (PIT<=0) GOTOF FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=1/PIT
ELSE
PP=$MN_SCALING_VALUE_INCH/PIT
ENDIF
GOTOF _ENDTAB
_P3TAB:IF (PIT<=0) GOTOF FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=PIT
ELSE
PP=$MN_SCALING_VALUE_INCH*PIT
ENDIF
_ENDTAB:
_MB3:IF SDR==0 GOTOF _MD3 IF(SDR<3)OR(SDR>4) GOTOF FEHL3 IF (SDAC<3)OR(SDAC>5) GOTOF _MC3
MRI=SDAC
_MC3:RRI=SDR
_MD3:
_BEP=0
IF NOT (($AN_NCK_VERSION < 450000) OR ($P_SIM) )
IF _TECNO[3]==0
IF $MA_PARAMSET_CHANGE_ENABLE[_Z]==2
IF ($MA_DRIVE_AX_RATIO_DENOM[($AA_SCPAR[_Z]-1),_Z] <> $MA_DRIVE_AX_RATIO_DENOM[1,_Z]) GOTOF _FEHL7
IF ($MA_DRIVE_AX_RATIO_NUMERA[($AA_SCPAR[_Z]-1),_Z] <> $MA_DRIVE_AX_RATIO_NUMERA[1,_Z]) GOTOF _FEHL7
ELSE
IF ($MA_DRIVE_AX_RATIO_DENOM[$AC_SGEAR[SPINU],_Z] <> $MA_DRIVE_AX_RATIO_DENOM[1,_Z]) GOTOF _FEHL7
IF ($MA_DRIVE_AX_RATIO_NUMERA[$AC_SGEAR[SPINU],_Z] <> $MA_DRIVE_AX_RATIO_NUMERA[1,_Z]) GOTOF _FEHL7
ENDIF
ENDIF
ENDIF
SBLON
N30 G0 G09 G90 LFOF AX[_Z]=RFP+HH1/_HMF
SBLOF
_OLD12=$P_GG[12]
CASE _TECNO[0] OF 1 GOTOF _GG601 2 GOTOF _GG602 3 GOTOF _GG603 DEFAULT GOTOF _GNIX
_GG601: G60 G601
GOTOF _GNIX
_GG602: G60 G602
GOTOF _GNIX
_GG603: G60 G603
_GNIX:
_OLD24=$P_GG[24]
CASE _TECNO[1] OF 1 GOTOF _FFW1 2 GOTOF _FFW2 DEFAULT GOTOF _FFNIX
_FFW1: FFWON
GOTOF _FFNIX
_FFW2: FFWOF
_FFNIX:
N31 G33 AX[_Z]=(DP+_BEP) IP[_Z]=PP
N33 G33 G90 AX[_Z]=RFP+HH1/_HMF IP[_Z]=PP ;M=RRI
CASE _OLD12 OF 1 GOTOF _GOG601 2 GOTOF _GOG602 3 GOTOF _GOG603 DEFAULT GOTOF _GONIX
_GOG601: G601
GOTOF _GONIX
_GOG602: G602
GOTOF _GONIX
_GOG603: G603
_GONIX:
CASE _OLD24 OF 1 GOTOF _FFWO1 2 GOTOF _FFWO2 DEFAULT GOTOF _FFONIX
_FFWO1: FFWOF
GOTOF _FFONIX
_FFWO2: FFWON
_FFONIX:
IF ENC==20
N337 G4 F=DTB
ENDIF
SBLON
N34 G0 G64 AX[_Z]=RTP S=HH3 M=MRI
SBLOF
IF HH4==0 GOTOF _MX3
N35 F=HH4
N36 _MX3:MSG("")
N37 RET
_GG63:
IF ENC==11
CASE _PTAB OF 0 GOTOF _P5TAB 1 GOTOF _P6TAB 2 GOTOF _P7TAB 3 GOTOF _P8TAB DEFAULT GOTOF FEHL2
_P5TAB:PP=PIT
IF MPIT<>0
IF (MPIT<3)OR(MPIT>48) GOTOF FEHL2
STEIGUNG(PP,MPIT)
IF (PP<>PIT)AND(PIT<>0) GOTOF FEHL2
ENDIF
GOTOF _ENDTAB
_P6TAB:IF (PIT<=0) GOTOF FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=PIT/$MN_SCALING_VALUE_INCH
ELSE
PP=PIT
ENDIF
GOTOF _ENDTAB
_P7TAB:IF (PIT<=0) GOTOF FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=1/PIT
ELSE
PP=$MN_SCALING_VALUE_INCH/PIT
ENDIF
GOTOF _ENDTAB
_P8TAB:IF (PIT<=0) GOTOF FEHL2
IF ($P_GG[13]==1) OR ($P_GG[13]==3)
PP=PIT
ELSE
PP=$MN_SCALING_VALUE_INCH*PIT
ENDIF
_ENDTAB:
IF PP==0
_FNEU=HH4 ENC=1
GOTOF _M5302
ENDIF
_FNEU=HH4
IF $P_GG[15]==2
_FNEU=PP*HH3
IF ($P_GG[13]==1) AND ($MN_SCALING_SYSTEM_IS_METRIC==1)
_FNEU=_FNEU*$MN_SCALING_VALUE_INCH
ENDIF
IF ($P_GG[13]==2) AND ($MN_SCALING_SYSTEM_IS_METRIC==0)
_FNEU=_FNEU/$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
IF $P_GG[15]==3
_FNEU=PP
IF ($P_GG[13]==1) AND ($MN_SCALING_SYSTEM_IS_METRIC==1)
_FNEU=_FNEU*$MN_SCALING_VALUE_INCH
ENDIF
IF ($P_GG[13]==2) AND ($MN_SCALING_SYSTEM_IS_METRIC==0)
_FNEU=_FNEU/$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FNEU=HH4
ENDIF
_M5302:
IF (SDR<3)OR(SDR>4) GOTOF FEHL3 IF (SDAC<3)OR(SDAC>5) GOTOF _MA4
RRI=SDAC
IF NOT (($AN_NCK_VERSION < 450000) OR ($P_SIM) )
IF _TECNO[3]==0
IF ($MA_DRIVE_AX_RATIO_DENOM[($AA_SCPAR[_Z]-1),_Z] <> $MA_DRIVE_AX_RATIO_DENOM[1,_Z]) GOTOF _FEHL7
IF ($MA_DRIVE_AX_RATIO_NUMERA[($AA_SCPAR[_Z]-1),_Z] <> $MA_DRIVE_AX_RATIO_NUMERA[1,_Z]) GOTOF _FEHL7
ENDIF
ENDIF
_MA4:
SBLON
N4 G0 G09 G90 AX[_Z]=RFP+HH1/_HMF F=_FNEU
SBLOF
N400 SBLOF
IF (_TECNO[3]==0) AND ($P_SEARCH==0) AND ($P_DRYRUN==0)
IF ($AC_SDIR[SPINU]==SDR) OR ($AC_SDIR[SPINU]==5)GOTOF _FEHL8
ENDIF
IF NOT (($AN_NCK_VERSION < 450000) OR ($P_SIM) )
IF (_TECNO[3]==0) AND ($P_SEARCH==0) AND ($P_DRYRUN==0)
_NSOLL=$P_S[SPINU]
IF _NSOLL>$MA_GEAR_STEP_MAX_VELO_LIMIT[$AC_SGEAR[SPINU],AXNAME("AX"<<_JJ)]
_NSOLL=$MA_GEAR_STEP_MAX_VELO_LIMIT[$AC_SGEAR[SPINU],AXNAME("AX"<<_JJ)]
ENDIF
IF _NSOLL<$MA_GEAR_STEP_MIN_VELO_LIMIT[$AC_SGEAR[SPINU],AXNAME("AX"<<_JJ)]
_NSOLL=$MA_GEAR_STEP_MIN_VELO_LIMIT[$AC_SGEAR[SPINU],AXNAME("AX"<<_JJ)]
ENDIF
IF _NSOLL>$SA_SPIND_MAX_VELO_G26[AXNAME("AX"<<_JJ)]
_NSOLL=$SA_SPIND_MAX_VELO_G26[AXNAME("AX"<<_JJ)]
ENDIF
IF _NSOLL<$SA_SPIND_MIN_VELO_G25[AXNAME("AX"<<_JJ)]
_NSOLL=$SA_SPIND_MIN_VELO_G25[AXNAME("AX"<<_JJ)]
ENDIF
_CO2=0
GOTOF _W13C
_W12C: MSG("$80018")
_W13C:
IF(ABS(_NSOLL-$AA_S[SPINU])>($MA_SPIND_DES_VELO_TOL[AXNAME("AX"<<_JJ)]*_NSOLL)) GOTOB _W12C
_CO2=_CO2+1
IF(_CO2<3) GOTOB _W13C
ENDIF
MSG("")
ENDIF
_OLD12=$P_GG[12]
CASE _TECNO[0] OF 1 GOTOF _GGG601 2 GOTOF _GGG602 3 GOTOF _GGG603 DEFAULT GOTOF _GGNIX
_GGG601: G60 G601
GOTOF _GGNIX
_GGG602: G60 G602
GOTOF _GGNIX
_GGG603: G60 G603
_GGNIX:
_OLD24=$P_GG[24]
CASE _TECNO[1] OF 1 GOTOF _FFFW1 2 GOTOF _FFFW2 DEFAULT GOTOF _FFFNIX
_FFFW1: FFWON
GOTOF _FFFNIX
_FFFW2: FFWOF
_FFFNIX:
N41 G63 AX[_Z]=DP
_NIST=$AA_S[SPINU]
N42 M=SDR
N43 G4 F=DTB
IF (_TECNO[3]==0) AND ($P_SEARCH==0) AND ($P_DRYRUN==0)
_CO1=0
GOTOF _W13B
_W12B: MSG("$80017")
_W13B:
IF(_NIST<0)
IF($AA_S[SPINU]<0) GOTOB _W12B
_CO1=_CO1+1
IF(_CO1<3) GOTOB _W13B
ELSE
IF($AA_S[SPINU]>0) GOTOB _W12B
_CO1=_CO1+1
IF(_CO1<3) GOTOB _W13B
ENDIF
MSG("")
ENDIF
N44 G63 AX[_Z]=RFP+HH1/_HMF
CASE _OLD12 OF 1 GOTOF _GAG601 2 GOTOF _GAG602 3 GOTOF _GAG603 DEFAULT GOTOF _GANIX
_GAG601: G601
GOTOF _GANIX
_GAG602: G602
GOTOF _GANIX
_GAG603: G603
_GANIX:
CASE _OLD24 OF 1 GOTOF _FFWA1 2 GOTOF _FFWA2 DEFAULT GOTOF _FFANIX
_FFWA1: FFWOF
GOTOF _FFANIX
_FFWA2: FFWON
_FFANIX:
SBLON
N45 G0 G64 AX[_Z]=RTP S=HH3 M=RRI
SBLOF
IF HH4==0 GOTOF _MT4
N46 F=HH4
N47 _MT4:MSG("")
N48 _MX4:RET
FEHL1:STOPRE
SETAL(61101)
RET
FEHL2:STOPRE
SETAL(61001)
RET
FEHL3:STOPRE
SETAL(61102)
RET
_FEHL4:STOPRE
SETAL(61002)
RET
_FEHL5:STOPRE
SETAL(61125)
RET
_FEHL6:STOPRE
SETAL(61126)
RET
_FEHL7:STOPRE
SETAL(61127)
RET
_FEHL8:STOPRE
SETAL(61807)
RET
_FEHL9:STOPRE
SETAL(61803)
RET

%_N_CYCLE85_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE85 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DTB,REAL FFR,REAL RFF) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.02.04 Jul 23, 2001
;Ausbohren 1, Reiben
DEF AXIS _Z
DEF REAL HH2
DEF INT HH7
IF HH7 GOTOF _MM1B
_Z=$P_AXN3 DPR=ABS(DPR) SDIS=ABS(SDIS)
IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MELDUNG(1)
N1 _MM0:DP=HH2
_MM1:HH2=RTP-RFP
IF RFP==DP GOTOF _MM2 IF HH2==0 GOTOF _MM1A IF HH2/ABS(HH2)<>(RFP-DP)/ABS(RFP-DP) GOTOF FEHL1
_MM1A:HH7=1
_MM1B:
SBLON
N11 G0 G64 G90 AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP)
SBLOF
N2 G1 F=FFR AX[_Z]=DP
IF(DTB>=0)
N3 G4 F=DTB
ELSE
N3 G4 S=-DTB
ENDIF
N4 F=RFF AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP)
SBLON
N5 G0 AX[_Z]=RTP
SBLOF
_MM2:MSG("")
RET
N20 FEHL1:STOPRE
SETAL(61101)
RET

%_N_CYCLE86_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE86 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DTB,INT SDIR,REAL RPA,REAL RPO,REAL RPAP,REAL POSS) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.02.07 Nov 26, 2001
;Ausbohren 2, Ausdrehen
DEF AXIS _X,_Y,_Z
DEF REAL HH2
DEF INT HH7
DEF INT _ABS=1,_ORD=2,_APP=3
IF $P_GG[6]==2
_ABS=3 _ORD=1 _APP=2
ENDIF
IF $P_GG[6]==3
_ABS=2 _ORD=3 _APP=1
ENDIF
IF (ISAXIS(_APP)==0) GOTOF FEHL2
IF HH7 GOTOF _MM1B
_Z=$P_AXN3
IF(ISAXIS(_ABS)==1)
_X=$P_AXN1
ENDIF
IF(ISAXIS(_ORD)==1)
_Y=$P_AXN2
ENDIF
DPR=ABS(DPR) SDIS=ABS(SDIS)
IF (SDIR==3)OR(SDIR==4)OR(SDIR==5) GOTOF _MM00
STOPRE
SETAL(61102)
RET
_MM00:IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MELDUNG(1)
_MM0:DP=HH2
_MM1:HH2=RTP-RFP
IF RFP==DP GOTOF _MM2 IF HH2==0 GOTOF _MM1A IF HH2/ABS(HH2)<>(RFP-DP)/ABS(RFP-DP) GOTOF FEHL1
_MM1A:HH7=1
_MM1B:
IF (SDIR<>5)
M=SDIR
ENDIF
SBLON
N1 G0 G64 G90 AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP)
SBLOF
N2 G1 AX[_Z]=DP
IF(DTB>=0)
N3 G4 F=DTB
ELSE
N3 G4 S=-DTB
ENDIF
N4 SPOS=POSS
IF(ISAXIS(_ABS)==1) AND (ISAXIS(_ORD)==1) AND (ISAXIS(_APP)==1)
N5 G91 G0 AX[_X]=RPA AX[_Y]=RPO AX[_Z]=RPAP
ELSE
IF(ISAXIS(_ABS)==1) AND (ISAXIS(_APP)==1)
N51 G91 G0 AX[_X]=RPA AX[_Z]=RPAP
ELSE
IF(ISAXIS(_ORD)==1) AND (ISAXIS(_APP)==1)
N52 G91 G0 AX[_Y]=RPO AX[_Z]=RPAP
ELSE
GOTOF FEHL2
ENDIF
ENDIF
ENDIF
N6 G90 G0 AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP)
SBLON
IF(ISAXIS(_ABS)==1) AND (ISAXIS(_ORD)==1) AND (ISAXIS(_APP)==1)
N7 G91 AX[_X]=-RPA AX[_Y]=-RPO AX[_Z]=RTP-(RFP+SDIS*(RFP-DP)/ABS(RFP-DP))
ELSE
IF(ISAXIS(_ABS)==1) AND (ISAXIS(_APP)==1)
N71 G91 AX[_X]=-RPA AX[_Z]=RTP-(RFP+SDIS*(RFP-DP)/ABS(RFP-DP))
ELSE
N72 G91 AX[_Y]=-RPO AX[_Z]=RTP-(RFP+SDIS*(RFP-DP)/ABS(RFP-DP))
ENDIF
ENDIF
SBLOF
_MM2:MSG("")
RET
N20 FEHL1:STOPRE
SETAL(61101)
RET
N30 FEHL2:STOPRE
SETAL(61005)
RET

%_N_CYCLE87_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE87 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,INT SDIR) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 17, 2002
;Ausbohren 3, mit M5 M0
DEF AXIS _Z
DEF REAL HH2
DEF INT HH7
IF HH7 GOTOF _MM1B
_Z=$P_AXN3 DPR=ABS(DPR) SDIS=ABS(SDIS)
IF (SDIR==3) OR (SDIR==4) GOTOF _MM00
STOPRE
SETAL(61102)
RET
_MM00:IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MELDUNG(1)
N1 _MM0:DP=HH2
_MM1:HH2=RTP-RFP
IF RFP==DP GOTOF _MM2 IF HH2==0 GOTOF _MM1A IF HH2/ABS(HH2)<>(RFP-DP)/ABS(RFP-DP) GOTOF FEHL1
_MM1A:HH7=1
_MM1B:M=SDIR
SBLON
G0 G64 G90 AX[_Z]=RFP+(RFP-DP)/ABS(RFP-DP)*SDIS
SBLOF
N2 G1 AX[_Z]=DP
N3 M5 M0
SBLON
N4 G0 AX[_Z]=RTP
SBLOF
_MM2:MSG("")
RET
N20 FEHL1:STOPRE
SETAL (61101)
RET

%_N_CYCLE88_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE88 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DTB,INT SDIR) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 17, 2002
;Ausbohren 4, mit M5 M0 und Verweilzeit
DEF AXIS _Z
DEF REAL HH2,_HH3,_HH4
DEF INT HH7
IF HH7 GOTOF _MM1B
_Z=$P_AXN3 DPR=ABS(DPR) SDIS=ABS(SDIS)
IF (SDIR==3) OR (SDIR==4) OR (SDIR==5) GOTOF _MM00
STOPRE
SETAL(61102)
RET
_MM00:IF DPR==0 GOTOF _MM1
IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MELDUNG(1)
N1 _MM0: DP=HH2
_MM1:HH2=RTP-RFP
IF RFP==DP GOTOF _MM2
IF HH2==0 GOTOF _MM1A IF HH2/ABS(HH2) <> (RFP-DP)/ABS(RFP-DP) GOTOF FEHL1
_MM1A:HH7=1
_MM1B:
IF (SDIR<>5)
M=SDIR
ENDIF
SBLON
G0 G64 G90 AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP)
SBLOF
N2 G1 AX[_Z]=DP
IF(DTB>=0)
N3 G4 F=DTB
ELSE
N3 G4 S=-DTB
ENDIF
IF(_ZSD[5]==0)
N4 M5 M0
ELSE
N4 M5
WHILE($AA_S[$P_MSNUM]>0)
ENDWHILE
G4 F0.1
ENDIF
SBLON
N5 G0 AX[_Z]=RTP
SBLOF
_MM2:MSG("")
RET
FEHL1:STOPRE
SETAL(61101)
RET

%_N_CYCLE89_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE89 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DTB) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 17, 2002
;Ausbohren 5, Rueckzug mit Vorschub
DEF AXIS _Z
DEF REAL HH2
DEF INT HH7
IF HH7 GOTOF _MM1B
_Z=$P_AXN3 DPR=ABS(DPR) SDIS=ABS(SDIS)
IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP - RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MELDUNG(1)
N1 _MM0:DP=HH2
_MM1:HH2=RTP-RFP
IF RFP==DP GOTOF _MM2 IF HH2==0 GOTOF _MM1A IF HH2/ABS(HH2)<>(RFP-DP)/ABS(RFP-DP) GOTOF FEHL1
_MM1A:HH7=1
_MM1B:
SBLON
G0 G64 G90 AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP)
SBLOF
N2 G1 AX[_Z]=DP
IF(DTB>=0)
N3 G4 F=DTB
ELSE
N3 G4 S=-DTB
ENDIF
N4 AX[_Z]=RFP+SDIS*(RFP-DP)/ABS(RFP-DP)
SBLON
N5 G0 AX[_Z]=RTP
SBLOF
_MM2:MSG("")
RET
FEHL1:STOPRE
SETAL(61101)
RET

%_N_CYCLE90_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE90(REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL DIATH,REAL KDIAM,REAL PIT,REAL FFR,INT CDIR,INT TYPTH,REAL CPA,REAL CPO) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.01 Apr 18, 2002
;Gewindefraesen
DEF REAL WR,ARAD,XWEG,YWEG,RDIF,HRD,HH1,HH2,HH3,HH4,HH5,HH50,HH6,_FAK1,HRDI,_EPS=0.002
DEF INT DNUM,ANZG,RFAK
DEF AXIS _X,_Y,_Z
DEF INT _MIRR=0
IF ($P_SIM==1) AND ($P_TOOL==0)
MELDUNG(12)
ENDIF
_X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 DNUM=$P_TOOL WR=$P_TOOLR DPR=ABS(DPR) SDIS=ABS(SDIS)
IF ((DNUM==0)OR(WR==0)) AND ($P_SIM==0) GOTOF FEHL1
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF CDIR==2
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
WR=WR*_FAK1
IF TYPTH==0
IF WR>=KDIAM/2
GOTOF FEHL2
ENDIF
ENDIF
IF(WR<0)GOTOF FEHL4
IF DPR==0 GOTOF _MB1 IF RTP==RFP GOTOF FEHL3
RFAK=(RTP-RFP)/ABS(RTP-RFP) HH2=RFP-RFAK*DPR
IF DP==0 GOTOF _MMA1
IF ABS(DP-HH2)<_EPS GOTOF _MB1
N10 MELDUNG(1)
_MMA1:DP=HH2
_MB1:HH2=RTP-RFP
IF RFP==DP GOTOF _MX8
RFAK=(RFP-DP)/ABS(RFP-DP)
IF ABS(HH2)<_EPS GOTOF _MD1
_MD1:
IF TYPTH==1
ARAD=ABS(DIATH)/2
ELSE
ARAD=ABS(KDIAM)/2
ENDIF
SDIS=SDIS*RFAK HH1=ABS(RFP+SDIS-DP) ANZG=TRUNC(HH1/PIT) HH2=ANZG*PIT
IF ABS(HH2-HH1)<_EPS GOTOF _MH1
ANZG=ANZG+1 SDIS=SDIS+(PIT*ANZG-HH1)*RFAK
_MH1:RDIF=ARAD+WR
IF TYPTH GOTOF _MJ1
RDIF=ARAD-WR
_MJ1:HH3=RDIF/ARAD*FFR HRD=RDIF/2 HH4=PIT/4*(WR+HRD)/ARAD
HH5=CPA+RDIF XWEG=HH5-HRD
IF(TYPTH==0)
HRDI=(RDIF/2+(DIATH-KDIAM)/2)/2
HH4=PIT/2*(WR+(DIATH/2))/DIATH
HH5=CPA+RDIF
XWEG=HH5-RDIF/2
IF(WR>=0.667*(DIATH/2))
HRDI=(2*RDIF+(DIATH-KDIAM)/2)/2
HH4=PIT/2*KDIAM/DIATH
XWEG=CPA-RDIF
ENDIF
HH50=HH5+(DIATH-KDIAM)/2
YWEG=0
RDIF=DIATH/2-WR
ENDIF
HH6=DP-HH4*RFAK
IF (CDIR==2)OR(CDIR==3) GOTOF _ML1
N11 MELDUNG(5)
CDIR=3
_ML1:IF CDIR==2 GOTOF _MN1
HRD=-HRD
_MN1:RDIF=-RDIF YWEG=CPO+HRD
IF(TYPTH==0) ;AND (WR>=(0.667*ARAD))
IF CDIR==2 GOTOF _ML10
HRDI=-HRDI
_ML10:
YWEG=CPO
ENDIF
IF TYPTH GOTOF _MA3
SBLON
N2 G0 G90 G60 G40 AX[_X]=CPA AX[_Y]=CPO
IF ABS($P_EP[_Z]*_FAK1-RTP)>ABS($P_EP[_Z]*_FAK1-RFP+SDIS) GOTOF _MY20
N20 AX[_Z]=RTP
N21 _MY20:G0 AX[_Z]=RFP+SDIS+RFAK*HH4
SBLOF
N22 G1 G64 F=HH3 AX[_X]=XWEG AX[_Y]=YWEG
IF CDIR==2
N23 G2 F=HH3 AX[_X]=HH50 AX[_Y]=CPO AX[_Z]=RFP+SDIS CR=ABS(HRDI)
ELSE
N23 G3 F=HH3 AX[_X]=HH50 AX[_Y]=CPO AX[_Z]=RFP+SDIS CR=ABS(HRDI)
ENDIF
_MB2:IF ANZG<1 GOTOF _MD2
N24 AX[_X]=HH50 AX[_Y]=CPO AX[_Z]=DP IP[_X]=RDIF IP[_Y]=0 TURN=ANZG-1
_MD2:
N25 AX[_X]=XWEG AX[_Y]=CPO AX[_Z]=HH6 CR=ABS(HRDI)
SBLON
N26 G0 G60 AX[_X]=CPA AX[_Y]=CPO
N27 AX[_Z]=RTP
N28 MSG("")
RET
_MA3:HH2=ABS(HRD) HH1=HH5+HH2
SBLON
N3 G0 G90 G60 G40 AX[_X]=HH1 AX[_Y]=CPO+HRD
IF ABS($P_EP[_Z]*_FAK1-RTP)>ABS($P_EP[_Z]*_FAK1-RFP+SDIS) GOTOF _MY30
N30 AX[_Z]=RTP
N31 _MY30:G0 AX[_Z]=RFP+SDIS+RFAK*HH4
SBLOF
IF ANZG<1 GOTOF _MD3 IF CDIR==3 GOTOF _MB3
N33 G3 G64 F=HH3 AX[_X]=HH5 AX[_Y]=CPO AX[_Z]=RFP+SDIS CR=HH2
N34 G2 AX[_X]=HH5 AX[_Y]=CPO AX[_Z]=DP IP[_X]=RDIF IP[_Y]=0 TURN=ANZG-1
SBLON
N35 G3 G60 F=HH3 AX[_X]=HH1 AX[_Y]=CPO+HRD CR=HH2
GOTOF _MD3
N33 _MB3:G2 G64 F=HH3 AX[_X]=HH5 AX[_Y]=CPO AX[_Z]=RFP+SDIS CR=HH2
N34 G3 AX[_X]=HH5 AX[_Y]=CPO AX[_Z]=DP IP[_X]=RDIF IP[_Y]=0 TURN=ANZG-1
SBLON
N35 G2 G60 F=HH3 AX[_X]=HH1 AX[_Y]=CPO+HRD CR=HH2
N37 _MD3:G0 AX[_Z]=RTP
N38 _MX8:MSG("")
_MX9:RET
FEHLERBEHANDLUNG
FEHL1:STOPRE
SETAL(61000)
RET
FEHL2:STOPRE
SETAL(61105)
RET
FEHL3:STOPRE
SETAL(61101)
RET
FEHL4:STOPRE
SETAL(61112)
RET

%_N_FGROUP_SPF
PROC FGROUP () SAVE SBLOF DISPLOF
;Feedrate control : Not supported
RET


%_N_LONGHOLE_SPF
;$PATH=/_N_CST_DIR
PROC LONGHOLE (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,INT NUM,REAL LENG,REAL CPA,REAL CPO,REAL RAD,REAL STA1,REAL INDA,REAL FFD,REAL FFP1,REAL MID,INT _VARI,INT _UMODE) SAVE SBLOF DISPLOF
;VERSION: 06.05.21.00 Sep 11, 2007
;CHANGE : 06.05.17.00 Sep 02, 2005
;Langloch
DEF AXIS _X,_Y,_Z
DEF REAL HH1,HH2,HH3,HH4,HH5,HH6,HH7,_FAK1,_SDZI,_ZUZ,_RE_ROT
DEF INT HZ1,HZ2,HZ3,_SPIND,_H8,_IS_CYCFR,_ERR=0,_II
DEF BOOL _ZB[13],_H9, _MDG
DEF FRAME _RE_CYCFR
DEF INT _ARTIS[16]
_X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 SDIS=ABS(SDIS) DPR=ABS(DPR) LENG=ABS(LENG) _RE_ROT=0
RAD=ABS(RAD) NUM=ABS(NUM) MID=ABS(MID) HH6=STA1
IF (($MC_MM_SYSTEM_FRAME_MASK B_AND 'B100000') AND ($AN_NCK_VERSION>=480300))
_IS_CYCFR=1
_RE_CYCFR=$P_CYCFRAME
ENDIF
IF _SC_TOOL_VALI[0]<>0
_ARTIS[0]=_SC_TOOL_VALI[0] _ARTIS[1]=_SC_TOOL_VALI[1] _ARTIS[2]=_SC_TOOL_VALI[2] _ARTIS[3]=_SC_TOOL_VALI[3] _ARTIS[4]=_SC_TOOL_VALI[4] _ARTIS[5]=_SC_TOOL_VALI[5] _ARTIS[6]=_SC_TOOL_VALI[6]
_ARTIS[7]=_SC_TOOL_ON_OFF[0] _ARTIS[8]=_SC_TOOL_ON_OFF[1]
IF (_ARTIS[0] MOD 10 <>1 )
GOTOF _FEHL7
ENDIF
_II=_ARTIS[0] DIV 10
IF ((_II MOD 10 > 3) OR (_II MOD 10 < 1))
GOTOF _FEHL7
ELSE
_ARTIS[11]=_II MOD 10
IF (_ARTIS[3]<>0)
_ARTIS[13]=_ARTIS[1]
ENDIF
IF (_ARTIS[6]<>0)
_ARTIS[14]=_ARTIS[4]
ENDIF
ENDIF
_II=_II DIV 10
IF ((_II MOD 10 > 2) OR (_II MOD 10 < 0))
GOTOF _FEHL7
ELSE
_ARTIS[12]=_II MOD 10
ENDIF
_ARTIS[0]=_ARTIS[0] MOD 100
ENDIF
_SPIND=ABS(_VARI) DIV 100 _VARI=_VARI MOD 100
IF _SPIND>2 GOTOF _FEHL5
IF ((ISFILE("/_N_CMA_DIR/_N_ST_CUST_SPF")==1)AND(_SPIND>0)) GOTOF _STCCMA IF ((ISFILE("/_N_CUS_DIR/_N_ST_CUST_SPF")==0)AND(_SPIND>0)) GOTOF _FEHL12
_STCCMA:
IF NOT((_VARI==0) OR (_VARI==1) OR (_VARI==3) OR (_VARI==5)) GOTOF _FEHL5
IF _VARI MOD 10 == 5
_ZB[12]=1
ENDIF
_H8=$P_TRAFO
IF ((_SPIND==2) AND (_H8 B_AND 'H300') ) GOTOF _FEHL5
IF((_SPIND==1)AND(_VARI==3)) GOTOF _FEHL5
IF(_ZSD[1]==0)
_SDZI=SDIS
ENDIF
IF(_VARI==3)
_SDZI=SDIS
ENDIF
IF (_ZSD[3]) AND ($P_GG[15]==3)
_ZB[8]=1
ENDIF
IF($P_GG[13]<3)
_FAK1=1
IF($MN_SCALING_SYSTEM_IS_METRIC)
IF($P_GG[13]==1)
_FAK1=1/$MN_SCALING_VALUE_INCH
ENDIF
ELSE
IF($P_GG[13]==2)
_FAK1=$MN_SCALING_VALUE_INCH
ENDIF
ENDIF
ELSE
_FAK1=1
ENDIF
IF $P_SIM
IF $P_TOOL==0
HH3=1
ELSE
HH3=$P_TOOLR
ENDIF
ELSE
IF $P_TOOL==0
GOTOF FEHL6
ELSE
HH3=$P_TOOLR
ENDIF
ENDIF
HH3=HH3*_FAK1
IF NUM==0 GOTOF FEHL2 IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1
N10 MSG("$80000")
_MDG=1
_MM0: DP=HH2
GOTOF _MM1A
_MM1:DPR=ABS(RFP-DP)
_MM1A:IF RFP==DP GOTOF _MM8
IF RTP==RFP GOTOF _MM2 IF (RTP-RFP)/ABS(RTP-RFP)<>(RFP-DP)/DPR GOTOF FEHL1
_MM2:HH2=(RFP-DP)/DPR
_MM2B:HH3=HH3/$P_ACTFRAME[_X,SC]
IF NUM==1 GOTOF _MM14 IF INDA<>0 GOTOF _MM3
INDA=360/NUM
GOTOF _MM4
_MM3:IF ABS(INDA*(NUM-1))>=360 GOTOF FEHL2
IF (INDA*(NUM-1)<=180) GOTOF _MM4 IF ABS((RAD+HH3)*SIN((INDA*(NUM-1))/2))<=HH3 GOTOF FEHL3
_MM4:IF (INDA>180) GOTOF _MM14 IF ABS((RAD+HH3)*SIN(INDA/2))<=HH3 GOTOF FEHL3
_MM14:IF MID GOTOF _MM4A
MID=_SDZI+DPR
_MM4A:HZ1=(_SDZI+DPR)/MID+0.4999
IF HZ1==0
HZ1=1
ENDIF
IF(_VARI==3)
IF HZ1>1
HZ1=(_SDZI+DPR)*2/MID+0.4999
ENDIF
ENDIF
HH1=(_SDZI+DPR)/HZ1
HH4=RAD+HH3 HH5=RAD+LENG-HH3 HH3=HH4 HH7=1 HZ2=1
IF HH5<=HH4
IF $P_SEARCH
RET
ELSE
GOTOF FEHL4
ENDIF
ENDIF
IF SQRT(POT(CPA+HH4*COS(STA1)-$P_EP[_X]*_FAK1)+POT(CPO+HH4*SIN(STA1)-$P_EP[_Y]*_FAK1)) <= SQRT(POT(CPA+HH5*COS(STA1)-$P_EP[_X]*_FAK1)+POT(CPO+HH5*SIN(STA1)-$P_EP[_Y]*_FAK1)) GOTOF _MM5
HH3=HH5 HH7=-1
_MM5:
IF _SPIND==2
ST_CUST(_UMODE)
ENDIF
IF (_IS_CYCFR==1)
N10 $P_CYCFRAME=$P_CYCFRAME:CTRANS(_X,CPA*1/_FAK1,_Y,CPO*1/_FAK1)
ELSE
N11 ATRANS AX[_X]=CPA AX[_Y]=CPO
ENDIF
_MM6:MSG("$80006")
_MDG=1
IF (_IS_CYCFR==1)
N10 $P_CYCFRAME=$P_CYCFRAME:CROT(_Z,HH6)
_RE_ROT=_RE_ROT+HH6
IF(_ZSD[8]==1) GOTOF _M_ST_POS
ELSE
AROT AX[_Z]=HH6
ENDIF
SBLON
N20 G0 G90 G40 G60 G601 AX[_X]=HH3 AX[_Y]=0
IF ((_SPIND==1)AND(_VARI<2))
SBLOF
ST_CUST(_UMODE)
SBLON
_H9=1
ENDIF
N21 G64 AX[_Z]=RFP+SDIS*HH2
SBLOF
_ZUZ=(RFP+SDIS*HH2)-(DP+(HZ1-HZ2)*HH1*HH2)
N22 _MM7:
IF (_ARTIS[11]==3)
_ARTIS[10]=_ARTIS[10]+1
IF (_ARTIS[6]<>0)
IF (_ARTIS[10]==_ARTIS[14])
_ARTIS[4]=_ARTIS[14] _ARTIS[5]=_ARTIS[14]
IF (_ARTIS[14]+_ARTIS[6]<=_SC_TOOL_VALI[5])
_ARTIS[14]=_ARTIS[14]+_ARTIS[6]
ENDIF
ENDIF
ELSE
IF ((_SC_TOOL_VALI[4]<=_ARTIS[10]) AND (_ARTIS[10]<=_SC_TOOL_VALI[5]))
_ARTIS[4]=_ARTIS[10] _ARTIS[5]=_ARTIS[10]
ENDIF
ENDIF
ENDIF
IF HZ1>1
IF(HZ2==1)
WRTPR("TMP_BLK_BEG()",1)
ENDIF
IF(HZ2==HZ1)
WRTPR("TMP_BLK_END()",1)
ENDIF
ENDIF
IF ((_SPIND==1)AND(_VARI<2)AND(_H9==0))
ST_CUST(_UMODE)
ENDIF
_H9=0
IF (_ARTIS[0]==11)
M=_ARTIS[7];;;QU(_ARTIS[7])
ENDIF
IF(_VARI==3)
IF NOT(_ZSD[3])
F=FFP1
ELSE
IF _ZB[8]
G95 F=FFP1
ELSE
G94 F=FFP1
ENDIF
ENDIF
IF ((_ARTIS[11]==3))
IF (_ARTIS[10]==_ARTIS[4])
M=_ARTIS[7];;;QU(_ARTIS[7])
ENDIF
ENDIF
N23 G1 G91 AX[_X]=(HH5-HH4)*HH7 AX[_Y]=0 AX[_Z]=-_ZUZ F=FFP1
ELSE
IF NOT(_ZSD[3])
F=FFD
ELSE
IF _ZB[8]
G94 F=FFD
ELSE
G95 F=FFD
ENDIF
ENDIF
IF (_ARTIS[11]==3)
IF (_ARTIS[10]==_ARTIS[4])
M=_ARTIS[7];;;QU(_ARTIS[7])
ENDIF
ENDIF
G1 G90 G60 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
IF ((_SPIND==1)AND(_VARI<2))
ST_CUST(_UMODE+1)
ENDIF
IF NOT(_ZSD[3])
F=FFP1
ELSE
IF _ZB[8]
G95 F=FFP1
ELSE
G94 F=FFP1
ENDIF
ENDIF
N230 G91 AX[_X]=(HH5-HH4)*HH7 AX[_Y]=0 F=FFP1
ENDIF
IF (_ARTIS[11]==3)
IF (_ARTIS[10]==_ARTIS[5])
M=_ARTIS[7];;;QU(_ARTIS[8])
ENDIF
ENDIF
HH7=-HH7 HZ2=HZ2+1
IF HZ2 <= HZ1 GOTOB _MM7
IF(_VARI==3)
IF NOT(_ZSD[3])
F=FFP1
ELSE
IF _ZB[8]
G95 F=FFP1
ELSE
G94 F=FFP1
ENDIF
ENDIF
N231 G1 G91 AX[_X]=(HH5-HH4)*HH7 AX[_Y]=0 F=FFP1
ENDIF
IF (_ARTIS[0]==11)
M=_ARTIS[7];;;QU(_ARTIS[8])
ENDIF
SBLON
N24 G0 G90 G60 AX[_Z]=RTP
SBLOF
HZ2=1 HH6=INDA HZ3=HZ3+1
IF _SC_TOOL_VALI[0]<>0
_ARTIS[0]=_SC_TOOL_VALI[0] _ARTIS[1]=_SC_TOOL_VALI[1] _ARTIS[2]=_SC_TOOL_VALI[2] _ARTIS[3]=_SC_TOOL_VALI[3] _ARTIS[4]=_SC_TOOL_VALI[4] _ARTIS[5]=_SC_TOOL_VALI[5] _ARTIS[6]=_SC_TOOL_VALI[6]
_ARTIS[9]=0 _ARTIS[10]=0
IF (_ARTIS[3]<>0)
_ARTIS[13]=_ARTIS[1]
ENDIF
IF (_ARTIS[6]<>0)
_ARTIS[14]=_ARTIS[4]
ENDIF
ENDIF
IF HZ3>=NUM GOTOF _MM8
IF ($P_EP[_X]*_FAK1>=HH4*0.999)AND($P_EP[_X]*_FAK1<=HH4*1.001) GOTOF _MM7B
IF SQRT(POT(HH4*COS(INDA)-HH5)+POT(HH4*SIN(INDA)))<=SQRT(POT(HH5*COS(INDA)-HH5)+POT(HH5*SIN(INDA))) GOTOF _MM7B
HH3=HH5 HH7=-1
GOTOB _MM6
_MM7B:HH3=HH4 HH7=1
GOTOB _MM6
_MM8:
IF _SPIND==2
ST_CUST(_UMODE+1)
ENDIF
IF _MDG==1
MSG("")
ENDIF
SBLON
WRTPR("TMP_BLK_DEL()",1)
IF (_IS_CYCFR==1)
N300 $P_CYCFRAME=$P_CYCFRAME:CROT(_Z,-_RE_ROT)
N310 $P_CYCFRAME=$P_CYCFRAME:CTRANS(_X,-CPA*1/_FAK1,_Y,-CPO*1/_FAK1)
ENDIF
RET
_M_ST_POS:
$AC_MEAS_VALID=0
$AC_MEAS_TYPE=24
$AC_MEAS_P1_COORD=0
$AC_MEAS_P2_COORD=1
$AA_MEAS_POINT1[_X]=HH3
$AA_MEAS_POINT1[_Y]=0
$AA_MEAS_POINT1[_Z]=RFP+SDIS*HH2
_ERR=MEASURE()
_SC_POS[3]=SQRT(ABS(POT($AA_MEAS_POINT2[_X])+POT($AA_MEAS_POINT2[_Y])))
;;;$P_CYCFRAME=INVFRAME(_RE_CYCFR):$P_CYCFRAME:CTRANS(_X,HH3,_Z,RFP+SDIS*HH2)
$P_CYCFRAME=_RE_CYCFR:$P_CYCFRAME:CTRANS(_X,HH3,_Z,RFP+SDIS*HH2)
_SC_POS[0]=$P_CYCFRAME[_X,TR]
_SC_POS[1]=$P_CYCFRAME[_Y,TR]
_SC_POS[2]=$P_CYCFRAME[_Z,TR]
$P_CYCFRAME=_RE_CYCFR
RET
FEHL1:STOPRE
SETAL(61101)
RET
FEHL2:STOPRE
SETAL(61106)
RET
FEHL3:STOPRE
SETAL(61104)
RET
FEHL4:STOPRE
SETAL(61609)
RET
_FEHL5:STOPRE
SETAL(61002)
RET
FEHL6:STOPRE
SETAL(61000)
RET
_FEHL7:
SETAL(62106)
RET
_FEHL12:STOPRE
N711 SETAL(61002)
RET

%_N_MELDUNG_SPF
;$PATH=/_N_CST_DIR
PROC MELDUNG(INT _MT,INT _CSPEZ,INT _FNR)
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.01 Mar 25, 2002
;internes Unterprogramm: Meldungen Standardzyklen mit Textnummern
CASE _MT OF 1 GOTOF _M1 2 GOTOF _M2 5 GOTOF _M5 6 GOTOF _M6 7 GOTOF _M7 8 GOTOF _M8 9 GOTOF _M9 10 GOTOF _M10 11 GOTOF _M11 12 GOTOF _M12 DEFAULT GOTOF _MFIN
_M1:MSG("$80000")
_MFIN:RET
_M2:CASE _CSPEZ OF 1 GOTOF _M21 2 GOTOF _M22 3 GOTOF _M23 DEFAULT GOTOB _MFIN
_M21:MSG("$80006")
RET
_M22:MSG("$80007")
RET
_M23:MSG("$80008")
RET
_M5:MSG("$80001")
RET
_M6:MSG("$80002")
RET
_M7:MSG("$80003")
RET
_M8:MSG("$80004")
RET
_M9:CASE _CSPEZ OF 1 GOTOF _M91 0 GOTOF _M92 DEFAULT GOTOB _MFIN
_M91:MSG("$80010")
RET
_M92:MSG("$80011")
RET
_M10:MSG("$80012")
RET
_M11:MSG("$80013")
RET
_M12:MSG("$80014")
RET

%_N_STEIGUNG_SPF
;$PATH=/_N_CST_DIR
PROC STEIGUNG(VAR REAL PP,REAL MPIT)
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 05.03.03 Apr 11, 2000
;internes Unterprogramm: Steigung berechnen bei metrischen Gewinden
DEF INT JJ,II
DEF REAL HH,PT[27]=(0.6,0.75,0.5,0.7,0.8,1,1,1.25,1.5,1.75,2,2,2.5,2.5,2.5,3,3,3.5,3.5,4,4,4.5,4.5,5,5,5.5,5.5)
PP=PT[0]
IF MPIT==3.5 GOTOF _MX1
PP=PT[1]
IF MPIT==4.5 GOTOF _MX1
HH=TRUNC(MPIT) II=HH
IF (MPIT<>HH)OR(MPIT<3) GOTOF _FEHL1 IF MPIT<52 GOTOF _MA1
JJ=(II-52)DIV 4 PP=PT[24+JJ]
RET
_MA1:IF MPIT<27 GOTOF _MA2
JJ=(II-27)DIV 3 PP=PT[16+JJ]
RET
_MA2:IF MPIT<10 GOTOF _MA3
JJ=(II-10)DIV 2 PP=PT[8+JJ]
RET
_MA3:PP=PT[II-1]
_MX1:RET
_FEHL1:STOPRE
SETAL(61001)
RET

%_N_POCKET1_SPF
;$PATH=/_N_CST_DIR
PROC POCKET1 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL LENG,REAL WID,REAL CRAD,REAL CPA,REAL CPO,REAL STA1,REAL FFD,REAL FFP1,REAL MID,INT CDIR,REAL FAL,INT VARI,REAL MIDF,REAL FFP2,REAL SSF) SAVE DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.02.09 Jan 07, 2002
;Rechtecktaschen, nur Stirnfraeser
N10 DEF AXIS _X,_Y,_Z
N12 DEF REAL HH1,HH2,HH3,HH4,HH5,HH6,WZR,HHS,HHF,HHF1,HHL,HHW,HHZ,HHG,HR,HK,HHA,HHO,_SDZI
N14 DEF INT HZ1,HZ2,HZ4,HZE,HZE1
N24 DEF BOOL SOWZ
DEF INT _MIRR=0
N18 _X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 SDIS=ABS(SDIS) DPR=ABS(DPR) HHL=ABS(LENG) HHW=ABS(WID) HK=SQRT(1.8)
CRAD=ABS(CRAD) MID=ABS(MID) MIDF=ABS(MIDF) VARI=ABS(VARI) HH6=STA1
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF CDIR==2
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
IF(_ZSD[1]==0)
_SDZI=SDIS
ENDIF
IF ($P_TOOL==0) AND ($P_SIM==1)
SOWZ=TRUE
MELDUNG(11)
ELSE
SOWZ=FALSE
ENDIF
IF ($P_TOOL==0) AND ($P_SIM==0) GOTOF FEHL6
IF ($P_TOOLR==0) AND ($P_SIM==0) GOTOF FEHL6
IF VARI>2 GOTOF FEHL5 IF(CDIR==2)OR(CDIR==3) GOTOF _MM00
N20 MELDUNG(5)
CDIR=3
_MM00:IF FFP2 GOTOF _MM01
FFP2=FFP1
_MM01:IF SSF<0 GOTOF _M01
HHS=$P_S[0]
_M01:IF SSF>0 GOTOF _MM02
SSF=HHS
_MM02:IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1A
N30 MELDUNG(1)
_MM0:DP=HH2
GOTOF _MM1A
_MM1:DPR=ABS(RFP-DP)
_MM1A:HH2=RTP-RFP
IF RFP==DP GOTOF _MM8 IF HH2==0 GOTOF _MM2 IF HH2/ABS(HH2) <> (RFP-DP)/DPR GOTOF FEHL1
_MM2:HH2=(RFP-DP)/DPR HHF=$P_F
IF SOWZ==TRUE
WZR=0
T0
VARI=2
ELSE
WZR=$P_TOOLR
ENDIF
HZ1=$MN_SCALING_SYSTEM_IS_METRIC HZ2=$P_GG[13]
IF(HZ2>2) GOTOF _MM2B
IF ((HZ1) AND (HZ2==2)) OR ((HZ1==0) AND (HZ2 <> 2)) GOTOF _MM2B IF HZ1 GOTOF _MM2A
WZR=WZR*$MN_SCALING_VALUE_INCH
GOTOF _MM2B
_MM2A:WZR=WZR/$MN_SCALING_VALUE_INCH
_MM2B:WZR=WZR/$P_ACTFRAME[_X,SC]
IF MIDF GOTOF _MM2C
MIDF=_SDZI+DPR
N100 _MM2C:ATRANS AX[_X]=CPA AX[_Y]=CPO
IF HHL>=HHW GOTOF _MM3
HHL=HHW HHW=ABS(LENG) HH6=HH6+90
_MM3:IF CRAD<=HHW/2 GOTOF _MM3B
CRAD=HHW/2
_MM3B:HH3=HHW/2-FAL
N110 AROT AX[_Z]=HH6
IF WZR>=HHW/2 GOTOF FEHL4 IF HH3>WZR GOTOF _MM3A
FAL=HHW/2-WZR-1/$MN_INT_INCR_PER_MM HH3=HHW/2-FAL
_MM3A:IF FAL<WZR*2 GOTOF _MMA
IF SOWZ==TRUE GOTOF _MMa
N115 MELDUNG(7)
_MMA:HHF1=FFP1 HH4=(HHL-HHW)/2
IF SOWZ==TRUE GOTOF VS2
HZE=(HH3-WZR*(1+0.5*HK))/WZR/HK+0.4999 HK=(HH3/WZR-1)/(0.5+HZE) HZE=HZE+1 HHZ=HK*WZR HHG=HHZ/2+WZR HZE1=HZE
VS2:
IF MID GOTOF _MM4
MID=_SDZI+DPR
_MM4:HZ1=(_SDZI+DPR)/MID+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1
N120 G0 G40 G64 G90 CDOF AX[_X]=0 AX[_Y]=0
IF (VARI==2)
N130 G60 AX[_X]=HH4+HHG-WZR AX[_Y]=0
ENDIF
N140 G64 AX[_Z]=RFP+SDIS*HH2
IF CDIR==2 GOTOF _MG0
N150 AMIRROR AX[_Y]=0
_MG0:IF VARI==2 GOTOF _MS1
N160 _MM5:G1 G90 G60 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
IF NOT( (VARI==2) )
N165 G60 F=FFP1 AX[_X]=HH4+HHG-WZR AX[_Y]=0
ENDIF
IF HZ4 GOTOF _MM3C
HH5=CRAD-FAL HR=HH5+HHG-HH3
_MM3C:
N200 G1 G42 NORM G64 AX[_X]=HH4+HHG AX[_Y]=0 F=HHF1
_MG1:IF HR>WZR GOTOF _MM3D
N202 G1 AX[_Y]=-HHG
N204 AX[_X]=-(HH4+HHG)
N206 AX[_Y]=HHG
GOTOF _MM3E
N208 _MM3D: G1 AX[_Y]=-HHG+HR
N210 G2 AX[_X]=HH4+HHG-HR AX[_Y]=-HHG CR=HR
N220 G1 AX[_X]=-(HH4+HHG-HR)
N230 G2 AX[_X]=-(HH4+HHG) AX[_Y]=HR-HHG CR=HR
N240 G1 AX[_Y]=HHG-HR
N250 G2 AX[_X]=-(HH4+HHG-HR) AX[_Y]=HHG CR=HR
_MM3E:IF HZ4 GOTOF _MG2
HZE1=HZE1-1 HR=HH5-HH3+HHZ+HHG HHG=HHG+HHZ
IF HZE1 GOTOF _MG1A
HHZ=0
_MG1A:IF HZE1>1 GOTOF _MG2
HHG=HH3 HR=CRAD-FAL
_MG2:IF HR>WZR GOTOF _MG2A
N260 G1 AX[_X]=HH4+HHG AX[_Y]=HHG-HHZ
GOTOF _MG2C
_MG2A:HHA=HR
IF HR<=HHG-HHZ GOTOF _MG2B
HR=HHG-HHZ
N262 _MG2B:G1 AX[_X]=HH4+HHG-HR AX[_Y]=HHG-HHZ
N270 G2 AX[_X]=HH4+HHG AX[_Y]=HHG-HHZ-HR CR=HR
HR=HHA
_MG2C:IF HZE1>1 GOTOB _MG1 IF HZE1==0 GOTOF _MG2D
HH5=HK*WZR HHZ=0
GOTOB _MG1
N280 _MG2D:G1 AX[_X]=HH4+HHG AX[_Y]=0
N290 G2 AX[_X]=HH4+HHG*COS(45) AX[_Y]=-HHG*SIN(45) IP[_X]=AC(HH4) IP[_Y]=AC(0)
IF (NOT(VARI==2))
N292 G40 G1 F=FFP1 AX[_X]=0 AX[_Y]=0
ELSE
N292 G40 G1 F=FFP1 AX[_X]=HH4+HK*WZR/2*COS(45) AX[_Y]=0
ENDIF
IF HZ4 GOTOF _MM7B
HZ2=HZ2+1 HHZ=HK*WZR HZE1=HZE HHG=HHZ/2+WZR
IF HZ2>HZ1 GOTOF _MS0
GOTOB _MM5
_MS0:IF HZ4 GOTOF _MM7B IF (VARI==1) OR (FAL==0) GOTOF _MM7C
_MS1:
HZ4=1 HZ1=(_SDZI+DPR)/MIDF+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1 HHF1=FFP2 HH3=HHW/2 HR=CRAD HHG=HH3 HHZ=0 HZE1=0
IF SSF<0 GOTOF _MS4
N294 S=SSF G60
_MS4:
IF SOWZ==TRUE
HZ2=HZ1
ENDIF
N300 G60 G90 G1 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
N305 G1 G64 G42 NORM AX[_X]=HH4+HHG*COS(45) AX[_Y]=HHG*SIN(45) F=HHF1
N310 G2 AX[_X]=HH4+HHG AX[_Y]=0 IP[_X]=AC(HH4) IP[_Y]=AC(0)
GOTOB _MG1
_MM7B:HZ2=HZ2+1 HHA=HH3-FAL
IF SOWZ==TRUE GOTOF VS1
IF HZ2<=HZ1 GOTOB _MS4
VS1:
N350 _MM7C:G0 G90 AX[_Z]=RTP
N360 AX[_X]=0 AX[_Y]=0
HZ2=1 HZ4=0
IF HHF GOTOF _MM7D
HHF=HHF1
_MM7D: F=HHF
IF SSF<0 GOTOF _MM8
S=HHS
N370 _MM8:MSG("")
ATRANS AX[_X]=-CPA AX[_Y]=-CPO
RET
N382 FEHL1:STOPRE
SETAL(61101)
RET
N384 FEHL4:STOPRE
SETAL(61105)
RET
N386 FEHL5:STOPRE
SETAL(61002)
RET
N388 FEHL6:STOPRE
SETAL(61000)
RET

%_N_POCKET2_SPF
;$PATH=/_N_CST_DIR
PROC POCKET2 (REAL RTP,REAL RFP,REAL SDIS,REAL DP,REAL DPR,REAL PRAD,REAL CPA,REAL CPO,REAL FFD,REAL FFP1,REAL MID,INT CDIR,REAL FAL,INT VARI,REAL MIDF,REAL FFP2,REAL SSF) SAVE DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.02.09 Jan 07, 2002
;Kreistasche, mit Stirnfraeser
DEF AXIS _X,_Y,_Z
DEF REAL HH1,HH2,HH3,WZR,HHS,HHF,HHF1,HHZ,HHG,HR,HK,_SDZI
DEF INT HZ1,HZ2,HZ4,HZE,HZE1
DEF BOOL SOWZ
DEF INT _MIRR=0
_X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 SDIS=ABS(SDIS) DPR=ABS(DPR) HK=SQRT(1.8)
PRAD=ABS(PRAD) MID=ABS(MID) MIDF=ABS(MIDF) VARI=ABS(VARI)
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF CDIR==2
CDIR=CDIR+1
ELSE
CDIR=CDIR-1
ENDIF
ENDIF
;
IF(_ZSD[1]==0)
_SDZI=SDIS
ENDIF
IF ($P_TOOL==0) AND ($P_SIM==1)
SOWZ=TRUE
MELDUNG(11)
ELSE
SOWZ=FALSE
ENDIF
IF ($P_TOOL==0)AND ($P_SIM==0) GOTOF FEHL6 IF VARI>2 GOTOF FEHL5
IF(CDIR==2)OR(CDIR==3) GOTOF _MM00
MELDUNG(5)
CDIR=3
_MM00:IF FFP2 GOTOF _MM01
FFP2=FFP1
_MM01:IF SSF<0 GOTOF _M01
HHS=$P_S[0]
_M01:IF SSF>0 GOTOF _MM02
SSF=HHS
_MM02:IF DPR==0 GOTOF _MM1 IF RTP==RFP GOTOF FEHL1 IF VARI > 2 GOTOF FEHL5
HH2=RFP-((RTP-RFP)/ABS(RTP-RFP)*DPR)
IF DP==0 GOTOF _MM0 IF DP==HH2 GOTOF _MM1A
N10 MELDUNG(1)
_MM0: DP=HH2
GOTOF _MM1A
_MM1:DPR=ABS(RFP-DP)
_MM1A:HH2=RTP-RFP
IF RFP==DP GOTOF _MM8
IF HH2==0 GOTOF _MM2 IF HH2/ABS(HH2) <> (RFP-DP)/DPR GOTOF FEHL1
_MM2:HH2=(RFP-DP)/DPR
IF SOWZ==TRUE
WZR=0
;T0
VARI=2
ELSE
WZR=$P_TOOLR
ENDIF
HHF=$P_F
HZ1=$MN_SCALING_SYSTEM_IS_METRIC HZ2=$P_GG[13]
IF(HZ2>2) GOTOF _MM2B
IF ((HZ1) AND (HZ2==2)) OR ((HZ1==0) AND (HZ2 <> 2)) GOTOF _MM2B
IF HZ1 GOTOF _MM2A
WZR=WZR*$MN_SCALING_VALUE_INCH
GOTOF _MM2B
_MM2A:WZR=WZR/$MN_SCALING_VALUE_INCH
_MM2B:WZR=WZR/$P_ACTFRAME[_X,SC]
IF (WZR==0) AND ($P_SIM==0) GOTOF FEHL6 IF MIDF GOTOF _MM2C
MIDF=_SDZI+DPR
_MM2C:ATRANS AX[_X]=CPA AX[_Y]=CPO
HH3=PRAD-FAL
IF WZR >PRAD GOTOF FEHL4 IF HH3>WZR GOTOF _MM3
FAL=PRAD-WZR HH3=WZR HHZ=0
GOTOF _MM3A
_MM3:
IF SOWZ==TRUE GOTOF _MM3A
HHF1=FFP1 HZE=(HH3-WZR)/WZR/HK+0.4999 HHZ=(HH3-WZR)/HZE HZE1=HZE HHG=HHZ
_MM3A:IF FAL<WZR*2 GOTOF _MMA
IF SOWZ==TRUE GOTOF _MMA
MELDUNG(7)
_MMA:IF MID GOTOF _MM4
MID=_SDZI+DPR
_MM4:HZ1=(_SDZI+DPR)/MID+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1
N10 G0 G40 G60 G90 AX[_X]=0 AX[_Y]=0
G64 AX[_Z]=RFP+SDIS*HH2
IF CDIR==2 GOTOF _MG0
AMIRROR AX[_Y]=0
_MG0:IF VARI==2 GOTOF _MS1
_MM7:
IF SOWZ==TRUE
HZ2=HZ1
ENDIF
N20G1 G60 F=FFD AX[_Z]=DP+(HZ1-HZ2)*HH1*HH2
IF HZ4 GOTOF _MG02 IF HHZ==0 GOTOF _MM7A
N200 G2 G64 AX[_X]=HHZ AX[_Y]=0 F=HHF1 IP[_X]=AC(HHZ/2) IP[_Y]=AC(0)
N210 _MG01: AX[_X]=-HHG AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
HZE1=HZE1-1
IF HZE1==0 GOTOF _MG03
N216 AX[_X]=HHG+HHZ AX[_Y]=0 IP[_X]=AC(HHZ/2) IP[_Y]=AC(0)
HHG=HHG+HHZ
IF HZE1 > 1 GOTOB _MG01
N225 AX[_X]=-HHG AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N226 _MG03: AX[_X]=HHG AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N230 AX[_X]=0 AX[_Y]=0 IP[_X]=AC(HHG/2) IP[_Y]=AC(0)
_MM7A: HZ2=HZ2+1 HHG=HHZ HZE1=HZE
IF HZ2<=HZ1 GOTOB _MM7
_MS0:IF (VARI==1) OR (FAL==0) GOTOF _MM7C
_MS1:
HZ4=1 HZ1=(_SDZI+DPR)/MIDF+0.4999
IF HZ1==0
HZ1=1
ENDIF
HH1=(_SDZI+DPR)/HZ1 HZ2=1 HHF1=FFP2 HR=HH3-WZR HHG=(PRAD-WZR)/2
_MS3:IF SSF<0 GOTOB _MM7
S=SSF G60
GOTOB _MM7
_MG02:
N310 G2 G64 AX[_X]=PRAD-WZR AX[_Y]=0 IP[_X]=AC(HHG) IP[_Y]=AC(0) F=HHF1
N320 AX[_X]=WZR-PRAD AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N321 AX[_X]=PRAD-WZR AX[_Y]=0 IP[_X]=AC(0) IP[_Y]=AC(0)
N330 AX[_X]=0 AX[_Y]=0 IP[_X]=AC(HHG) IP[_Y]=AC(0)
HZ2=HZ2+1
IF SOWZ==TRUE GOTOF VS1
IF HZ2<=HZ1 GOTOB _MM7
VS1:
_MM7C:G0 G90 AX[_Z]=RTP
AX[_X]=0 AX[_Y]=0
IF HHF GOTOF _MM7D
HHF=HHF1
_MM7D: F=HHF
IF SSF<0 GOTOF _MM8
S=HHS
_MM8:MSG("")
ATRANS AX[_X]=-CPA AX[_Y]=-CPO
RET
FEHL1:STOPRE
SETAL(61101)
RET
FEHL4:STOPRE
SETAL(61105)
RET
FEHL5:STOPRE
SETAL(61002)
RET
FEHL6:STOPRE
SETAL(61000)
RET

%_N_POCKET3_SPF
;$PATH=/_N_CST_DIR
PROC POCKET3(REAL _RTP,REAL _RFP,REAL _SDIS,REAL _DP,REAL _LENG,REAL _WID,REAL _CRAD,REAL _PA,REAL _PO,REAL _STA,REAL _MID,REAL _FAL,REAL _FALD,REAL _FFP1,REAL _FFD,INT _CDIR,INT _VARI,REAL _MIDA,REAL _AP1,REAL _AP2,REAL _AD,REAL _RAD1,REAL _DP1) SAVE SBLOF DISPLOF
;VERSION: 06.03.09 Jan 20, 2003
;CHANGE : 06.03.03 Sep 25, 2002
;Neue Rechtecktasche
N10 DEF AXIS _X,_Y,_Z
N13 DEF BOOL _ZB[12],_SOWZ
DEF INT _MIRR=0
N15 DEF REAL _BRIX,_BRIY,_MP[2],_WZR,_H1,_H2,_H3,_H4,_H5,_AT,_GT,_ZT,_LINT,_WINT,_DPINT,_PEA[3,2],_ERI,_BRI,_RURA,_WZMF=1,_EINRAD=2,_ADZI,_SDZI=1,_FALI,CPA,CPO,_LENG1,_LINT1,_I11,_H15,_ZTP
N18 DEF INT _I1,_I2,_I3,_I4,_I14,_AZ,_AZB,_RFT
N19 DEF REAL _ZTSDIS, _H6, _H7
N20 DEF REAL _EPS=0.001
IF ($P_SIM==1) AND ($P_TOOL==0)
_SOWZ=TRUE
MELDUNG(11)
T0
ELSE
_SOWZ=FALSE
ENDIF
N20 _X=$P_AXN1 _Y=$P_AXN2 _Z=$P_AXN3 _WZR=$P_TOOLR _H1=$MN_SCALING_SYSTEM_IS_METRIC _I1=$P_GG[13]
IF(_I1>2) GOTOF _MY5316
IF (_H1-_I1)==-1 GOTOF _MY5316
IF _H1<>1
_WZR=_WZR*$MN_SCALING_VALUE_INCH
ELSE
_WZR=_WZR/$MN_SCALING_VALUE_INCH
ENDIF
_MY5316: _I1=$P_TOOL _FAL=ABS(_FAL) _CRAD=ABS(_CRAD) _FALD=ABS(_FALD)
IF ((_I1==0)OR(_WZR==0)) AND ($P_SIM==0) GOTOF _FEHL1 IF _WZR<0 GOTOF _FEHL9 IF (_CRAD>ABS(_WID)/2) OR (_CRAD>ABS(_LENG)/2) GOTOF _FEHL10
_I2=ABS(_VARI) _I1=_I2 MOD 10 _I2=((_I2-_I1) DIV 10) MOD 10
_I11=_I1
IF (_I1<1)OR(_I1>2)OR(_I2<0)OR(_I2>3) GOTOF _FEHL2 IF (_CDIR<0)OR(_CDIR>3) GOTOF _FEHL6 IF _I2<1 GOTOF _MY1
_ZB[0]=1
IF _I2==1 GOTOF _MY1
_ZB[1]=1
IF _I2==2 GOTOF _MY1
_ZB[7]=1
_MY1:_I1=_I1-1
IF _SOWZ==TRUE
_ZB[2]=1
ELSE
_ZB[2]=_I1
ENDIF
IF _FAL<>0
_ZB[10]=1
ENDIF
IF _FALD<>0
_ZB[9]=1
ENDIF
IF ABS(_WID-_CRAD*2)<_EPS
_ZB[11]=1
ENDIF
IF (_RTP==_RFP)AND(_DP==_RFP) GOTOF _FEHL11 IF _RTP==_RFP GOTOF _MY52 IF (_RFP==_DP) GOTOF _MY52 IF ((_RFP-_DP)/ABS(_RFP-_DP))<>((_RTP-_RFP)/ABS(_RTP-_RFP)) GOTOF _FEHL11
_MY52:
IF _RFP-_DP<>0
_H1=_RFP-_DP
ELSE
_H1=_RTP-_DP
ENDIF
_RFT=ABS(_H1)/_H1 _DPINT=_DP
_MIRR=$P_ACTFRAME[_X,MI]+$P_ACTFRAME[_Y,MI]
IF _MIRR==1
IF (_CDIR==0) OR (_CDIR==2) GOTOF _SPG1
_CDIR=_CDIR-1
GOTOF _SPG2
_SPG1: _CDIR=_CDIR+1
_SPG2:
ENDIF
IF(_RFT==-1)
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF($P_ACTFRAME[_Z,MI])
IF(_CDIR==0)OR(_CDIR==2)
_CDIR=_CDIR+1
ELSE
_CDIR=_CDIR-1
ENDIF
ENDIF
IF _CDIR==2 GOTOF _MY3 IF _CDIR<>3 GOTOF _MY2
_ZB[3]=1
GOTOF _MY3
_MY2:
IF $P_SMODE[0]<>0
_H1=$P_SDIR[$P_MSNUM]
ELSE
_ZB[3]=1
SETAL(62101)
GOTOF _MY3
ENDIF
IF (_H1<3) OR (_H1>4) GOTOF _FEHL3
IF (_CDIR==0)AND(_H1==4) GOTOF _MY3 IF (_CDIR==1)AND(_H1==3) GOTOF _MY3
_ZB[3]=1
_MY3:
IF _SDIS<>0
_SDZI=_SDIS
ENDIF
_MP[0]=_PA _MP[1]=_PO
IF _ZSD[2]
_MP[0]=_MP[0]+_LENG/2 _MP[1]=_MP[1]+_WID/2
ENDIF
IF (_ZSD[3]) AND ($P_GG[15]==3)
_ZB[8]=1
ENDIF
IF _CRAD==0
_CRAD=0.001/_WZMF
ENDIF
_LINT=ABS(_LENG)/2 _WINT=ABS(_WID)/2 _ERI=_CRAD
_MY5:_I1=$P_GG[13]
IF(_I1==2)OR(_I1==4) GOTOF _MY51
_WZMF=$MN_SCALING_VALUE_INCH _EINRAD=_EINRAD/_WZMF
IF _SDIS<>0 GOTOF _MY51
_SDZI=_SDZI/_WZMF
_MY51:
IF _FALD>ABS(_RFP-_DP)
IF _ZSD[1]==1
_FALD=ABS(_RFP-_DP)
ELSE
_FALD=ABS(_RFP-_DP)+ABS(_SDIS)
ENDIF
ENDIF
IF _MID>ABS(_RFP-_DP)
IF _ZSD[1]==1
_MID=ABS(_RFP-_DP)
ELSE
_MID=ABS(_RFP-_DP)+ABS(_SDIS)
ENDIF
ENDIF
IF NOT (_ZB[2])
_LINT=_LINT-_FAL _WINT=_WINT-_FAL _ERI=_CRAD-_FAL _DPINT=_DP+_RFT*_FALD _ADZI=ABS(_RFP-_DPINT)-ABS(_AD)
IF _ADZI<0
_ADZI=0
ENDIF
ELSE
IF NOT _FAL
IF _MIDA
_FAL=_MIDA
ELSE
_FAL=1.6*_WZR
ENDIF
ENDIF
IF NOT _FALD
IF _MID
_FALD=_MID
ELSE
IF ABS(_RFP-_DP)>2/_WZMF
_FALD=2/_WZMF
ELSE
_FALD=ABS(_RFP-_DP)
ENDIF
ENDIF
ENDIF
ENDIF
IF (_WZR>_LINT) OR(_WZR>_WINT) GOTOF _FEHL4 IF _ERI>=_WZR GOTOF _MY55
_ERI=_WZR
_MY55:
IF (_AP1<=0)OR(_AP1/2<_WZR)OR(_AP2/2<_WZR)OR(_AP2<=0)OR(_AD<=0)
_ZB[6]=1
ENDIF
IF ((((_WINT<=2*_WZR) AND (ABS(_CRAD-_WINT)<_EPS)) OR ((_LINT<=2*_WZR) AND (ABS(_CRAD-_LINT)<_EPS))) AND ((_MIDA>=_CRAD) OR ((_VARI MOD 10)==2))) OR (ABS(_WINT-_WZR)<_EPS) OR (ABS(_LINT-_WZR)<_EPS)
ATRANS AX[_X]=_MP[0] AX[_Y]=_MP[1]
IF(ABS(_LINT-_WZR)<_EPS) OR (ABS(_WINT-_WZR)<_EPS)
IF(ABS(_LINT-_WZR)<_EPS)
_LENG=_WID CPO=0 CPA=-_WINT
AROT RPL=_STA+90
ELSE
CPA=-_LINT CPO=0
AROT RPL=_STA
ENDIF
IF(_I11==1) AND (_ZB[9]==1)
_DP=_DP+_FALD
ENDIF
LONGHOLE(_RTP,_RFP,_SDIS,_DP,,1,_LENG,CPA,CPO,0,0,0,_FFD,_FFP1,_MID,_I2)
ELSE
IF(_WID>_LENG)
_LENG1=_LENG _LINT1=_LINT _LENG=_WID _WID=_LENG1 _LINT=_WINT _WINT=_LINT1
AROT RPL=_STA+90
ELSE
AROT RPL=_STA
ENDIF
CPA=-_LINT CPO=0
SLOT1(_RTP,_RFP,_SDIS,_DP,0,1,_LENG,_WID,CPA,CPO,0,0,0,_FFD,_FFP1,_MID,_CDIR,_FAL,_VARI,0,0,0,_FALD,_RAD1,_DP1)
ENDIF
ATRANS AX[_X]=-_MP[0] AX[_Y]=-_MP[1]
GOTOF _RET
ENDIF
IF (_MIDA>2*_WZR) AND ($P_SIM==0)
IF NOT( (_ZB[2]==1) AND (_ZB[9]==0) AND (_ZB[10]==1) )
GOTOF _FEHL8
ENDIF
ENDIF
_MY61:_GT=ABS(_RFP-_DPINT) _AZ=1
IF _ZSD[1] GOTOF _MQ1
_GT=_GT+ABS(_SDIS)
_MQ1:IF (_MID==0)OR(_GT==0) GOTOF _MQ2
_AZ=TRUNC(_GT/_MID)
IF _MID*_AZ==_GT GOTOF _MQ2
_AZ=_AZ+1
_MQ2:_ZT=_GT/_AZ _ZT=_ZT*_RFT
N100 _WKSNEU:ATRANS AX[_X]=_MP[0] AX[_Y]=_MP[1]
IF _WINT<=_LINT
N105 AROT RPL=_STA
ELSE
N105 AROT RPL=_STA+90
_H1=_AP1 _AP1=_AP2 _AP2=_H1 _H1=_WINT _WINT=_LINT _LINT=_H1
ENDIF
_I1=1
SBLON
N110 G0 G90 AX[_Z]=_RTP
N120 NORM DIAMOF CFTCP AX[_X]=0 AX[_Y]=0
N130 AX[_Z]=_RFP+_RFT*_SDIS
SBLOF
IF (_ERI-_WZR)<_EINRAD
_EINRAD=(_ERI-_WZR)
ENDIF
IF (_ZB[2]) AND (_SOWZ==TRUE) GOTOF _MSL1
IF (_ZB[2]) AND (_AZ<>1) GOTOF _MSL1
IF (_ZB[2]) AND (_ZB[9]==0) GOTOF _MSL1
IF _ZB[2] GOTOF _SCHLICHTEND
_BRI=_MIDA _H2=_WZR+_EINRAD _PEA[2,0]=_LINT-_H2 _PEA[2,1]=-_I3*_H2
IF _MIDA==0
_BRI=_WZR*1.6
ENDIF
_NXTIEF:_AT=_DPINT+((_AZ-_I1)*_ZT)
IF _ZB[6] GOTOF _SRV IF ABS(_AT-_DPINT)>_ADZI GOTOF _SRROH
_ZB[6]=1
N700 G0 G90 AX[_X]=0 AX[_Y]=0
GOTOF _SRV
_SRROH:_H1=_LINT-_AP1/2
IF _H1<0
_H1=0 _AP1=_LINT*2
ENDIF
IF _H1<_WINT-_AP2/2
_H1=_WINT-_AP2/2
ELSE
IF _WINT-_AP2/2<0
_AP2=_WINT*2
ENDIF
ENDIF
_SRR1:IF NOT _H1 GOTOF _END1
_AZB=TRUNC(_H1/_BRI) _I3=1
IF _BRI*_AZB==_H1 GOTOF _MY90
_AZB=_AZB+1
_MY90:_I2=1 _BRIX=(_LINT-_AP1/2)/_AZB _BRIY=(_WINT-_AP2/2)/_AZB _BRI=_H1/_AZB _H2=_WZR+_EINRAD
