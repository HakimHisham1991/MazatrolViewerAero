%_CALCDAT_SPF
PROC CALCDAT(VAR REAL _F_E3[],REAL PT,VAR REAL _F_A[])
TRANS
DEF REAL _XC, _YC, _DIA, _TEMP1, _TEMP2, _TEMP3, _TEMP4
_TEMP1 = (_F_E3[2,0]^2 - _F_E3[1,0]^2 + _F_E3[2,1]^2 - _F_E3[1,1]^2)/(2*(_F_E3[2,1]-_F_E3[1,1]))
_TEMP2 = (_F_E3[1,0]^2 - _F_E3[0,0]^2 + _F_E3[1,1]^2 - _F_E3[0,1]^2)/(2*(_F_E3[1,1]-_F_E3[0,1]))
_TEMP3 = (_F_E3[1,0] - _F_E3[0,0])/(_F_E3[1,1] - _F_E3[0,1])
_TEMP4 = (_F_E3[2,0] - _F_E3[1,0])/(_F_E3[2,1] - _F_E3[1,1])
_XC = -(_TEMP1 - _TEMP2)/(_TEMP3 - _TEMP4)
_YC = -_TEMP3 * _XC + _TEMP2
_F_A[2] = _OVR[0] /2
_F_A[0] = _XC
_F_A[1] = _YC
M17

%_N_CYCLE102_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE102(INT _SPEZ)
;V06.02.17 May 28, 2003
;C06.02.09 May 29, 2002
;Messergebnisbildanzeige
DEF INT _II
DEF STRING[100] _MMCK="CYCLES,LM,"
DEF STRING[50] _HELP1="WSMES"
IF $P_SEARCH OR $P_SIM OR $P_DRYRUN
RET
ENDIF
IF _SPEZ==1 GOTOF _MEBA
N470 ;;;MMC("CYCLES,PICTURE_OFF","A")
N471 STOPRE
N472 MSG(" ")
RET
_MEBA:IF _MVAR DIV 100 MOD 10==0 GOTOF _MEBA1
_HELP1=_HELP1<<"NV"
_MEBA1:IF (_OVI[2]<>976)AND(_OVI[2]<>978) GOTOF _MEBA2 IF _MA<>3 GOTOF _MEBA2
_HELP1=_HELP1<<"A"
_MEBA2:IF NOT((_OVI[2]==977)AND(_MVAR MOD 10 >4)) GOTOF _MY1
_HELP1=_HELP1<<"_R"
_MY1:
CASE _OVI[2] OF 976 GOTOF _MZ976 977 GOTOF _MZ977 978 GOTOF _MZ978 979 GOTOF _MZ979 998 GOTOF _MZ998 971 GOTOF _MZ971 972 GOTOF _MZ972 973 GOTOF _MZ973 974 GOTOF _MZ974 994 GOTOF _MZ994 961 GOTOF _MZ961 982 GOTOF _MZ982
_MZ976:IF (_MVAR<>0) AND (_MVAR<>10000) GOTOF _C976E IF _MA<>3 GOTOF _C976E
_MMCK=_MMCK<<"MZBILD03.com,KALIBWSA"
GOTOF _PON
_C976E:IF _MVAR MOD 10 ==8 GOTOF _C976E_MP
_MMCK=_MMCK<<"MZBILD03.com,KALIBWSE"
GOTOF _PON
_C976E_MP:_MMCK=_MMCK<<"MZBILD03.com,KALIBWSE_MP"
GOTOF _PON
_MZ977:_MMCK=_MMCK<<"MZBILD04.com,"<<_HELP1
GOTOF _PON
_MZ978:_MMCK=_MMCK<<"MZBILD04.com,"<<_HELP1
IF _MA<>3
_MMCK=_MMCK<<"A"
ENDIF
GOTOF _PON
_MZ979:_MMCK=_MMCK<<"MZBILD04.com,"<<_HELP1
GOTOF _PON
_MZ998:_MMCK=_MMCK<<"MZBILD01.com,WINKEL"
IF _MVAR MOD 10 == 6
_MMCK=_MMCK<<"_2"
ENDIF
GOTOF _PON
_MZ972:IF _MVAR==1 GOTOF _MZ9721
_MMCK=_MMCK<<"MZBILD02.com,KALIB_WZ"
GOTOF _PON
_MZ9721:_MMCK=_MMCK<<"MZBILD02.com,WZMESSEN"
GOTOF _PON
_MZ982:IF (_MVAR<>0) AND (_MVAR<>10) AND (_MVAR<>100010) AND (_MVAR<>100000) GOTOF _MZ9821
_MMCK=_MMCK<<"MZBILD02.com,KALIB_WZ"
GOTOF _PON
_MZ9821:_MMCK=_MMCK<<"MZBILD02.com,WZMESSEN_DF"
GOTOF _PON
_MZ971:IF (_MVAR<>0) AND (_MVAR<>10000) AND (_MVAR<>10) AND (_MVAR<>10010) GOTOF _MZ9711
_MMCK=_MMCK<<"MZBILD02.com,KALIB_FWZ"
GOTOF _PON
_MZ9711:_MMCK=_MMCK<<"MZBILD02.com,FWZMESSEN"
GOTOF _PON
_MZ973:_MMCK=_MMCK<<"MZBILD03.com,KALIBWSE"
GOTOF _PON
_MZ974:
_MMCK=_MMCK<<"MZBILD04.com,"<<_HELP1
_MMCK=_MMCK<<"A"
GOTOF _PON
_MZ994:_MMCK=_MMCK<<"MZBILD04.com,"<<_HELP1
_MMCK=_MMCK<<"A"
GOTOF _PON
_MZ961:
IF (_MVAR==107)OR(_MVAR>=108)
_MMCK=_MMCK<<"MZBILD01.com,ECKE_EIN1"
ELSE
_MMCK=_MMCK<<"MZBILD01.com,ECKE_EIN2"
ENDIF
GOTOF _PON
N180 _PON:STOPRE
;;;MMC(_MMCK,"A")
IF NOT _CHBIT[11] GOTOF _POF
