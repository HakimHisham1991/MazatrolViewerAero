%_N_CYCLE118_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE118(REAL _VALUE,INT _DIGITS,VAR STRING[12] _TEXT,INT _NUMVAL,INT _FIRSTR) SAVE DISPLOF
;V06.02.17 May 28, 2003
;C06.02.03 Nov 07, 2001
;Formatieren_von_Real_Werten
N10 DEF REAL _TMP_REAL, _TMP_REAL2
N15 DEF INT _COUNT, _TMP_INT, _STRINGLEN, _II, _JJ=0
N20 DEF STRING[12] _TMP_STRINGVAL
IF _NUMVAL > 10 GOTOF _FEHLER
_TMP_INT = 1
FOR _COUNT = 0 TO _DIGITS
_TMP_INT = _TMP_INT * 10
ENDFOR
IF _NUMVAL < 2 GOTOF _MINVAL
_NEXVAL:
_VALUE = R[_FIRSTR + _JJ]
_MINVAL:
IF ABS(_VALUE) < 5/_TMP_INT
_VALUE = 0
ENDIF
_TMP_REAL = (ROUND(_VALUE*_TMP_INT/10))/(_TMP_INT/10) _TMP_STRINGVAL = << _TMP_REAL _COUNT = 0;;;INDEX(_TMP_STRINGVAL,".")
IF _COUNT == -1 GOTOF _GANZ
_STRINGLEN = STRLEN(_TMP_STRINGVAL) _TEXT = _TMP_STRINGVAL
IF _STRINGLEN - _COUNT > _DIGITS GOTOF _ENDE
FOR _II = (_STRINGLEN - _COUNT) TO _DIGITS
_TEXT = _TEXT << "0"
ENDFOR
GOTOF _ENDE
RET
_GANZ:
_TEXT = _TMP_STRINGVAL<< "."
FOR _II = 1 TO _DIGITS
_TEXT = _TEXT << "0"
ENDFOR
_ENDE: IF _NUMVAL < 2 GOTOF _ENDPROG
_TXT[_JJ] = _TEXT _JJ = _JJ + 1
IF _JJ < _NUMVAL GOTOB _NEXVAL
_ENDPROG:RET
_FEHLER: setal(61362)
M0
RET


%_N_CYCLE_961_SPF
;$PATH=/_N_CST_DIR
PROC CYCLE_961 SAVE DISPLOF
;V06.02.08  Mar 21, 2002
;C06.02.07 Feb 14, 2002
;Automatisches Einrichten Ecke
N110 DEF BOOL _INTERN[60],_M_ZUST[16],_VB[56]
N120 DEF REAL _M_SPE[52],_M_ME[11]
N130 DEF INT _M_N[30],_ALARM
N140 DEF AXIS _MAV,_VAV,_VAV1
N150 DEF REAL _TRIGG,_WIH,_KA1,_KA2,_FA1,_FA2,_P_ABS,_P_ORD,_P_APP,_WI11,_WI22,_WI1,_WI2,_MP_A[5],_MP_O[5],_HKA,_HRP,_HF,_COS_2,_SIN_2,_INCR=1
N160 DEF INT _SIC1,_SIC2,_MAKA1,_MAKA2,_ANZ,_MP
N170 DEF AXIS _RAX,_XX,_YY,_ZZ
N175 DEF REAL _A1,_A2,_B1,_B2,_C1,_C2,_S_A,_S_O,_D,_HD,_HDO,_DAT[3,6],_KF[3,3],_H_I[3]
N176 DEF INT _AXIND,_H1,_HM=1,_H_XX=1,_H_YY=1,_H_ZZ=1,_F_XX=1,_F_YY=1,_F_ZZ=1
N177 DEF INT _PNUM,_AX_P1_2,_DIR1_2,_AX_P3_4,_DIR3_4,_E_B,_PT1_2,_PT3_4
N178 DEF REAL _SWA,_SWO,_PU1A,_PU1O,_PU2A,_PU2O,_PU3A,_PU3O,_PU4A,_PU4O,_HR
N179 DEF INT _A_NPV,_K_NPV,_M_BFNR,_FRSEL,_Z2,_Z3,_Z4
N180 DEF REAL _POS_A[3],_POS_K[3],_UF[3]
_ALARM=61342
IF (NUMBER(_SI[1])<6) GOTOF _ERR5
IF ($AN_NCK_VERSION<480000) GOTOF _ERR5
_ALARM=0
MSG("")
IF $P_SEARCHL OR $P_DRYRUN OR $P_SIM GOTOF _MS1
IF $P_F==93101.901
_E_B=1 _KNUM=_OVR[0] _SWA=_OVR[1] _SWO=_OVR[2] _PNUM=_OVR[3] _AX_P1_2=_OVR[4] _DIR1_2=_OVR[5] _AX_P3_4=_OVR[6] _DIR3_4=_OVR[7] _PU1A=_OVR[8] _PU1O=_OVR[9] _PU2A=_OVR[10] _PU2O=_OVR[11] _PU3A=_OVR[12] _PU3O=_OVR[13] _PU4A=_OVR[14] _PU4O=_OVR[15]
ENDIF
_OVI[2]=961 _VB[0]=1
N190 CYCLE109(_INTERN,_M_SPE,_M_N)
IF _E_B GOTOF _MCYC110
IF _INTERN[40+10] AND NOT _INTERN[40+11] AND _INTERN[40+18]
CYCLE102(0)
ENDIF
IF ((_MVAR<105)AND(_MVAR>108)) AND ((_MVAR<117)AND(_MVAR>118))GOTOF _ERR6 IF _MVAR>108 GOTOF _MA1 IF (_SETV[0]<=0)OR(_SETV[1]<=0) GOTOF _ERR2 IF _INCA==0 GOTOF _ERR3
N250 _MA1:G0 G90 G94 DIAMOF
N260 _MCYC110:CYCLE110(_VB,_M_SPE,_M_N,_XX,_YY,_ZZ,_ALARM,_INTERN,_DAT,_KF)
IF _ALARM GOTOF _ERR5 IF (_INTERN[2]==0) OR (_INTERN[10]==0) OR (_INTERN[18]==0) GOTOF _ERR7
IF ((_INTERN[0])OR(_INTERN[8])OR(_INTERN[16]))
IF ($P_GG[29]==1)AND($MC_TOOL_PARAMETER_DEF_MASK B_AND 'B1000000')
IF _INTERN[0]
_H_XX=2
ELSE
IF _INTERN[8]
_H1=1 _H_YY=2
ELSE
IF _INTERN[16]
_H1=2 _H_ZZ=2
ENDIF
ENDIF
ENDIF
ENDIF
IF $MC_TOOL_PARAMETER_DEF_MASK B_AND 'B1000'
_F_XX=1+_INTERN[0] _F_YY=1+_INTERN[8] _F_ZZ=1+_INTERN[16]
ENDIF
ENDIF
IF _E_B GOTOF _MMEBER0 IF _VB[1] GOTOF _MM3
N300 G1 F=_M_SPE[1]
_MM3:
IF _MVAR>108
_A1=-(_SETV[3]-_SETV[1]) _B1=_SETV[2]-_SETV[0] _C1=_SETV[1]*_B1 + _SETV[0]*_A1 _A2=-(_SETV[7]-_SETV[5]) _B2=_SETV[6]-_SETV[4] _C2=_SETV[5]*_B2 + _SETV[4]*_A2 _D=_A1*_B2-_A2*_B1
IF ((_B1==0)AND(_A1==0))OR((_B2==0)AND(_A2==0))
_ALARM=61367
ELSE
IF _D==0
_ALARM=61368
ELSE
_S_A=(_C1*_B2-_C2*_B1)/_D _S_O=(_A1*_C2-_A2*_C1)/_D
IF (_SETV[1]-_S_O==0)AND(_SETV[0]-_S_A==0)OR(_SETV[5]-_S_O==0)AND(_SETV[4]-_S_A==0)OR(_SETV[3]-_S_O==0)AND(_SETV[2]-_S_A==0)OR(_SETV[7]-_S_O==0)AND(_SETV[6]-_S_A==0)
_ALARM=61369
ELSE
_KA1=ATAN2(_SETV[1]-_S_O,_SETV[0]-_S_A) _KA2=ATAN2(_SETV[5]-_S_O,_SETV[4]-_S_A) _A1=ATAN2(_SETV[3]-_S_O,_SETV[2]-_S_A) _A2=ATAN2(_SETV[7]-_S_O,_SETV[6]-_S_A)
IF (ABS(_KA1-_A1)>1)OR(ABS(_KA2-_A2)>1)
_ALARM=61369
ENDIF
ENDIF
ENDIF
IF _KA1<0
_KA1=360+_KA1
ENDIF
IF _KA2<0
_KA2=360+_KA2
ENDIF
_D=_KA2-_KA1
IF (_D<0)AND(_D<-180)
_D=_D+360
ENDIF
IF (_D>0)AND(_D>180)
_D=_D-360
ENDIF
ENDIF
ELSE
_KA1=-$P_ACTFRAME[_ZZ,RT] +_STA1
IF _KA1<0
_KA1=360+_KA1
ENDIF
_KA2=_KA1+_INCA
IF _KA2>360
_KA2=_KA2-360
ENDIF
IF _KA2<0
_KA2=360+_KA2
ENDIF
ENDIF
IF _ALARM GOTOF _ERR5
_ALARM=0
IF ($MN_SCALING_SYSTEM_IS_METRIC==0)
_INCR = 1/$MN_SCALING_VALUE_INCH
ENDIF
IF (((_KA1>=0)AND(_KA1<=45))OR((_KA1>305)AND(_KA1<=360)))
_MAKA1=2 _FA1=20
ENDIF
IF ((_KA1>45)AND(_KA1<=135))
_MAKA1=1 _FA1=-20
ENDIF
IF (_KA1>135)AND(_KA1<=215)
_MAKA1=2 _FA1=-20
ENDIF
IF (_KA1>215)AND(_KA1<=305)
_MAKA1=1 _FA1=20
ENDIF
IF ((_KA2>=0)AND(_KA2<=45))OR((_KA2>305)AND(_KA2<=360))
_MAKA2=2 _FA2=-20
ENDIF
IF ((_KA2>45)AND(_KA2<=135))
_MAKA2=1 _FA2=20
ENDIF
IF (_KA2>135)AND(_KA2<=215)
_MAKA2=2 _FA2=20
ENDIF
IF (_KA2>215)AND(_KA2<=305)
_MAKA2=1 _FA2=-20
ENDIF
IF (_MVAR==105)OR(_MVAR==107)OR(_MVAR==117)
_SIC1=10 _SIC2=-10 _FA1=_FA1*(-1) _FA2=_FA2*(-1)
ELSE
_SIC1=-10 _SIC2=10
ENDIF
IF ((_MVAR<=108)AND(_INCA<0))OR((_MVAR>108)AND(_D<0))
_FA1=_FA1*(-1) _FA2=_FA2*(-1) _SIC1=_SIC1*(-1) _SIC2=_SIC2*(-1)
ENDIF
IF _MVAR>108 GOTOF _MA11
_WIH=_KA1+_INCA/2
IF (_MVAR==106)OR(_MVAR==108)
IF _WIH>180
_WIH=_WIH-180
ELSE
_WIH=_WIH+180
ENDIF
ENDIF
_KA1=_KA1+_SIC1 _KA2=_KA2+_SIC2
IF _KA1>360
_KA1=_KA1-360
ENDIF
IF _KA2>360
_KA2=_KA2-360
ENDIF
IF _WIH>360
