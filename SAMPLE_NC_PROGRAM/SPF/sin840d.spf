N80 IF _EC<>0 GOTOF _ER
N81 WRITE(_EC,_PROTNAME[1]," ")
N82 IF _EC<>0 GOTOF _ER
N83 _PMI[0]=_PMI[0]+1
N85 _PMI[0]=_PMI[0]+1 _TX[1]="Program:       "<<_PROTNAME[0]
N90 WRITE(_EC,_PROTNAME[1],_TX[1])
N95 IF _EC<>0 GOTOF _ER
N100 _PMI[0]=_PMI[0]+1
N105 WRITE(_EC,_PROTNAME[1]," ")
N110 IF _EC<>0 GOTOF _ER
N115 _PMI[0]=_PMI[0]+1 _II=0
N120 _MY2:IF _HEADLINE[_II]==" " GOTOF _FINPH
N125 WRITE(_EC,_PROTNAME[1],_HEADLINE[_II])
N130 IF _EC<>0 GOTOF _ER
N135 _II=_II+1 _PMI[0]=_PMI[0]+1
N140 IF _II<_PROTFORM[3] GOTOB _MY2
N145 GOTOF _MY3
N155 _AWH:IF (_HEADLINE[_II]==" ")OR(_II>=_PROTFORM[3]) GOTOF _FINPH
N160 WRITE(_EC,_PROTNAME[1],_HEADLINE[_II])
N165 IF _EC<>0 GOTOF _ER
N170 _II=_II+1 _PMI[0]=_PMI[0]+1
N175 IF _II<_PROTFORM[3] GOTOB _AWH
N180 WRITE(_EC,_PROTNAME[1]," ")
N185 IF _EC<>0 GOTOF _ER
N190 _PMI[0]=_PMI[0]+1
N195 _MY3:WRITE(_EC,_PROTNAME[1],_TX[0])
N200 IF _EC<>0 GOTOF _ER
N205 _PMI[0]=_PMI[0]+1
N210 IF _PROTVAL[0]=="" GOTOF _MY77
N215 WRITE(_EC,_PROTNAME[1],_PROTVAL[6])
N220 IF _EC<>0 GOTOF _ER
N221 IF _PROTVAL[1]=="" GOTOF _MY78
N215 WRITE(_EC,_PROTNAME[1],_PROTVAL[7])
N220 IF _EC<>0 GOTOF _ER
N225 _MY78:_PMI[0]=_PMI[0]+1
N230 WRITE(_EC,_PROTNAME[1],_TX[0])
N235 IF _EC<>0 GOTOF _ER
N240 _PMI[0]=_PMI[0]+1 _II=0
N241 MSG()
N242 IF _PK==1 GOTOF _MY100
N245 RET
N235 _MY77:IF _PMI[1]==0 GOTOF _FINPH
N240 _PMI[1]=0
N245 GOTOF _PUTV
N250 _FINPH: MSG()
N251 IF _PK==1 GOTOF _MY100
N252 RET
N253 _MY100: _PK=0
N250 _PUTD:IF _PROTFORM[0]==0 GOTOF _PUTV IF _PMI[0]+_PROTFORM[4]+2<=_PROTFORM[0] GOTOF _PUTV
N255 _II=_PROTFORM[0]-_PMI[0]
N260 _MY31:WRITE(_EC,_PROTNAME[1]," ")
N265 IF _EC<>0 GOTOF _ER
N270 _II=_II-1 _PMI[0]=_PMI[0]+1
N275 IF _II>0 GOTOB _MY31
N280 _PMI[0]=0 _PMI[1]=1 _PMI[2]=_PMI[2]+1 _PK=1
N285 GOTOB _WHEAD
N290 _PUTV:IF _PROTVAL[0]=="" GOTOF _MY32
N295 _TX[1]="CYCLE"<<_OVI[2] _TX[2]="_MVAR" _TX[3]=" "<<_MVAR
N300 _II=1
N305 _WR3:
N301 IF _PROTFORM[5]<>0
_SP_B[_II-1]=_PROTFORM[5]
N302 ENDIF
N312 IF STRLEN(_TX[_II])>_SP_B[_II-1] GOTOF _WR4
N310 _TX[_II]=" "<<_TX[_II]
N315 _WR1:IF (STRLEN(_TX[_II])+1)>_SP_B[_II-1] GOTOF _WR2
N320 _TX[_II]=_TX[_II]<<" "
N325 GOTOB _WR1
N330 _WR4:
N335 CYCLE107(12)
N340 _WR2:IF _II>2 GOTOF _WR6
N345 _TXX=_TXX<<_TX[_II]<<_PROTSYM[0]
N350 _II=_II+1
N355 IF _II<4 GOTOB _WR3
N38 GOTOF _WR5
N360 _WR6:_TXX=_TXX<<_TX[_II]
N365 _WR5:
IF _CBIT[6]==1 GOTOF _M5401
N366 WRITE(_EC,_PROTNAME[1],_TXX)
N12 IF _EC<>0 GOTOF _ER
N12 _PMI[0]=_PMI[0]+1
_M5401: _II=0
N370 _MY32:WRITE(_EC,_PROTNAME[1],_PROTVAL[8+_II])
